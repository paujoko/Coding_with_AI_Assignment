# Copy to .env (never commit .env) and export the variables before starting the backend.

# mock (default, no API calls) or openrouter
WINGS_LLM_PROVIDER=mock

# Replay script for the mock provider (default: backend/src/wings/adapters/mock_scripts/demo_todo.json)
# WINGS_MOCK_SCRIPT=

# Where project workspaces are stored (default: <repo>/workspaces)
# WINGS_WORKSPACE_DIR=

# OpenRouter: one key, models per tier. Check the IDs on https://openrouter.ai/models (free ones end in :free).
OPENROUTER_API_KEY=
# WINGS_MODEL_SMALL=google/gemma-4-26b-a4b:free
# WINGS_MODEL_MID=z-ai/glm-5.2:free
# WINGS_MODEL_FRONTIER=nvidia/nemotron-3-ultra-550b:free

# Diagram rendering: a local plantuml.jar (needs Java) or a PlantUML server
# PLANTUML_JAR=C:/tools/plantuml.jar
# PLANTUML_SERVER_URL=http://localhost:8080
