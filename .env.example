# Copy to .env, or simply use Settings in the Wings sidebar: it writes .env for you.
# Wings reads .env when the backend starts (no export or set needed, also on Windows).
# Real environment variables win over .env. Never commit .env (it is git-ignored).

# mock (default, free, no API calls), openai or openrouter
WINGS_LLM_PROVIDER=mock

# OpenAI: paste a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter: one key for many vendors, see https://openrouter.ai/models (free models end in :free)
OPENROUTER_API_KEY=

# Models per agent tier (small: quick checks, mid: analyst, frontier: architect).
# Defaults for openai: gpt-5-nano, gpt-5-mini, gpt-5. Check the current names with your provider.
# WINGS_MODEL_SMALL=
# WINGS_MODEL_MID=
# WINGS_MODEL_FRONTIER=

# Replay script for the mock provider (default: backend/src/wings/adapters/mock_scripts/demo_todo.json)
# WINGS_MOCK_SCRIPT=

# Where project workspaces are stored (default: <repo>/workspaces)
# WINGS_WORKSPACE_DIR=

# Diagram rendering: a local plantuml.jar (needs Java) or a PlantUML server
# PLANTUML_JAR=C:/tools/plantuml.jar
# PLANTUML_SERVER_URL=http://localhost:8080
