# Copy to .env, or simply use Settings in the Wings sidebar: it writes .env for you.
# Wings reads .env when the backend starts (no export or set needed, also on Windows).
# Real environment variables win over .env. Never commit .env (it is git-ignored).

# mock (default, free, no API calls), openai, openrouter or anthropic
WINGS_LLM_PROVIDER=mock

# OpenAI: paste a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter: the course key (starts with sk-or-). Put it here, not under OPENAI_API_KEY.
OPENROUTER_API_KEY=

# Anthropic (Claude): paste a key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: another endpoint that speaks the Anthropic Messages API (a proxy). Default: api.anthropic.com
# ANTHROPIC_BASE_URL=

# Models per agent tier. Each agent's tier: docs/code/llm.md (frontier: architect, reviewer, refiner, debugger).
# Defaults for openrouter: deepseek/deepseek-v4.1-flash-1017 on every tier (the course's model).
# Defaults for openai: gpt-5-nano, gpt-5-mini, gpt-5. Check the current names with your provider.
# Defaults for anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-sonnet-5-5.
# WINGS_MODEL_SMALL=
# WINGS_MODEL_MID=
# WINGS_MODEL_FRONTIER=

# Claude only: effort per tier (low, medium, high, xhigh, max). Empty: the model's own default.
# Lower effort means faster, cheaper answers with less thinking.
# WINGS_EFFORT_SMALL=
# WINGS_EFFORT_MID=
# WINGS_EFFORT_FRONTIER=

# Replay script for the mock provider (default: backend/src/wings/adapters/mock_scripts/demo_todo.json)
# WINGS_MOCK_SCRIPT=

# Where project workspaces are stored (default: <repo>/workspaces)
# WINGS_WORKSPACE_DIR=

# Where a project's folder is created when you name none: <this folder>/<project name> (default: ~/WingsProjects)
# WINGS_PROJECTS_DIR=

# Diagram rendering: a local plantuml.jar (needs Java) or a PlantUML server
# PLANTUML_JAR=C:/tools/plantuml.jar
# PLANTUML_SERVER_URL=http://localhost:8080
