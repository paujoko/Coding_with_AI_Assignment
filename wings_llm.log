TOOL_CALLS=[{'name': 'check_python', 'args': {'path': 'tests/test_summary.py', 'source': '"""Monthly spending summary by category (REQ-006, REQ-008, REQ-009)."""\n\nfrom __future__ import annotations\n\nimport time\n\nfrom expensetracker.models import MonthlySummary\n\n\ndef test_req_006_monthly_total_and_breakdown(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("60.00", "2026-05-20", "Transport")\n\n    summary = service.monthly_summary()\n    assert summary.month == "2026-05"\n    assert summary.total_cents == 10000\n    assert summary.total_display() == "100.00"\n    assert summary.by_category == {"Groceries": 4000, "Transport": 6000}\n    assert summary.category_display("Groceries") == "40.00"\n    assert summary.category_display("Transport") == "60.00"\n    assert summary.category_display("Health") == "0.00"\n\n\ndef test_req_006_previous_month_expense_is_excluded(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("99.99", "2026-04-30", "Groceries")\n\n    summary = service.monthly_summary()\n    assert summary.total_cents == 4000\n    assert summary.by_category == {"Groceries": 4000}\n    assert "99.99" not in summary.total_display()\n\n\ndef test_req_006_explicit_month_selects_that_month(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("10.00", "2026-04-10", "Utilities")\n\n    april = service.monthly_summary("2026-04")\n    assert april.month == "2026-04"\n    assert april.by_category == {"Utilities": 1000}\n    assert april.total_display() == "10.00"\n\n\ndef test_req_006_december_month_filter_crosses_the_year(service):\n    service.add_expense("5.00", "2026-12-31", "Other")\n    service.add_expense("7.00", "2027-01-01", "Other")\n\n    december = service.monthly_summary("2026-12")\n    assert december.total_display() == "5.00"\n    assert december.by_category == {"Other": 500}\n\n\ndef test_req_006_empty_month_has_zero_total(service):\n    summary = service.monthly_summary()\n    assert summary.total_cents == 0\n    assert summary.total_display() == "0.00"\n    assert summary.by_category == {}\n\n\ndef test_req_008_dime_and_twenty_cent_total_displays_as_0_30(service):\n    service.add_expense("0.10", "2026-05-02", "Groceries")\n    service.add_expense("0.20", "2026-05-03", "Groceries")\n\n    summary = service.monthly_summary()\n    assert summary.category_display("Groceries") == "0.30"\n    assert summary.total_display() == "0.30"\n\n\ndef test_req_008_saved_12_5_displays_with_two_decimals(service, api):\n    expense = service.add_expense("12.5", "2026-05-03", "Groceries")\n    assert expense.amount_display() == "12.50"\n    assert MonthlySummary(month="2026-05", total_cents=expense.amount_cents).total_display() == "12.50"\n\n\ndef test_req_009_summary_of_10000_expenses_is_fast(service, tmp_path):\n    categories = ["Groceries", "Transport", "Utilities", "Other"]\n    started = time.perf_counter()\n    for index in range(10000):\n        service.add_expense(\n            "1.00", "2026-05-%02d" % (index % 28 + 1), categories[index % len(categories)]\n        )\n    loading_done = time.perf_counter()\n\n    summary = service.monthly_summary()\n    finished = time.perf_counter()\n\n    assert summary.total_cents == 10000 * 100\n    assert finished - loading_done < 1.0, "summary request took %.3fs" % (finished - loading_done)\n    assert loading_done - started < 60.0\n\n\ndef test_req_009_saving_an_expense_with_10000_stored_is_fast(database, module_service_factory):\n    service = module_service_factory(database)\n    for index in range(10000):\n        database.execute(\n            "INSERT INTO expenses (amount_cents, spent_on, category_id) VALUES (?, ?, ?)",\n            (100, "2026-05-%02d" % (index % 28 + 1), 1),\n        )\n\n    started = time.perf_counter()\n    expense = service.add_expense("12.50", "2026-05-15", "Groceries")\n    elapsed = time.perf_counter() - started\n\n    assert expense.id > 10000\n    assert elapsed < 1.0, "saving took %.3fs" % elapsed\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_api.py', 'source': '"""JSON API handlers over a real local server (REQ-002..REQ-006, REQ-010)."""\n\nfrom __future__ import annotations\n\nimport json\n\n\ndef test_req_001_serves_the_tracker_page(live_server, client_factory):\n    client = client_factory(live_server)\n    status, content_type, body = client.raw("/")\n    assert status == 200\n    assert "text/html" in content_type\n    text = body.decode("utf-8")\n    assert "Expense Tracker" in text\n    assert \'id="expense-form"\' in text\n\n    for asset, expected in (("/app.js", "text/javascript"), ("/style.css", "text/css")):\n        asset_status, asset_type, _ = client.raw(asset)\n        assert asset_status == 200\n        assert expected in asset_type\n\n\ndef test_req_001_static_path_traversal_is_rejected(api):\n    status, _, _ = api.raw("/../expensetracker/app.py")\n    assert status == 404\n\n\ndef test_req_001_unknown_api_route_is_404(api):\n    status, payload = api.get("/api/unknown")\n    assert status == 404\n    assert "error" in payload\n\n\ndef test_req_002_post_expense_returns_201_and_payload(api):\n    status, payload = api.post(\n        "/api/expenses", {"amount": "12.50", "date": "2026-05-03", "category": "Groceries"}\n    )\n    assert status == 201\n    assert payload["id"] > 0\n    assert payload["amount_display"] == "12.50"\n    assert payload["date"] == "2026-05-03"\n    assert payload["category"] == "Groceries"\n\n    list_status, listing = api.get("/api/expenses")\n    assert list_status == 200\n    assert [item["id"] for item in listing["expenses"]] == [payload["id"]]\n\n\ndef test_req_002_invalid_amount_returns_400_field_and_message(api):\n    status, payload = api.post(\n        "/api/expenses", {"amount": "abc", "date": "2026-05-03", "category": "Groceries"}\n    )\n    assert status == 400\n    assert payload["field"] == "amount"\n    assert payload["message"]\n    assert api.get("/api/expenses")[1]["expenses"] == []\n\n\ndef test_req_002_invalid_date_returns_400_and_saves_nothing(api):\n    status, payload = api.post(\n        "/api/expenses", {"amount": "12.50", "date": "2026-02-31", "category": "Groceries"}\n    )\n    assert status == 400\n    assert payload["field"] == "date"\n    assert api.get("/api/expenses")[1]["expenses"] == []\n\n\ndef test_req_002_malformed_json_body_is_400(api):\n    status, payload = api.post_raw("/api/expenses", "{not json")\n    assert status == 400\n    assert payload["field"] == "body"\n\n\ndef test_req_003_get_expenses_is_newest_first_with_fields(api, service):\n    service.add_expense("10.00", "2026-04-28", "Utilities")\n    service.add_expense("20.00", "2026-05-09", "Groceries")\n    service.add_expense("30.00", "2026-05-01", "Transport")\n\n    status, payload = api.get("/api/expenses")\n    assert status == 200\n    expenses = payload["expenses"]\n    assert [item["date"] for item in expenses] == ["2026-05-09", "2026-05-01", "2026-04-28"]\n    assert [item["amount_display"] for item in expenses] == ["20.00", "30.00", "10.00"]\n    assert [item["category"] for item in expenses] == ["Groceries", "Transport", "Utilities"]\n\n\ndef test_req_003_empty_expense_list_is_empty_array(api):\n    status, payload = api.get("/api/expenses")\n    assert status == 200\n    assert payload["expenses"] == []\n\n\ndef test_req_004_post_budget_saves_and_lists_it(api):\n    status, payload = api.post("/api/budgets", {"category": "Groceries", "amount": "300.00"})\n    assert status == 200\n    assert payload["category"] == "Groceries"\n    assert payload["budget_display"] == "300.00"\n\n    budgets = api.get("/api/budgets")[1]["budgets"]\n    assert len(budgets) == 1\n    assert budgets[0]["budget_display"] == "300.00"\n\n\ndef test_req_004_second_budget_overwrites_first(api):\n    api.post("/api/budgets", {"category": "Groceries", "amount": "300.00"})\n    status, payload = api.post("/api/budgets", {"category": "Groceries", "amount": "350.00"})\n    assert status == 200\n    assert payload["budget_display"] == "350.00"\n\n    budgets = api.get("/api/budgets")[1]["budgets"]\n    assert [item["budget_display"] for item in budgets] == ["350.00"]\n\n\ndef test_req_004_negative_budget_is_400_and_not_saved(api):\n    status, payload = api.post("/api/budgets", {"category": "Groceries", "amount": "-10"})\n    assert status == 400\n    assert payload["field"] == "amount"\n    assert api.get("/api/budgets")[1]["budgets"] == []\n\n\ndef test_req_005_budget_overview_levels(api, service):\n    service.set_budget("Groceries", "100.00")\n    service.set_budget("Transport", "100.00")\n    service.set_budget("Utilities", "100.00")\n    service.add_expense("85.00", "2026-05-02", "Groceries")\n    service.add_expense("120.00", "2026-05-02", "Transport")\n    service.add_expense("40.00", "2026-05-02", "Utilities")\n\n    status, payload = api.get("/api/budgets")\n    assert status == 200\n    by_name = {item["category"]: item for item in payload["budgets"]}\n    assert by_name["Groceries"]["level"] == "NEAR_LIMIT"\n    assert by_name["Groceries"]["spent_display"] == "85.00"\n    assert by_name["Groceries"]["percent"] == 85.0\n    assert by_name["Transport"]["level"] == "OVER"\n    assert by_name["Utilities"]["level"] == "OK"\n\n\ndef test_req_006_summary_endpoint(api, service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("60.00", "2026-05-20", "Transport")\n    service.add_expense("500.00", "2026-04-02", "Groceries")\n\n    status, payload = api.get("/api/summary")\n    assert status == 200\n    assert payload["month"] == "2026-05"\n    assert payload["total_display"] == "100.00"\n    totals = {item["name"]: item["total_display"] for item in payload["categories"]}\n    assert totals == {"Groceries": "40.00", "Transport": "60.00"}\n\n\ndef test_req_010_error_payload_names_field_and_reason(api):\n    status, payload = api.post(\n        "/api/expenses", {"amount": "", "date": "2026-05-03", "category": "Groceries"}\n    )\n    assert status == 400\n    assert payload["field"] == "amount"\n    assert isinstance(payload["message"], str) and payload["message"].strip()\n    assert json.dumps(payload).count("Traceback") == 0\n\n\ndef test_req_010_categories_endpoint_lists_seven_fixed_categories(api):\n    status, payload = api.get("/api/categories")\n    assert status == 200\n    names = [item["name"] for item in payload["categories"]]\n    assert names == [\n        "Groceries",\n        "Rent",\n        "Transport",\n        "Utilities",\n        "Entertainment",\n        "Health",\n        "Other",\n    ]\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_page.py', 'source': '"""The Python tracker page view against a running server (REQ-002..REQ-006, REQ-010)."""\n\nfrom __future__ import annotations\n\nfrom expensetracker.page import TrackerPage\n\n\ndef _page(base_url):\n    return TrackerPage(base_url)\n\n\ndef test_req_003_page_renders_expenses_newest_first(live_server, service):\n    service.add_expense("10.00", "2026-04-28", "Utilities")\n    service.add_expense("20.00", "2026-05-09", "Groceries")\n    service.add_expense("30.00", "2026-05-01", "Transport")\n\n    page = _page(live_server)\n    payload = page.callApi("GET", "/api/expenses")\n    page.renderExpenses(payload["expenses"])\n\n    rows = page._expense_rows\n    assert [row[0] for row in rows] == ["2026-05-09", "2026-05-01", "2026-04-28"]\n    assert "Groceries" in rows[0][2] and "20.00" in rows[0][2]\n    assert "Transport" in rows[1][2] and "30.00" in rows[1][2]\n    assert "Utilities" in rows[2][2] and "10.00" in rows[2][2]\n\n\ndef test_req_003_page_renders_no_rows_when_list_empty(live_server):\n    page = _page(live_server)\n    page.renderExpenses(page.callApi("GET", "/api/expenses")["expenses"])\n    assert page._expense_rows == []\n\n\ndef test_req_002_page_inserts_saved_expense_in_date_order(live_server):\n    service_page = _page(live_server)\n    service_page.renderExpenses([])\n    service_page.callApi(\n        "POST", "/api/expenses", {"amount": "5.00", "date": "2026-05-01", "category": "Health"}\n    )\n    service_page.callApi(\n        "POST", "/api/expenses", {"amount": "6.00", "date": "2026-05-20", "category": "Rent"}\n    )\n\n    saved = service_page.callApi(\n        "POST", "/api/expenses", {"amount": "7.50", "date": "2026-05-10", "category": "Other"}\n    )\n    service_page.insertRow(saved)\n\n    assert [row[0] for row in service_page._expense_rows] == [\n        "2026-05-20",\n        "2026-05-10",\n        "2026-05-01",\n    ]\n    assert "7.50" in service_page._expense_rows[1][2]\n\n\ndef test_req_005_page_renders_budget_warning_states(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("85.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "Groceries" in row\n    assert "100.00" in row\n    assert "85.00" in row\n    assert "level-near_limit" in row\n    assert "Close to limit" in row\n\n\ndef test_req_005_page_renders_over_budget_state(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("120.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "level-over" in row\n    assert "Over budget" in row\n\n\ndef test_req_005_page_renders_no_badge_when_within_limit(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "level-ok" in row\n    assert "badge" not in row\n\n\ndef test_req_006_page_renders_summary(live_server, service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("60.00", "2026-05-20", "Transport")\n\n    page = _page(live_server)\n    page.renderSummary(page.callApi("GET", "/api/summary"))\n    markup = page._summary_html\n    assert "100.00" in markup\n    assert "2026-05" in markup\n    assert "Groceries" in markup and "40.00" in markup\n    assert "Transport" in markup and "60.00" in markup\n\n\ndef test_req_006_page_summary_empty_state(live_server):\n    page = _page(live_server)\n    page.renderSummary(page.callApi("GET", "/api/summary"))\n    assert "No spending recorded this month yet." in page._summary_html\n    assert "0.00" in page._summary_html\n\n\ndef test_req_010_page_shows_success_and_error_messages(live_server):\n    page = _page(live_server)\n    page.showMessage("Expense saved.", False)\n    assert "message success" in page._message_html\n    assert \'role="status"\' in page._message_html\n\n    page.showMessage("Amount: Amount must be greater than zero.", True)\n    assert "message error" in page._message_html\n    assert \'role="alert"\' in page._message_html\n    assert "Amount must be greater than zero." in page._message_html\n\n\ndef test_req_010_page_escapes_untrusted_text(live_server):\n    page = _page(live_server)\n    page.renderExpenses(\n        [{"id": 1, "date": "2026-05-02", "category": "<script>x</script>", "amount_display": "1.00"}]\n    )\n    assert "<script>" not in page._expense_rows[0][2]\n    assert "&lt;script&gt;" in page._expense_rows[0][2]\n\n\ndef test_req_010_page_returns_error_payload_on_validation_failure(live_server):\n    page = _page(live_server)\n    result = page.callApi(\n        "POST", "/api/expenses", {"amount": "0", "date": "2026-05-02", "category": "Groceries"}\n    )\n    assert result["field"] == "amount"\n    assert result["message"]\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_persistence.py', 'source': '"""SQLite storage: creation on first run and survival across restarts (REQ-007, REQ-001)."""\n\nfrom __future__ import annotations\n\nimport http.client\nimport json\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom pathlib import Path\n\nimport pytest\n\nfrom expensetracker.repositories import CategoryRepository\n\n\ndef test_req_007_schema_creates_file_on_first_run(tmp_path):\n    from expensetracker.database import AppDatabase\n\n    path = tmp_path / "data" / "expense_tracker.db"\n    assert not path.exists()\n    database = AppDatabase(str(path))\n    database.create_schema()\n    assert path.is_file()\n\n    categories = CategoryRepository(database)\n    assert categories.list_all() == []\n    categories.seed_defaults()\n    assert len(categories.list_all()) == 7\n    assert "Groceries" in [category.name for category in categories.list_all()]\n\n\ndef test_req_007_seeding_twice_keeps_seven_categories(database):\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    categories.seed_defaults()\n    assert len(categories.list_all()) == 7\n\n\ndef test_req_007_expenses_and_budgets_survive_reopen(tmp_path, service_builder):\n    path = tmp_path / "expense_tracker.db"\n    _, first = service_builder(path)\n    first.add_expense("12.50", "2026-05-03", "Groceries")\n    first.set_budget("Groceries", "300.00")\n\n    _, second = service_builder(path)\n    expenses = second.list_expenses()\n    assert len(expenses) == 1\n    assert expenses[0].amount_display() == "12.50"\n    assert expenses[0].spent_on.isoformat() == "2026-05-03"\n\n    budgets = second.budget_overview()\n    assert len(budgets) == 1\n    assert budgets[0].category_name == "Groceries"\n    assert budgets[0].budget_cents == 30000\n\n\ndef test_req_007_fresh_database_starts_with_empty_expense_list(tmp_path, service_builder):\n    _, service = service_builder(tmp_path / "brand_new.db")\n    assert service.list_expenses() == []\n    assert service.budget_overview() == []\n    assert service.monthly_summary().total_display() == "0.00"\n\n\ndef _free_port() -> int:\n    import socket\n\n    with socket.socket() as sock:\n        sock.bind(("127.0.0.1", 0))\n        return int(sock.getsockname()[1])\n\n\ndef _wait_for_server(port: int, timeout: float = 20.0) -> None:\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        try:\n            connection = http.client.HTTPConnection("127.0.0.1", port, timeout=1)\n            connection.request("GET", "/api/categories")\n            connection.getresponse().read()\n            connection.close()\n            return\n        except OSError:\n            time.sleep(0.05)\n    raise AssertionError("server did not start within %.0fs" % timeout)\n\n\ndef _start_server(port: int, home: Path) -> subprocess.Popen:\n    env = dict(os.environ)\n    env["HOME"] = str(home)\n    proc = subprocess.Popen(\n        [sys.executable, "-m", "expensetracker", "--port", str(port)],\n        cwd=str(Path(__file__).resolve().parent.parent),\n        env=env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.STDOUT,\n    )\n    _wait_for_server(port)\n    return proc\n\n\ndef _post(port: int, path: str, payload: dict) -> tuple[int, dict]:\n    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)\n    body = json.dumps(payload).encode("utf-8")\n    connection.request(\n        "POST", path, body=body, headers={"Content-Type": "application/json"}\n    )\n    response = connection.getresponse()\n    data = json.loads(response.read().decode("utf-8") or "{}")\n    status = response.status\n    connection.close()\n    return status, data\n\n\ndef _get(port: int, path: str):\n    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)\n    connection.request("GET", path)\n    response = connection.getresponse()\n    data = json.loads(response.read().decode("utf-8") or "{}")\n    status = response.status\n    connection.close()\n    return status, data\n\n\ndef test_req_001_python_dash_m_starts_the_served_page(tmp_path):\n    port = _free_port()\n    proc = _start_server(port, tmp_path)\n    try:\n        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)\n        connection.request("GET", "/")\n        response = connection.getresponse()\n        body = response.read().decode("utf-8")\n        content_type = response.headers.get("Content-Type", "")\n        connection.close()\n        assert response.status == 200\n        assert "text/html" in content_type\n        assert "Expense Tracker" in body\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n\n\ndef test_req_007_restarted_server_still_serves_saved_data(tmp_path):\n    port = _free_port()\n    proc = _start_server(port, tmp_path)\n    try:\n        status, created = _post(\n            port,\n            "/api/expenses",\n            {"amount": "12.50", "date": "2026-05-03", "category": "Groceries"},\n        )\n        assert status == 201\n        assert _post(port, "/api/budgets", {"category": "Groceries", "amount": "300.00"})[0] == 200\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n\n    proc = _start_server(port, tmp_path)\n    try:\n        expenses = _get(port, "/api/expenses")[1]["expenses"]\n        assert [item["amount_display"] for item in expenses] == ["12.50"]\n        budgets = _get(port, "/api/budgets")[1]["budgets"]\n        assert [item["budget_display"] for item in budgets] == ["300.00"]\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n'}}]

