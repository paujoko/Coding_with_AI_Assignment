          "function": {
            "name": "check_python",
            "arguments": "{\"path\": \"expensetracker/models.py\", \"source\": \"\\\"\\\"\\\"Domain models: Expense, Category, Budget, BudgetLevel, BudgetStatus, MonthlySummary.\\n\\nImplements the model classes of the domain class diagram.\\nTrace: REQ-003, REQ-004, REQ-005, REQ-006, REQ-008\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom dataclasses import dataclass, field\\nfrom datetime import date\\nfrom enum import Enum\\n\\nfrom .money import Money\\n\\n\\n@dataclass\\nclass Category:\\n    \\\"\\\"\\\"A fixed spending category such as Groceries.\\\"\\\"\\\"\\n\\n    id: int\\n    name: str\\n\\n\\n@dataclass\\nclass Expense:\\n    \\\"\\\"\\\"One recorded expense; the amount is stored as integer cents.\\\"\\\"\\\"\\n\\n    id: int\\n    amount_cents: int\\n    spent_on: date\\n    category_id: int\\n\\n    def amount_display(self) -> str:\\n        return Money.format_cents(self.amount_cents)\\n\\n\\n@dataclass\\nclass Budget:\\n    \\\"\\\"\\\"The monthly limit of one category, in integer cents.\\\"\\\"\\\"\\n\\n    id: int\\n    category_id: int\\n    amount_cents: int\\n\\n    def amount_display(self) -> str:\\n        return Money.format_cents(self.amount_cents)\\n\\n\\nclass BudgetLevel(Enum):\\n    \\\"\\\"\\\"How far this month's spending has gone against a budget.\\\"\\\"\\\"\\n\\n    OK = \\\"OK\\\"\\n    NEAR_LIMIT = \\\"NEAR_LIMIT\\\"\\n    OVER = \\\"OVER\\\"\\n\\n\\n@dataclass\\nclass BudgetStatus:\\n    \\\"\\\"\\\"Budget usage of one category for one month, with its warning level.\\\"\\\"\\\"\\n\\n    category_name: str\\n    budget_cents: int\\n    spent_cents: int\\n    level: BudgetLevel\\n\\n    def percent_used(self) -> float:\\n        if self.budget_cents <= 0:\\n            return 0.0\\n        return round(self.spent_cents * 100.0 / self.budget_cents, 1)\\n\\n    def message(self) -> str:\\n        percent = self.percent_used()\\n        text = f\\\"{percent:.0f}\\\" if float(percent).is_integer() else f\\\"{percent:.1f}\\\"\\n        if self.level is BudgetLevel.OVER:\\n            return f\\\"Over budget: {text}% used\\\"\\n        if self.level is BudgetLevel.NEAR_LIMIT:\\n            return f\\\"Close to the limit: {text}% of budget used\\\"\\n        return f\\\"{text}% of budget used\\\"\\n\\n    @staticmethod\\n    def evaluate(category_name: str, budget_cents: int, spent_cents: int) -> \\\"BudgetStatus\\\":\\n        \\\"\\\"\\\"Classify spending: OK below 80%, NEAR_LIMIT 80-100%, OVER above 100%.\\\"\\\"\\\"\\n        if budget_cents <= 0:\\n            level = BudgetLevel.OK\\n        else:\\n            percent = spent_cents * 100.0 / budget_cents\\n            if percent > 100.0:\\n                level = BudgetLevel.OVER\\n            elif percent >= 80.0:\\n                level = BudgetLevel.NEAR_LIMIT\\n            else:\\n                level = BudgetLevel.OK\\n        return BudgetStatus(\\n            category_name=category_name,\\n            budget_cents=budget_cents,\\n            spent_cents=spent_cents,\\n            level=level,\\n        )\\n\\n\\n@dataclass\\nclass MonthlySummary:\\n    \\\"\\\"\\\"Total spending of one calendar month, overall and per category.\\\"\\\"\\\"\\n\\n    month: str\\n    total_cents: int\\n    by_category: dict = field(default_factory=dict)\\n\\n    def total_display(self) -> str:\\n        return Money.format_cents(self.total_cents)\\n\\n    def category_display(self, category_name: str) -> str:\\n        return Money.format_cents(int(self.by_category.get(category_name, 0)))\\n\"}"
          }
        },
