            "name": "check_python",
            "arguments": "{\"path\": \"expensetracker/server.py\", \"source\": \"\\\"\\\"\\\"TrackerServer: the single-threaded local HTTP server.\\n\\nImplements the TrackerServer class of the domain class diagram and the\\n\\\"Startup and storage\\\" sequence diagram.\\nTrace: REQ-001, REQ-009\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\\n\\n\\nclass TrackerServer:\\n    \\\"\\\"\\\"Binds 127.0.0.1 and serves the tracker page and its JSON API.\\\"\\\"\\\"\\n\\n    def __init__(self, port: int, handler: type[BaseHTTPRequestHandler]) -> None:\\n        self.port = port\\n        self._httpd = HTTPServer((\\\"127.0.0.1\\\", port), handler)\\n\\n    def serve_forever(self) -> None:\\n        self._httpd.serve_forever()\\n\"}"
          }
