\n  line-height: 1.45;\n}\n\n.page-header {\n  padding: 1.5rem 1.5rem 0.5rem;\n  max-width: 62rem;\n  margin: 0 auto;\n}\n\nh1 {\n  font-size: 1.6rem;\n  margin: 0 0 0.5rem;\n}\n\nh2 {\n  font-size: 1.15rem;\n  margin: 0 0 1rem;\n}\n\nmain {\n  max-width: 62rem;\n  margin: 0 auto;\n  padding: 0 1.5rem;\n  display: grid;\n  gap: 1.25rem;\n  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));\n  align-items: start;\n}\n\n.card {\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 0.6rem;\n  padding: 1.25rem;\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin-bottom: 0.85rem;\n}\n\nlabel {\n  font-weight: 600;\n  font-size: 0.9rem;\n}\n\ninput,\nselect,\nbutton {\n  font: inherit;\n  padding: 0.5rem 0.6rem;\n  border-radius: 0.4rem;\n  border: 1px solid var(--line);\n  background: #fff;\n  color: inherit;\n}\n\ninput:focus,\nselect:focus,\nbutton:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 1px;\n}\n\nbutton {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n  font-weight: 600;\n  cursor: pointer;\n}\n\nbutton:hover {\n  filter: brightness(1.08);\n}\n\n.message {\n  margin: 0;\n  padding: 0.6rem 0.8rem;\n  border-radius: 0.45rem;\n  font-weight: 600;\n}\n\n.message.success {\n  background: #e7f5ec;\n  color: var(--ok);\n  border: 1px solid #b9e0c7;\n}\n\n.message.error {\n  background: #fdecea;\n  color: var(--over);\n  border: 1px solid #f3c2bc;\n}\n\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 0.75rem;\n}\n\n.data-table th,\n.data-table td {\n  text-align: left;\n  padding: 0.45rem 0.35rem;\n  border-bottom: 1px solid var(--line);\n  font-size: 0.92rem;\n}\n\n.data-table thead th {\n  color: var(--muted);\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.amount {\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.data-table th.amount,\n.data-table td.amount {\n  text-align: right;\n}\n\n.level-near_limit .budget-message {\n  color: var(--near);\n}\n\n.level-over .budget-message {\n  color: var(--over);\n}\n\n.badge {\n  display: inline-block;\n  margin-right: 0.4rem;\n  padding: 0.1rem 0.45rem;\n  border-radius: 999px;\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: #fff;\n  background: var(--ok);\n}\n\n.level-near_limit .badge {\n  background: var(--near);\n}\n\n.level-over .badge {\n  background: var(--over);\n}\n\n.summary-total {\n  font-size: 1rem;\n  margin: 0 0 0.75rem;\n}\n\n.summary-total strong {\n  font-size: 1.3rem;\n  font-variant-numeric: tabular-nums;\n}\n\n.summary-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.summary-list li {\n  display: flex;\n  justify-content: space-between;\n  padding: 0.35rem 0;\n  border-bottom: 1px solid var(--line);\n}\n\n.empty,\n.muted {\n  color: var(--muted);\n}\n\n.empty {\n  font-style: italic;\n  font-size: 0.9rem;\n  margin: 0.75rem 0 0;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n'}}]
