            "name": "check_python",
            "arguments": "{\"path\": \"tests/test_money_dates.py\", \"source\": \"\\\"\\\"\\\"Exact money parsing/formatting and strict date parsing (REQ-002, REQ-008, REQ-010).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom datetime import date\\n\\nimport pytest\\n\\nfrom expensetracker.dates import Dates\\nfrom expensetracker.errors import ValidationError\\nfrom expensetracker.money import Money\\n\\n\\ndef test_req_002_parse_amount_returns_cents():\\n    assert Money.parse_amount(\\\"12.50\\\") == 1250\\n    assert Money.parse_amount(\\\"0.01\\\") == 1\\n    assert Money.parse_amount(\\\" 7 \\\") == 700\\n    assert Money.parse_amount(\\\"100\\\") == 10000\\n\\n\\n@pytest.mark.parametrize(\\\"text\\\", [None, \\\"\\\", \\\"   \\\"])\\ndef test_req_002_parse_amount_rejects_missing_amount(text):\\n    with pytest.raises(ValidationError) as info:\\n        Money.parse_amount(text)\\n    assert info.value.field == \\\"amount\\\"\\n    assert info.value.message\\n    assert \\\"required\\\" in info.value.message.lower()\\n\\n\\n@pytest.mark.parametrize(\\\"text\\\", [\\\"abc\\\", \\\"12,50\\\", \\\"1.2.3\\\", \\\"ten\\\", \\\"NaN\\\", \\\"Infinity\\\"])\\ndef test_req_002_parse_amount_rejects_non_numeric(text):\\n    with pytest.raises(ValidationError) as info:\\n        Money.parse_amount(text)\\n    assert info.value.field == \\\"amount\\\"\\n    assert \\\"number\\\" in info.value.message.lower()\\n\\n\\n@pytest.mark.parametrize(\\\"text\\\", [\\\"0\\\", \\\"0.00\\\", \\\"-1\\\", \\\"-0.01\\\"])\\ndef test_req_002_parse_amount_rejects_non_positive(text):\\n    with pytest.raises(ValidationError) as info:\\n        Money.parse_amount(text)\\n    assert info.value.field == \\\"amount\\\"\\n    assert \\\"greater than zero\\\" in info.value.message.lower()\\n\\n\\ndef test_req_002_parse_date_accepts_valid_calendar_dates():\\n    assert Dates.parse_date(\\\"2026-05-03\\\") == date(2026, 5, 3)\\n    assert Dates.parse_date(\\\" 2026-05-31 \\\") == date(2026, 5, 31)\\n    assert Dates.parse_date(\\\"2024-02-29\\\") == date(2024, 2, 29)\\n\\n\\n@pytest.mark.parametrize(\\n    \\\"text\\\",\\n    [None, \\\"\\\", \\\"2026-02-30\\\", \\\"2026-13-01\\\", \\\"2025-02-29\\\", \\\"03/05/2026\\\", \\\"2026-05-3\\\", \\\"tomorrow\\\"],\\n)\\ndef test_req_002_parse_date_rejects_invalid_calendar_dates(text):\\n    with pytest.raises(ValidationError) as info:\\n        Dates.parse_date(text)\\n    assert info.value.field == \\\"date\\\"\\n    assert info.value.message\\n\\n\\ndef test_req_008_format_cents_always_two_decimals():\\n    assert Money.format_cents(1250) == \\\"12.50\\\"\\n    assert Money.format_cents(5) == \\\"0.05\\\"\\n    assert Money.format_cents(10000) == \\\"100.00\\\"\\n    assert Money.format_cents(0) == \\\"0.00\\\"\\n\\n\\ndef test_req_008_dimes_add_without_float_drift():\\n    total = Money.parse_amount(\\\"0.10\\\") + Money.parse_amount(\\\"0.20\\\")\\n    assert total == 30\\n    assert isinstance(total, int)\\n    assert Money.format_cents(total) == \\\"0.30\\\"\\n\\n\\ndef test_req_010_validation_error_carries_field_and_plain_message():\\n    with pytest.raises(ValidationError) as info:\\n        Money.parse_amount(\\\"abc\\\")\\n    error = info.value\\n    assert error.field == \\\"amount\\\"\\n    assert error.message == str(error)\\n    assert \\\"Traceback\\\" not in error.message\\n\"}"
          }
