            "name": "check_python",
            "arguments": "{\"path\": \"tests/test_summary.py\", \"source\": \"\\\"\\\"\\\"Monthly spending summary by category (REQ-006, REQ-008, REQ-009).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport time\\n\\nfrom expensetracker.models import MonthlySummary\\n\\n\\ndef test_req_006_monthly_total_and_breakdown(service):\\n    service.add_expense(\\\"40.00\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"60.00\\\", \\\"2026-05-20\\\", \\\"Transport\\\")\\n\\n    summary = service.monthly_summary()\\n    assert summary.month == \\\"2026-05\\\"\\n    assert summary.total_cents == 10000\\n    assert summary.total_display() == \\\"100.00\\\"\\n    assert summary.by_category == {\\\"Groceries\\\": 4000, \\\"Transport\\\": 6000}\\n    assert summary.category_display(\\\"Groceries\\\") == \\\"40.00\\\"\\n    assert summary.category_display(\\\"Transport\\\") == \\\"60.00\\\"\\n    assert summary.category_display(\\\"Health\\\") == \\\"0.00\\\"\\n\\n\\ndef test_req_006_previous_month_expense_is_excluded(service):\\n    service.add_expense(\\\"40.00\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"99.99\\\", \\\"2026-04-30\\\", \\\"Groceries\\\")\\n\\n    summary = service.monthly_summary()\\n    assert summary.total_cents == 4000\\n    assert summary.by_category == {\\\"Groceries\\\": 4000}\\n    assert \\\"99.99\\\" not in summary.total_display()\\n\\n\\ndef test_req_006_explicit_month_selects_that_month(service):\\n    service.add_expense(\\\"40.00\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"10.00\\\", \\\"2026-04-10\\\", \\\"Utilities\\\")\\n\\n    april = service.monthly_summary(\\\"2026-04\\\")\\n    assert april.month == \\\"2026-04\\\"\\n    assert april.by_category == {\\\"Utilities\\\": 1000}\\n    assert april.total_display() == \\\"10.00\\\"\\n\\n\\ndef test_req_006_december_month_filter_crosses_the_year(service):\\n    service.add_expense(\\\"5.00\\\", \\\"2026-12-31\\\", \\\"Other\\\")\\n    service.add_expense(\\\"7.00\\\", \\\"2027-01-01\\\", \\\"Other\\\")\\n\\n    december = service.monthly_summary(\\\"2026-12\\\")\\n    assert december.total_display() == \\\"5.00\\\"\\n    assert december.by_category == {\\\"Other\\\": 500}\\n\\n\\ndef test_req_006_empty_month_has_zero_total(service):\\n    summary = service.monthly_summary()\\n    assert summary.total_cents == 0\\n    assert summary.total_display() == \\\"0.00\\\"\\n    assert summary.by_category == {}\\n\\n\\ndef test_req_008_dime_and_twenty_cent_total_displays_as_0_30(service):\\n    service.add_expense(\\\"0.10\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"0.20\\\", \\\"2026-05-03\\\", \\\"Groceries\\\")\\n\\n    summary = service.monthly_summary()\\n    assert summary.category_display(\\\"Groceries\\\") == \\\"0.30\\\"\\n    assert summary.total_display() == \\\"0.30\\\"\\n\\n\\ndef test_req_008_saved_12_5_displays_with_two_decimals(service, api):\\n    expense = service.add_expense(\\\"12.5\\\", \\\"2026-05-03\\\", \\\"Groceries\\\")\\n    assert expense.amount_display() == \\\"12.50\\\"\\n    assert MonthlySummary(month=\\\"2026-05\\\", total_cents=expense.amount_cents).total_display() == \\\"12.50\\\"\\n\\n\\ndef test_req_009_summary_of_10000_expenses_is_fast(service, tmp_path):\\n    categories = [\\\"Groceries\\\", \\\"Transport\\\", \\\"Utilities\\\", \\\"Other\\\"]\\n    started = time.perf_counter()\\n    for index in range(10000):\\n        service.add_expense(\\n            \\\"1.00\\\", \\\"2026-05-%02d\\\" % (index % 28 + 1), categories[index % len(categories)]\\n        )\\n    loading_done = time.perf_counter()\\n\\n    summary = service.monthly_summary()\\n    finished = time.perf_counter()\\n\\n    assert summary.total_cents == 10000 * 100\\n    assert finished - loading_done < 1.0, \\\"summary request took %.3fs\\\" % (finished - loading_done)\\n    assert loading_done - started < 60.0\\n\\n\\ndef test_req_009_saving_an_expense_with_10000_stored_is_fast(database, module_service_factory):\\n    service = module_service_factory(database)\\n    for index in range(10000):\\n        database.execute(\\n            \\\"INSERT INTO expenses (amount_cents, spent_on, category_id) VALUES (?, ?, ?)\\\",\\n            (100, \\\"2026-05-%02d\\\" % (index % 28 + 1), 1),\\n        )\\n\\n    started = time.perf_counter()\\n    expense = service.add_expense(\\\"12.50\\\", \\\"2026-05-15\\\", \\\"Groceries\\\")\\n    elapsed = time.perf_counter() - started\\n\\n    assert expense.id > 10000\\n    assert elapsed < 1.0, \\\"saving took %.3fs\\\" % elapsed\\n\"}"
