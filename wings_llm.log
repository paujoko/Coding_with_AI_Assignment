      "role": "user",
      "content": "Current code:\n### expensetracker/api.py\n\"\"\"ApiHandler: the JSON API and the static file server of the tracker page.\n\nImplements the ApiHandler class of the domain class diagram and the routing\nshown in the \"Log expense\", \"Set budget\", \"Budget overview\" and \"Monthly\nsummary\" sequence diagrams.\nTrace: REQ-001, REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-010\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom http.server import BaseHTTPRequestHandler\nfrom pathlib import Path\nfrom typing import ClassVar\nfrom urllib.parse import urlsplit\n\nfrom .errors import ValidationError\nfrom .models import BudgetStatus\nfrom .money import Money\nfrom .service import ExpenseTrackerService\n\nSTATIC_DIR = Path(__file__).resolve().parent / \"static\"\n\nCONTENT_TYPES: dict[str, str] = {\n    \".html\": \"text/html; charset=utf-8\",\n    \".css\": \"text/css; charset=utf-8\",\n    \".js\": \"text/javascript; charset=utf-8\",\n    \".json\": \"application/json; charset=utf-8\",\n    \".svg\": \"image/svg+xml\",\n    \".ico\": \"image/x-icon\",\n}\n\n\nclass ApiHandler(BaseHTTPRequestHandler):\n    \"\"\"Serves /api/* as JSON and everything else from the static directory.\n\n    ``ApiHandler(service)`` returns a subclass with the service bound, so the\n    server can be built exactly as the start-up sequence shows:\n    ``TrackerServer(port=8000, handler=ApiHandler(service))``.\n    \"\"\"\n\n    service: ClassVar[ExpenseTrackerService]\n    static_dir: ClassVar[Path] = STATIC_DIR\n\n    def __new__(cls, *args, **kwargs):\n        if len(args) == 1 and not kwargs and isinstance(args[0], ExpenseTrackerService):\n            return type(f\"{cls.__name__}Bound\", (cls,), {\"service\": args[0]})\n        return super().__new__(cls)\n\n    # -- HTTP verbs ---------------------------------------------------------\n\n    def do_GET(self) -> None:\n        path = urlsplit(self.path).path\n        if not path.startswith(\"/api/\"):\n            self.send_static(path)\n            return\n        try:\n            status, payload = self.route_get(path)\n        except ValidationError as error:\n            status, payload = 400, {\"field\": error.field, \"message\": error.message}\n        except Exception:  # noqa: BLE001 - never leak a traceback to the page\n            status, payload = 500, {\"error\": \"Internal server error\"}\n        self.send_json(status, payload)\n\n    def do_POST(self) -> None:\n        path = urlsplit(self.path).path\n        length = int(self.headers.get(\"Content-Length\") or 0)\n        raw = self.rfile.read(length) if length > 0 else b\"\"\n        try:\n            body = json.loads(raw.decode(\"utf-8\") or \"{}\")\n        except (UnicodeDecodeError, json.JSONDecodeError):\n            self.send_json(400, {\"field\": \"body\", \"message\": \"Request body must be valid JSON.\"})\n            return\n        if not isinstance(body, dict):\n            self.send_json(400, {\"field\": \"body\", \"message\": \"Request body must be a JSON object.\"})\n            return\n        try:\n            status, payload = self.route_post(path, body)\n        except ValidationError as error:\n            status, payload = 400, {\"field\": error.field, \"message\": error.message}\n        except Exception:  # noqa: BLE001\n            status, payload = 500, {\"error\": \"Internal server error\"}\n        self.send_json(status, payload)\n\n    # -- routing ------------------------------------------------------------\n\n    def route_get(self, path: str) -> tuple[int, dict]:\n        \"\"\"Dispatch a GET request: expenses, categories, budgets or summary.\"\"\"\n        service = self.service\n        names = {category.id: category.name for category in service.list_categories()}\n        if path == \"/api/expenses\":\n            return 200, {\n                \"expenses\": [\n                    {\n                        \"id\": expense.id,\n                        \"amount_display\": expense.amount_display(),\n                        \"date\": expense.spent_on.isoformat(),\n                        \"category\": names.get(expense.category_id, \"Unknown\"),\n                    }\n                    for expense in service.list_expenses()\n                ]\n            }\n        if path == \"/api/categories\":\n            return 200, {\n                \"categories\": [\n                    {\"id\": category.id, \"name\": category.name}\n                    for category in service.list_categories()\n                ]\n            }\n        if path == \"/api/budgets\":\n            return 200, {\"budgets\": [self._budget_payload(item) for item in service.budget_overview()]}\n        if path == \"/api/summary\":\n            summary = service.monthly_summary()\n            return 200, {\n                \"month\": summary.month,\n                \"total_display\": summary.total_display(),\n                \"categories\": [\n                    {\"name\": name, \"total_display\": summary.category_display(name)}\n                    for name in summary.by_category\n                ],\n            }\n        return 404, {\"error\": \"Not found\"}\n\n    def route_post(self, path: str, body: dict) -> tuple[int, dict]:\n        \"\"\"Dispatch a POST request: save an expense or set a budget.\"\"\"\n        service = self.service\n        if path == \"/api/expenses\":\n            expense = service.add_expense(body.get(\"amount\"), body.get(\"date\"), body.get(\"category\"))\n            names = {category.id: category.name for category in service.list_categories()}\n            return 201, {\n                \"id\": expense.id,\n                \"amount_display\": expense.amount_display(),\n                \"date\": expense.spent_on.isoformat(),\n                \"category\": names.get(expense.category_id, \"Unknown\"),\n            }\n        if path == \"/api/budgets\":\n            budget = service.set_budget(body.get(\"category\"), body.get(\"amount\"))\n            names = {category.id: category.name for category in service.list_categories()}\n            return 200, {\n                \"category\": names.get(budget.category_id, \"Unknown\"),\n                \"budget_display\": budget.amount_display(),\n            }\n        return 404, {\"error\": \"Not found\"}\n\n    # -- responses ----------------------------------------------------------\n\n    def send_json(self, status: int, payload: dict) -> None:\n        \"\"\"Write a JSON response with the given HTTP status.\"\"\"\n        data = json.dumps(payload).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        self.send_header(\"Cache-Control\", \"no-store\")\n        self.end_headers()\n        self.wfile.write(data)\n\n    def send_static(self, path: str) -> None:\n        \"\"\"Serve index.html, app.js and style.css from the static directory.\"\"\"\n        name = path.lstrip(\"/\") or \"index.html\"\n        if name.endswith(\"/\"):\n            name += \"index.html\"\n        root = self.static_dir.resolve()\n        target = (root / name).resolve()\n        try:\n            target.relative_to(root)\n        except ValueError:\n            self.send_json(404, {\"error\": \"Not found\"})\n            return\n        if not target.is_file():\n            self.send_json(404, {\"error\": \"Not found\"})\n            return\n        data = target.read_bytes()\n        self.send_response(200)\n        self.send_header(\n            \"Content-Type\", CONTENT_TYPES.get(target.suffix, \"application/octet-stream\")\n        )\n        self.send_header(\"Content-Length\", str(len(data)))\n        self.send_header(\"Cache-Control\", \"no-store\")\n        self.end_headers()\n        self.wfile.write(data)\n\n    # -- helpers ------------------------------------------------------------\n\n    @staticmethod\n    def _budget_payload(status: BudgetStatus) -> dict:\n        \"\"\"Shape one BudgetStatus for the budget overview response.\"\"\"\n        return {\n            \"category\": status.category_name,\n            \"budget_display\": Money.format_cents(status.budget_cents),\n            \"spent_display\": Money.format_cents(status.spent_cents),\n            \"percent\": status.percent_used(),\n            \"level\": status.level.value,\n            \"message\": status.message(),\n        }\n\n\n### expensetracker/app.py\n\"\"\"App: the entry point that wires storage, service and server together.\n\nImplements the App class of the domain class diagram and the \"Startup and\nstorage\" sequence diagram.\nTrace: REQ-001, REQ-007\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport threading\nfrom pathlib import Path\nfrom urllib.request import urlopen\n\nfrom .api import ApiHandler\nfrom .clock import Clock\nfrom .database import AppDatabase\nfrom .repositories import BudgetRepository, CategoryRepository, ExpenseRepository\nfrom .server import TrackerServer\nfrom .service import ExpenseTrackerService\n\nDEFAULT_PORT = 8000\nDATA_FILE = Path(__file__).resolve().parent.parent / \"data\" / \"expense_tracker.db\"\n\n\nclass App:\n    \"\"\"Builds the object graph in the order the start-up sequence shows.\"\"\"\n\n    @staticmethod\n    def main(argv: list[str] | None = None) -> None:\n        \"\"\"Create the schema, seed categories, wire the service and serve.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"python -m expensetracker\",\n            description=\"Local single-user expense tracker.\",\n        )\n        parser.add_argument(\"--port\", type=int, default=DEFAULT_PORT, help=\"port to listen on\")\n        parser.add_argument(\n            \"--check\",\n            action=\"store_true\",\n            help=\"start on a free port, request the main page once, print the status and exit\",\n        )\n        args = parser.parse_args(argv)\n\n        database = AppDatabase(str(DATA_FILE))\n        database.create_schema()\n\n        categories = CategoryRepository(database)\n        categories.seed_defaults()\n        expenses = ExpenseRepository(database)\n        budgets = BudgetRepository(database)\n        service = ExpenseTrackerService(expenses, budgets, categories, Clock())\n\n        server = TrackerServer(port=0 if args.check else args.port, handler=ApiHandler(service))\n\n        if args.check:\n            App._smoke_test(server)\n            return\n\n        print(f\"Expense tracker running at http://127.0.0.1:{args.port}/ (Ctrl+C to stop)\")\n        try:\n            server.serve_forever()\n        except KeyboardInterrupt:\n            print(\"\\nStopped.\")\n        finally:\n            server._shutdown()\n\n    @staticmethod\n    def _smoke_test(server: TrackerServer) -> None:\n        \"\"\"Start the server, request the main page once and print its status.\"\"\"\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\n        thread.start()\n        try:\n            with urlopen(f\"http://127.0.0.1:{server._bound_port()}/\", timeout=10) as response:\n                print(f\"GET / -> {response.status}\")\n        finally:\n            server._shutdown()\n            thread.join(timeout=5)\n\n\n### expensetracker/clock.py\n\"\"\"Clock: the source of \"today\" and of the current calendar month.\n\nImplements the Clock utility class of the domain class diagram.\nTrace: REQ-005, REQ-006\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\n\nclass Clock:\n    \"\"\"Wall-clock helper; tests can subclass it to fix the current month.\"\"\"\n\n    def today(self) -> date:\n        \"\"\"The current local date.\"\"\"\n        return date.today()\n\n    def current_month(self) -> str:\n        \"\"\"The current calendar month as YYYY-MM, e.g. \"2026-05\".\"\"\"\n        return self.today().strftime(\"%Y-%m\")\n\n\n### expensetracker/database.py\n\"\"\"AppDatabase: SQLite file storage, schema creation and short-lived connections.\n\nImplements the AppDatabase class of the domain class diagram.\nTrace: REQ-001, REQ-007, REQ-009\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sqlite3\nfrom contextlib import closing\nfrom pathlib import Path\n\nSCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS categories (\n    id   INTEGER PRIMARY KEY AUTOINCREMENT,\n    name TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE IF NOT EXISTS expenses (\n    id           INTEGER PRIMARY KEY AUTOINCREMENT,\n    amount_cents INTEGER NOT NULL,\n    spent_on     TEXT NOT NULL,\n    category_id  INTEGER NOT NULL REFERENCES categories(id)\n);\n\nCREATE INDEX IF NOT EXISTS idx_expenses_spent_on ON expenses(spent_on);\n\nCREATE TABLE IF NOT EXISTS budgets (\n    id           INTEGER PRIMARY KEY AUTOINCREMENT,\n    category_id  INTEGER NOT NULL UNIQUE REFERENCES categories(id),\n    amount_cents INTEGER NOT NULL\n);\n\"\"\"\n\n\nclass AppDatabase:\n    \"\"\"Owns the SQLite file path and opens one short-lived connection per call.\"\"\"\n\n    def __init__(self, path: str) -> None:\n        self.path = path\n\n    def connect(self) -> sqlite3.Connection:\n        \"\"\"Open a new connection, creating the data directory when missing.\"\"\"\n        parent = Path(self.path).parent\n        if str(parent) and not parent.exists():\n            parent.mkdir(parents=True, exist_ok=True)\n        connection = sqlite3.connect(self.path)\n        connection.row_factory = sqlite3.Row\n        return connection\n\n    def create_schema(self) -> None:\n        \"\"\"Create the tables when the file is new; keep existing data untouched.\"\"\"\n        with closing(self.connect()) as connection:\n            connection.executescript(SCHEMA)\n            connection.commit()\n\n    def execute(self, sql: str, params: tuple = ()) -> int:\n        \"\"\"Run a writing statement and return the new row id (0 when none).\"\"\"\n        with closing(self.connect()) as connection:\n            cursor = connection.execute(sql, params)\n            connection.commit()\n            return int(cursor.lastrowid or 0)\n\n    def fetchall(self, sql: str, params: tuple = ()) -> list[sqlite3.Row]:\n        \"\"\"Run a reading statement and return all rows.\"\"\"\n        with closing(self.connect()) as connection:\n            cursor = connection.execute(sql, params)\n            return list(cursor.fetchall())\n\n\n### expensetracker/dates.py\n\"\"\"Dates: strict YYYY-MM-DD parsing for expense dates.\n\nImplements the Dates utility class of the domain class diagram.\nTrace: REQ-002, REQ-010\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nfrom datetime import date\n\nfrom .errors import ValidationError\n\n_ISO_DATE = re.compile(r\"\\d{4}-\\d{2}-\\d{2}\")\n\n\nclass Dates:\n    \"\"\"Parses the date text typed by the user into a real calendar date.\"\"\"\n\n    @staticmethod\n    def parse_date(text: str) -> date:\n        \"\"\"Return the date, or raise ValidationError(\"date\", ...).\"\"\"\n        if text is None:\n            raise ValidationError(\"date\", \"Date is required.\")\n        raw = str(text).strip()\n        if not raw:\n            raise ValidationError(\"date\", \"Date is required.\")\n        if not _ISO_DATE.fullmatch(raw):\n            raise ValidationError(\"date\", \"Date must be a valid date in YYYY-MM-DD format.\")\n        try:\n            return date.fromisoformat(raw)\n        except ValueError:\n            raise ValidationError(\"date\", \"Date must be a valid date in YYYY-MM-DD format.\") from None\n\n\n### expensetracker/errors.py\n\"\"\"ValidationError: the single error type used for user input problems.\n\nImplements the ValidationError class of the domain class diagram.\nTrace: REQ-002, REQ-004, REQ-010\n\"\"\"\n\nfrom __future__ import annotations\n\n\nclass ValidationError(Exception):\n    \"\"\"A rejected user input, naming the field and the plain-language reason.\"\"\"\n\n    def __init__(self, field: str, message: str) -> None:\n        super().__init__(message)\n        self.field = field\n        self.message = message\n\n\n### expensetracker/__init__.py\n\"\"\"expensetracker: a local, single-user expense tracker served by Python.\n\nPackage root for the classes of the approved design.\nTrace: REQ-001\n\"\"\"\n\n__all__ = [\n    \"app\",\n    \"api\",\n    \"clock\",\n    \"database\",\n    \"dates\",\n    \"errors\",\n    \"models\",\n    \"money\",\n    \"repositories\",\n    \"server\",\n    \"service\",\n]\n\n\n### expensetracker/__main__.py\n\"\"\"Module entry point: ``python -m expensetracker`` starts the tracker server.\n\nImplements the <<entry>> role of App in the domain class diagram.\nTrace: REQ-001\n\"\"\"\n\nfrom .app import App\n\nif __name__ == \"__main__\":\n    App.main()\n\n\n### expensetracker/models.py\n\"\"\"Domain models: Expense, Category, Budget, BudgetLevel, BudgetStatus, MonthlySummary.\n\nImplements the model classes of the domain class diagram.\nTrace: REQ-003, REQ-004, REQ-005, REQ-006, REQ-008\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import date\nfrom enum import Enum\n\nfrom .money import Money\n\n\n@dataclass\nclass Category:\n    \"\"\"A fixed spending category such as Groceries.\"\"\"\n\n    id: int\n    name: str\n\n\n@dataclass\nclass Expense:\n    \"\"\"One recorded expense; the amount is stored as integer cents.\"\"\"\n\n    id: int\n    amount_cents: int\n    spent_on: date\n    category_id: int\n\n    def amount_display(self) -> str:\n        \"\"\"The amount with exactly two decimals, e.g. \"12.50\".\"\"\"\n        return Money.format_cents(self.amount_cents)\n\n\n@dataclass\nclass Budget:\n    \"\"\"The monthly limit of one category, in integer cents.\"\"\"\n\n    id: int\n    category_id: int\n    amount_cents: int\n\n    def amount_display(self) -> str:\n        \"\"\"The budget with exactly two decimals, e.g. \"300.00\".\"\"\"\n        return Money.format_cents(self.amount_cents)\n\n\nclass BudgetLevel(Enum):\n    \"\"\"How far this month's spending has gone against a budget.\"\"\"\n\n    OK = \"OK\"\n    NEAR_LIMIT = \"NEAR_LIMIT\"\n    OVER = \"OVER\"\n\n\n@dataclass\nclass BudgetStatus:\n    \"\"\"Budget usage of one category for one month, with its warning level.\"\"\"\n\n    category_name: str\n    budget_cents: int\n    spent_cents: int\n    level: BudgetLevel\n\n    def percent_used(self) -> float:\n        \"\"\"Share of the budget used this month, in percent, one decimal.\"\"\"\n        if self.budget_cents <= 0:\n            return 0.0\n        return round(self.spent_cents * 100.0 / self.budget_cents, 1)\n\n    def message(self) -> str:\n        \"\"\"A plain-language usage message, e.g. \"Close to the limit: 85% of budget used\".\"\"\"\n        percent = self.percent_used()\n        text = f\"{percent:.0f}\" if float(percent).is_integer() else f\"{percent:.1f}\"\n        if self.level is BudgetLevel.OVER:\n            return f\"Over budget: {text}% used\"\n        if self.level is BudgetLevel.NEAR_LIMIT:\n            return f\"Close to the limit: {text}% of budget used\"\n        return f\"{text}% of budget used\"\n\n    @staticmethod\n    def evaluate(category_name: str, budget_cents: int, spent_cents: int) -> \"BudgetStatus\":\n        \"\"\"Classify spending: OK below 80%, NEAR_LIMIT 80-100%, OVER above 100%.\"\"\"\n        if budget_cents <= 0:\n            level = BudgetLevel.OK\n        else:\n            percent = spent_cents * 100.0 / budget_cents\n            if percent > 100.0:\n                level = BudgetLevel.OVER\n            elif percent >= 80.0:\n                level = BudgetLevel.NEAR_LIMIT\n            else:\n                level = BudgetLevel.OK\n        return BudgetStatus(\n            category_name=category_name,\n            budget_cents=budget_cents,\n            spent_cents=spent_cents,\n            level=level,\n        )\n\n\n@dataclass\nclass MonthlySummary:\n    \"\"\"Total spending of one calendar month, overall and per category.\"\"\"\n\n    month: str\n    total_cents: int\n    by_category: dict = field(default_factory=dict)\n\n    def total_display(self) -> str:\n        \"\"\"The month total with exactly two decimals, e.g. \"100.00\".\"\"\"\n        return Money.format_cents(self.total_cents)\n\n    def category_display(self, category_name: str) -> str:\n        \"\"\"The month total of one category, e.g. \"40.00\"; \"0.00\" when absent.\"\"\"\n        return Money.format_cents(int(self.by_category.get(category_name, 0)))\n\n\n### expensetracker/money.py\n\"\"\"Money: exact parsing and formatting of monetary amounts in integer cents.\n\nImplements the Money utility class of the domain class diagram.\nTrace: REQ-002, REQ-004, REQ-008, REQ-010\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n\nfrom .errors import ValidationError\n\n\nclass Money:\n    \"\"\"Converts between user text and integer cents without float drift.\"\"\"\n\n    @staticmethod\n    def parse_amount(text: str) -> int:\n        \"\"\"Return the amount in cents, or raise ValidationError(\"amount\", ...).\"\"\"\n        if text is None:\n            raise ValidationError(\"amount\", \"Amount is required.\")\n        raw = str(text).strip()\n        if not raw:\n            raise ValidationError(\"amount\", \"Amount is required.\")\n        try:\n            value = Decimal(raw)\n        except (InvalidOperation, ValueError):\n            raise ValidationError(\"amount\", \"Amount must be a number, for example 12.50.\") from None\n        if not value.is_finite():\n            raise ValidationError(\"amount\", \"Amount must be a number, for example 12.50.\")\n        if value <= 0:\n            raise ValidationError(\"amount\", \"Amount must be greater than zero.\")\n        cents = (value * 100).to_integral_value(rounding=ROUND_HALF_UP)\n        return int(cents)\n\n    @staticmethod\n    def format_cents(cents: int) -> str:\n        \"\"\"Format integer cents with exactly two decimals, e.g. 1250 -> \"12.50\".\"\"\"\n        value = int(cents)\n        sign = \"-\" if value < 0 else \"\"\n        value = abs(value)\n        return f\"{sign}{value // 100}.{value % 100:02d}\"\n\n\n### expensetracker/repositories.py\n\"\"\"SQLite repositories: ExpenseRepository, BudgetRepository, CategoryRepository.\n\nImplements the three repository classes of the domain class diagram.\nTrace: REQ-003, REQ-004, REQ-005, REQ-006, REQ-007, REQ-009\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nfrom .database import AppDatabase\nfrom .models import Budget, Category, Expense\n\nDEFAULT_CATEGORIES: tuple[str, ...] = (\n    \"Groceries\",\n    \"Rent\",\n    \"Transport\",\n    \"Utilities\",\n    \"Entertainment\",\n    \"Health\",\n    \"Other\",\n)\n\n\nclass ExpenseRepository:\n    \"\"\"Reads and writes the expenses table.\"\"\"\n\n    def __init__(self, db: AppDatabase) -> None:\n        self._db = db\n\n    def insert(self, expense: Expense) -> int:\n        \"\"\"Store one expense and return its new id.\"\"\"\n        return self._db.execute(\n            \"INSERT INTO expenses (amount_cents, spent_on, category_id) VALUES (?, ?, ?)\",\n            (expense.amount_cents, expense.spent_on.isoformat(), expense.category_id),\n        )\n\n    def list_newest_first(self) -> list[Expense]:\n        \"\"\"All expenses ordered by date from newest to oldest.\"\"\"\n        rows = self._db.fetchall(\n            \"SELECT id, amount_cents, spent_on, category_id FROM expenses \"\n            \"ORDER BY spent_on DESC, id DESC\"\n        )\n        return [\n            Expense(\n                id=int(row[\"id\"]),\n                amount_cents=int(row[\"amount_cents\"]),\n                spent_on=date.fromisoformat(str(row[\"spent_on\"])),\n                category_id=int(row[\"category_id\"]),\n            )\n            for row in rows\n        ]\n\n    def sum_by_category(self, year: int, month: int) -> dict[int, int]:\n        \"\"\"Spent cents per category_id for the given calendar month.\"\"\"\n        start = date(year, month, 1)\n        end = date(year + 1, 1, 1) if month == 12 else date(year, month + 1, 1)\n        rows = self._db.fetchall(\n            \"SELECT category_id, SUM(amount_cents) AS total FROM expenses \"\n            \"WHERE spent_on >= ? AND spent_on < ? GROUP BY category_id\",\n            (start.isoformat(), end.isoformat()),\n        )\n        return {int(row[\"category_id\"]): int(row[\"total\"]) for row in rows}\n\n\nclass BudgetRepository:\n    \"\"\"Reads and writes the one-budget-per-category table.\"\"\"\n\n    def __init__(self, db: AppDatabase) -> None:\n        self._db = db\n\n    def upsert(self, category_id: int, amount_cents: int) -> Budget:\n        \"\"\"Insert the budget of a category or replace its amount.\"\"\"\n        existing = self.find_by_category(category_id)\n        if existing is None:\n            new_id = self._db.execute(\n                \"INSERT INTO budgets (category_id, amount_cents) VALUES (?, ?)\",\n                (category_id, amount_cents),\n            )\n            return Budget(id=new_id, category_id=category_id, amount_cents=amount_cents)\n        self._db.execute(\n            \"UPDATE budgets SET amount_cents = ? WHERE id = ?\",\n            (amount_cents, existing.id),\n        )\n        return Budget(id=existing.id, category_id=category_id, amount_cents=amount_cents)\n\n    def find_by_category(self, category_id: int) -> Budget | None:\n        \"\"\"The budget of one category, or None when it has none.\"\"\"\n        rows = self._db.fetchall(\n            \"SELECT id, category_id, amount_cents FROM budgets WHERE category_id = ?\",\n            (category_id,),\n        )\n        if not rows:\n            return None\n        row = rows[0]\n        return Budget(\n            id=int(row[\"id\"]),\n            category_id=int(row[\"category_id\"]),\n            amount_cents=int(row[\"amount_cents\"]),\n        )\n\n    def list_all(self) -> list[Budget]:\n        \"\"\"Every stored budget, ordered by category.\"\"\"\n        rows = self._db.fetchall(\n            \"SELECT id, category_id, amount_cents FROM budgets ORDER BY category_id\"\n        )\n        return [\n            Budget(\n                id=int(row[\"id\"]),\n                category_id=int(row[\"category_id\"]),\n                amount_cents=int(row[\"amount_cents\"]),\n            )\n            for row in rows\n        ]\n\n\nclass CategoryRepository:\n    \"\"\"Reads the fixed category list and seeds it on first run.\"\"\"\n\n    def __init__(self, db: AppDatabase) -> None:\n        self._db = db\n\n    def list_all(self) -> list[Category]:\n        \"\"\"All categories in seed order.\"\"\"\n        rows = self._db.fetchall(\"SELECT id, name FROM categories ORDER BY id\")\n        return [Category(id=int(row[\"id\"]), name=str(row[\"name\"])) for row in rows]\n\n    def find_by_name(self, name: str) -> Category | None:\n        \"\"\"The category with this name (case-insensitive), or None.\"\"\"\n        rows = self._db.fetchall(\n            \"SELECT id, name FROM categories WHERE name = ? COLLATE NOCASE\",\n            (name,),\n        )\n        if not rows:\n            return None\n        row = rows[0]\n        return Category(id=int(row[\"id\"]), name=str(row[\"name\"]))\n\n    def seed_defaults(self) -> None:\n        \"\"\"Insert the seven fixed categories only when the table is empty.\"\"\"\n        if self.list_all():\n            return\n        for name in DEFAULT_CATEGORIES:\n            self._db.execute(\"INSERT INTO categories (name) VALUES (?)\", (name,))\n\n\n### expensetracker/server.py\n\"\"\"TrackerServer: the single-threaded local HTTP server.\n\nImplements the TrackerServer class of the domain class diagram and the\n\"Startup and storage\" sequence diagram.\nTrace: REQ-001\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\n\nclass TrackerServer:\n    \"\"\"Binds 127.0.0.1 and serves the tracker page and its JSON API.\"\"\"\n\n    def __init__(self, port: int, handler: type[BaseHTTPRequestHandler]) -> None:\n        self.port = port\n        self._httpd = HTTPServer((\"127.0.0.1\", port), handler)\n\n    def serve_forever(self) -> None:\n        \"\"\"Serve requests until the process is interrupted or shut down.\"\"\"\n        self._httpd.serve_forever()\n\n    def _bound_port(self) -> int:\n        \"\"\"The port actually in use (the OS picks one when 0 was requested).\"\"\"\n        return int(self._httpd.server_address[1])\n\n    def _shutdown(self) -> None:\n        \"\"\"Stop serving and release the socket.\"\"\"\n        self._httpd.shutdown()\n        self._httpd.server_close()\n\n\n### expensetracker/service.py\n\"\"\"ExpenseTrackerService: the use cases behind the JSON API.\n\nImplements the ExpenseTrackerService class of the domain class diagram and the\ncall order of the \"Log expense\", \"Set budget\", \"Budget overview\" and\n\"Monthly summary\" sequence diagrams.\nTrace: REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-008, REQ-010\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\n\nfrom .clock import Clock\nfrom .dates import Dates\nfrom .errors import ValidationError\nfrom .models import Budget, BudgetStatus, Category, Expense, MonthlySummary\nfrom .money import Money\nfrom .repositories import BudgetRepository, CategoryRepository, ExpenseRepository\n\n\ndef _split_month(month: str) -> tuple[int, int]:\n    \"\"\"Turn \"2026-05\" into (2026, 5).\"\"\"\n    try:\n        parsed = datetime.strptime(str(month), \"%Y-%m\")\n    except (TypeError, ValueError):\n        raise ValueError(f\"Invalid month {month!r}, expected YYYY-MM\") from None\n    return parsed.year, parsed.month\n\n\nclass ExpenseTrackerService:\n    \"\"\"Coordinates validation, repositories and the computed views.\"\"\"\n\n    def __init__(\n        self,\n        expenses: ExpenseRepository,\n        budgets: BudgetRepository,\n        categories: CategoryRepository,\n        clock: Clock,\n    ) -> None:\n        self._expenses = expenses\n        self._budgets = budgets\n        self._categories = categories\n        self._clock = clock\n\n    def add_expense(self, amount_text: str, date_text: str, category_name: str) -> Expense:\n        \"\"\"Validate the input, store the expense and return it with its new id.\"\"\"\n        amount_cents = Money.parse_amount(amount_text)\n        spent_on = Dates.parse_date(date_text)\n        category = self._require_category(category_name)\n        new_id = self._expenses.insert(\n            Expense(\n                id=0,\n                amount_cents=amount_cents,\n                spent_on=spent_on,\n                category_id=category.id,\n            )\n        )\n        return Expense(\n            id=new_id,\n            amount_cents=amount_cents,\n            spent_on=spent_on,\n            category_id=category.id,\n        )\n\n    def list_expenses(self) -> list[Expense]:\n        \"\"\"All recorded expenses, newest first.\"\"\"\n        return self._expenses.list_newest_first()\n\n    def set_budget(self, category_name: str, amount_text: str) -> Budget:\n        \"\"\"Validate the amount and store or update the category budget.\"\"\"\n        amount_cents = Money.parse_amount(amount_text)\n        category = self._require_category(category_name)\n        return self._budgets.upsert(category.id, amount_cents)\n\n    def budget_overview(self, month: str | None = None) -> list[BudgetStatus]:\n        \"\"\"Budget usage and warning level per budgeted category for one month.\"\"\"\n        target = month or self._clock.current_month()\n        year, month_number = _split_month(target)\n        spent = self._expenses.sum_by_category(year, month_number)\n        names = {category.id: category.name for category in self._categories.list_all()}\n        statuses: list[BudgetStatus] = []\n        for budget in self._budgets.list_all():\n            name = names.get(budget.category_id, \"Unknown\")\n            statuses.append(\n                BudgetStatus.evaluate(name, budget.amount_cents, spent.get(budget.category_id, 0))\n            )\n        return statuses\n\n    def monthly_summary(self, month: str | None = None) -> MonthlySummary:\n        \"\"\"Total and per-category spending of one calendar month.\"\"\"\n        target = month or self._clock.current_month()\n        year, month_number = _split_month(target)\n        spent = self._expenses.sum_by_category(year, month_number)\n        by_category: dict[str, int] = {}\n        total_cents = 0\n        for category in self._categories.list_all():\n            cents = spent.get(category.id, 0)\n            total_cents += cents\n            if cents:\n                by_category[category.name] = cents\n        return MonthlySummary(month=target, total_cents=total_cents, by_category=by_category)\n\n    def list_categories(self) -> list[Category]:\n        \"\"\"The fixed category list, in seed order.\"\"\"\n        return self._categories.list_all()\n\n    def _require_category(self, category_name: str) -> Category:\n        \"\"\"Resolve a category name to its row, or raise ValidationError(\"category\", ...).\"\"\"\n        text = \"\" if category_name is None else str(category_name).strip()\n        if not text:\n            raise ValidationError(\"category\", \"Category is required.\")\n        category = self._categories.find_by_name(text)\n        if category is None:\n            raise ValidationError(\"category\", f\"Unknown category {text!r}.\")\n        return category\n\n\n### expensetracker/static/app.js\n/*\n * TrackerPage: the browser view that talks to the local JSON API.\n * Implements the TrackerPage class of the domain class diagram and the\n * renderer calls of the \"Log expense\", \"Budget overview\" and \"Monthly summary\"\n * sequence diagrams.\n * Trace: REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-008, REQ-010\n */\n\nclass TrackerPage {\n  constructor() {\n    this.expenseForm = document.getElementById(\"expense-form\");\n    this.budgetForm = document.getElementById(\"budget-form\");\n    this.expenseRows = document.getElementById(\"expense-rows\");\n    this.expenseEmpty = document.getElementById(\"expense-empty\");\n    this.budgetRows = document.getElementById(\"budget-rows\");\n    this.budgetEmpty = document.getElementById(\"budget-empty\");\n    this.summaryTotal = document.getElementById(\"summary-total\");\n    this.summaryMonth = document.getElementById(\"summary-month\");\n    this.summaryCategories = document.getElementById(\"summary-categories\");\n    this.message = document.getElementById(\"message\");\n    this.categoryOptions = document.getElementById(\"expense-category\");\n    this.budgetCategoryOptions = document.getElementById(\"budget-category\");\n    this.dateInput = document.getElementById(\"expense-date\");\n  }\n\n  /** POST/GET JSON against the local server; resolves to {status, data}. */\n  async callApi(method, path, body) {\n    const options = { method: method, headers: {} };\n    if (body !== undefined && body !== null) {\n      options.headers[\"Content-Type\"] = \"application/json\";\n      options.body = JSON.stringify(body);\n    }\n    const response = await fetch(path, options);\n    let data = {};\n    try {\n      data = await response.json();\n    } catch (error) {\n      data = { message: \"The server sent an unexpected response.\" };\n    }\n    return { status: response.status, data: data };\n  }\n\n  /** Replace the expense table body with the given expenses (newest first). */\n  renderExpenses(expenses) {\n    this.expenseRows.replaceChildren();\n    if (!expenses || expenses.length === 0) {\n      this.expenseEmpty.hidden = false;\n      return;\n    }\n    this.expenseEmpty.hidden = true;\n    for (const expense of expenses) {\n      this.expenseRows.appendChild(this.buildRow(expense));\n    }\n  }\n\n  /** Insert one saved expense at its date position without refetching the list. */\n  insertRow(expense) {\n    this.expenseEmpty.hidden = true;\n    const row = this.buildRow(expense);\n    const rows = Array.from(this.expenseRows.querySelectorAll(\"tr\"));\n    const after = rows.find(function (existing) {\n      const date = existing.dataset.date || \"\";\n      if (date < expense.date) return true;\n      if (date > expense.date) return false;\n      return Number(existing.dataset.id || 0) < Number(expense.id || 0);\n    });\n    if (after) {\n      this.expenseRows.insertBefore(row, after);\n    } else {\n      this.expenseRows.appendChild(row);\n    }\n  }\n\n  buildRow(expense) {\n    const row = document.createElement(\"tr\");\n    row.dataset.date = expense.date;\n    row.dataset.id = expense.id;\n    for (const value of [expense.date, expense.category, expense.amount_display]) {\n      const cell = document.createElement(\"td\");\n      cell.textContent = value;\n      row.appendChild(cell);\n    }\n    const amountCell = row.lastElementChild;\n    amountCell.className = \"amount\";\n    return row;\n  }\n\n  /** Render each budgeted category with its usage and warning state. */\n  renderBudgets(statuses) {\n    this.budgetRows.replaceChildren();\n    if (!statuses || statuses.length === 0) {\n      this.budgetEmpty.hidden = false;\n      return;\n    }\n    this.budgetEmpty.hidden = true;\n    for (const status of statuses) {\n      const row = document.createElement(\"tr\");\n      row.dataset.category = status.category;\n      row.className = \"level-\" + String(status.level).toLowerCase();\n\n      const name = document.createElement(\"td\");\n      name.textContent = status.category;\n\n      const budget = document.createElement(\"td\");\n      budget.className = \"amount\";\n      budget.textContent = status.budget_display;\n\n      const spent = document.createElement(\"td\");\n      spent.className = \"amount\";\n      spent.textContent = status.spent_display;\n\n      const note = document.createElement(\"td\");\n      note.className = \"budget-message\";\n      note.textContent = status.message;\n      if (status.level !== \"OK\") {\n        const badge = document.createElement(\"span\");\n        badge.className = \"badge\";\n        badge.textContent = status.level === \"OVER\" ? \"Over budget\" : \"Close to limit\";\n        note.prepend(badge);\n      }\n\n      row.append(name, budget, spent, note);\n      this.budgetRows.appendChild(row);\n    }\n  }\n\n  /** Render the current month total and its per-category breakdown. */\n  renderSummary(summary) {\n    this.summaryMonth.textContent = summary.month || \"\";\n    this.summaryTotal.textContent = summary.total_display || \"0.00\";\n    this.summaryCategories.replaceChildren();\n    const categories = summary.categories || [];\n    if (categories.length === 0) {\n      const item = document.createElement(\"li\");\n      item.className = \"empty\";\n      item.textContent = \"No spending recorded this month yet.\";\n      this.summaryCategories.appendChild(item);\n      return;\n    }\n    for (const category of categories) {\n      const item = document.createElement(\"li\");\n      const name = document.createElement(\"span\");\n      name.textContent = category.name;\n      const value = document.createElement(\"span\");\n      value.className = \"amount\";\n      value.textContent = category.total_display;\n      item.append(name, value);\n      this.summaryCategories.appendChild(item);\n    }\n  }\n\n  /** Show a plain-language confirmation or validation message. */\n  showMessage(text, isError) {\n    this.message.textContent = text || \"\";\n    this.message.hidden = !text;\n    this.message.className = isError ? \"message error\" : \"message success\";\n    this.message.setAttribute(\"role\", isError ? \"alert\" : \"status\");\n  }\n\n  async loadCategories() {\n    const result = await this.callApi(\"GET\", \"/api/categories\");\n    const categories = (result.data && result.data.categories) || [];\n    for (const select of [this.categoryOptions, this.budgetCategoryOptions]) {\n      select.replaceChildren();\n      for (const category of categories) {\n        const option = document.createElement(\"option\");\n        option.value = category.name;\n        option.textContent = category.name;\n        select.appendChild(option);\n      }\n    }\n  }\n\n  async loadExpenses() {\n    const result = await this.callApi(\"GET\", \"/api/expenses\");\n    this.renderExpenses((result.data && result.data.expenses) || []);\n  }\n\n  async loadBudgets() {\n    const result = await this.callApi(\"GET\", \"/api/budgets\");\n    this.renderBudgets((result.data && result.data.budgets) || []);\n  }\n\n  async loadSummary() {\n    const result = await this.callApi(\"GET\", \"/api/summary\");\n    this.renderSummary(result.data || {});\n  }\n\n  fieldLabel(field) {\n    const labels = {\n      amount: \"Amount\",\n      date: \"Date\",\n      category: \"Category\",\n      body: \"Request\",\n    };\n    return labels[field] || \"Input\";\n  }\n\n  async submitExpense(event) {\n    event.preventDefault();\n    const amount = document.getElementById(\"expense-amount\").value;\n    const date = this.dateInput.value;\n    const category = this.categoryOptions.value;\n    const result = await this.callApi(\"POST\", \"/api/expenses\", {\n      amount: amount,\n      date: date,\n      category: category,\n    });\n    if (result.status === 201) {\n      this.insertRow(result.data);\n      document.getElementById(\"expense-amount\").value = \"\";\n      this.showMessage(\"Expense saved.\", false);\n      await this.loadSummary();\n      await this.loadBudgets();\n      return;\n    }\n    const field = result.data.field || \"amount\";\n    const reason = result.data.message || \"The expense could not be saved.\";\n    this.showMessage(this.fieldLabel(field) + \": \" + reason, true);\n  }\n\n  async submitBudget(event) {\n    event.preventDefault();\n    const amount = document.getElementById(\"budget-amount\").value;\n    const category = this.budgetCategoryOptions.value;\n    const result = await this.callApi(\"POST\", \"/api/budgets\", {\n      category: category,\n      amount: amount,\n    });\n    if (result.status === 200) {\n      document.getElementById(\"budget-amount\").value = \"\";\n      this.showMessage(\"Budget saved.\", false);\n      await this.loadBudgets();\n      await this.loadSummary();\n      return;\n    }\n    const field = result.data.field || \"amount\";\n    const reason = result.data.message || \"The budget could not be saved.\";\n    this.showMessage(this.fieldLabel(field) + \": \" + reason, true);\n  }\n\n  async init() {\n    this.dateInput.value = new Date().toISOString().slice(0, 10);\n    this.expenseForm.addEventListener(\"submit\", (event) => this.submitExpense(event));\n    this.budgetForm.addEventListener(\"submit\", (event) => this.submitBudget(event));\n    try {\n      await this.loadCategories();\n      await this.loadExpenses();\n      await this.loadBudgets();\n      await this.loadSummary();\n    } catch (error) {\n      this.showMessage(\"Could not reach the local expense tracker server.\", true);\n    }\n  }\n}\n\nwindow.addEventListener(\"DOMContentLoaded\", function () {\n  const page = new TrackerPage();\n  page.init();\n});\n\n\n### expensetracker/static/index.html\n<!DOCTYPE html>\n<!--\n  The tracker page served by the local server.\n  Implements the TrackerPage view of the domain class diagram.\n  Trace: REQ-001, REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-010\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Expense Tracker</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <header class=\"page-header\">\n    <h1>Expense Tracker</h1>\n    <p id=\"message\" class=\"message\" role=\"status\" hidden></p>\n  </header>\n\n  <main>\n    <section class=\"card\" aria-labelledby=\"expense-heading\">\n      <h2 id=\"expense-heading\">Log an expense</h2>\n      <form id=\"expense-form\" novalidate>\n        <div class=\"field\">\n          <label for=\"expense-amount\">Amount</label>\n          <input id=\"expense-amount\" name=\"amount\" type=\"text\" inputmode=\"decimal\"\n                 placeholder=\"12.50\" autocomplete=\"off\" required>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-date\">Date (YYYY-MM-DD)</label>\n          <input id=\"expense-date\" name=\"date\" type=\"text\" placeholder=\"2026-05-03\"\n                 autocomplete=\"off\" required>\n        </div>\n        <div class=\"field\">\n          <label for=\"expense-category\">Category</label>\n          <select id=\"expense-category\" name=\"category\" required></select>\n        </div>\n        <button type=\"submit\">Save expense</button>\n      </form>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"list-heading\">\n      <h2 id=\"list-heading\">Expenses</h2>\n      <table class=\"data-table\">\n        <caption class=\"visually-hidden\">Recorded expenses, newest first</caption>\n        <thead>\n          <tr>\n            <th scope=\"col\">Date</th>\n            <th scope=\"col\">Category</th>\n            <th scope=\"col\" class=\"amount\">Amount</th>\n          </tr>\n        </thead>\n        <tbody id=\"expense-rows\"></tbody>\n      </table>\n      <p id=\"expense-empty\" class=\"empty\">No expenses recorded yet. Log your first expense above.</p>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"summary-heading\">\n      <h2 id=\"summary-heading\">This month</h2>\n      <p class=\"summary-total\">\n        Total spent <span id=\"summary-month\" class=\"muted\"></span>:\n        <strong id=\"summary-total\">0.00</strong>\n      </p>\n      <ul id=\"summary-categories\" class=\"summary-list\"></ul>\n    </section>\n\n    <section class=\"card\" aria-labelledby=\"budget-heading\">\n      <h2 id=\"budget-heading\">Monthly budgets</h2>\n      <form id=\"budget-form\" novalidate>\n        <div class=\"field\">\n          <label for=\"budget-category\">Category</label>\n          <select id=\"budget-category\" name=\"budget-category\" required></select>\n        </div>\n        <div class=\"field\">\n          <label for=\"budget-amount\">Monthly budget amount</label>\n          <input id=\"budget-amount\" name=\"budget-amount\" type=\"text\" inputmode=\"decimal\"\n                 placeholder=\"300.00\" autocomplete=\"off\" required>\n        </div>\n        <button type=\"submit\">Save budget</button>\n      </form>\n      <table class=\"data-table\">\n        <caption class=\"visually-hidden\">Budget usage per category for this month</caption>\n        <thead>\n          <tr>\n            <th scope=\"col\">Category</th>\n            <th scope=\"col\" class=\"amount\">Budget</th>\n            <th scope=\"col\" class=\"amount\">Spent</th>\n            <th scope=\"col\">Status</th>\n          </tr>\n        </thead>\n        <tbody id=\"budget-rows\"></tbody>\n      </table>\n      <p id=\"budget-empty\" class=\"empty\">No budgets set yet. Set a monthly budget above.</p>\n    </section>\n  </main>\n\n  <script src=\"/app.js\"></script>\n</body>\n</html>\n\n\n### expensetracker/static/style.css\n/*\n * Styles for the tracker page.\n * Implements the presentation of the TrackerPage view.\n * Trace: REQ-005, REQ-010\n */\n\n:root {\n  --ink: #1d2433;\n  --muted: #65708a;\n  --line: #dfe3ec;\n  --ok: #2f7d4f;\n  --near: #a86a00;\n  --over: #b3261e;\n  --accent: #2c5fa8;\n  --bg: #f5f6fa;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 0 0 3rem;\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  color: var(--ink);\n  background: var(--b