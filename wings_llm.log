          "function": {
            "name": "check_python",
            "arguments": "{\"path\": \"tests/test_budgets.py\", \"source\": \"\\\"\\\"\\\"Budgets per category and their near-limit/over-limit warnings (REQ-004, REQ-005).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport pytest\\n\\nfrom expensetracker.errors import ValidationError\\nfrom expensetracker.models import BudgetLevel\\n\\n\\ndef _status(service, category_name):\\n    matches = [item for item in service.budget_overview() if item.category_name == category_name]\\n    assert len(matches) == 1, f\\\"expected exactly one budget row for {category_name}\\\"\\n    return matches[0]\\n\\n\\ndef _spend(service, amount, category=\\\"Groceries\\\", day=3):\\n    return service.add_expense(amount, \\\"2026-05-%02d\\\" % day, category)\\n\\n\\ndef test_req_004_set_budget_is_stored_and_shown(service):\\n    budget = service.set_budget(\\\"Groceries\\\", \\\"300.00\\\")\\n    assert budget.amount_cents == 30000\\n    assert budget.amount_display() == \\\"300.00\\\"\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.budget_cents == 30000\\n    assert status.spent_cents == 0\\n\\n\\ndef test_req_004_update_replaces_the_previous_budget(service, repositories):\\n    first = service.set_budget(\\\"Groceries\\\", \\\"300.00\\\")\\n    second = service.set_budget(\\\"Groceries\\\", \\\"350.00\\\")\\n\\n    assert second.id == first.id\\n    assert second.amount_cents == 35000\\n    assert second.amount_display() == \\\"350.00\\\"\\n    assert [budget.amount_cents for budget in repositories.budgets.list_all()] == [35000]\\n    assert _status(service, \\\"Groceries\\\").budget_cents == 35000\\n\\n\\n@pytest.mark.parametrize(\\\"amount\\\", [None, \\\"\\\", \\\"abc\\\", \\\"-1.00\\\", \\\"0\\\"])\\ndef test_req_004_invalid_budget_saves_nothing(service, repositories, amount):\\n    with pytest.raises(ValidationError) as info:\\n        service.set_budget(\\\"Groceries\\\", amount)\\n    assert info.value.field == \\\"amount\\\"\\n    assert info.value.message\\n    assert repositories.budgets.list_all() == []\\n    assert service.budget_overview() == []\\n\\n\\ndef test_req_004_unknown_category_saves_nothing(service):\\n    with pytest.raises(ValidationError) as info:\\n        service.set_budget(\\\"Spaceships\\\", \\\"100.00\\\")\\n    assert info.value.field == \\\"category\\\"\\n    assert service.budget_overview() == []\\n\\n\\ndef test_req_005_near_limit_at_85_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"85.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.NEAR_LIMIT\\n    assert status.spent_cents == 8500\\n    assert status.percent_used() == 85.0\\n    assert \\\"85\\\" in status.message()\\n    assert \\\"close\\\" in status.message().lower()\\n\\n\\ndef test_req_005_over_budget_above_100_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"120.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.OVER\\n    assert status.spent_cents == 12000\\n    assert status.percent_used() == 120.0\\n    assert \\\"over budget\\\" in status.message().lower()\\n\\n\\ndef test_req_005_no_warning_below_80_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"40.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.OK\\n    assert status.percent_used() == 40.0\\n    assert \\\"close\\\" not in status.message().lower()\\n    assert \\\"over\\\" not in status.message().lower()\\n\\n\\n@pytest.mark.parametrize(\\n    \\\"spent,level\\\",\\n    [\\n        (\\\"79.99\\\", BudgetLevel.OK),\\n        (\\\"80.00\\\", BudgetLevel.NEAR_LIMIT),\\n        (\\\"100.00\\\", BudgetLevel.NEAR_LIMIT),\\n        (\\\"100.01\\\", BudgetLevel.OVER),\\n    ],\\n)\\ndef test_req_005_warning_level_boundaries(service, spent, level):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, spent)\\n    assert _status(service, \\\"Groceries\\\").level is level\\n\\n\\ndef test_req_005_only_current_month_counts_against_budget(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    service.add_expense(\\\"95.00\\\", \\\"2026-04-15\\\", \\\"Groceries\\\")\\n    _spend(service, \\\"10.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.spent_cents == 1000\\n    assert status.level is BudgetLevel.OK\\n\"}"
