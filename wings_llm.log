{"notes": "Tests cover the service, repositories, JSON API and the Python tracker page via a real server on a free port, plus a subprocess restart test for persistence. Open point: the browser-side app.js behaviour (values kept in the form after an error, DOM re-rendering) is not exercised.", "files": [{"path": "tests/conftest.py", "purpose": "Shared fixtures: temp SQLite file, pinned Clock (2026-05), service, free-port server and JSON client.", "covers": ["REQ-001", "REQ-007"], "content": "\"\"\"Shared pytest fixtures for the local expense tracker.\n\nEvery test gets a fresh SQLite file in ``tmp_path`` and a service whose Clock is\npinned to 2026-05-15; API tests additionally get a real server on a free port.\nTrace: REQ-001, REQ-007\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport threading\nfrom contextlib import contextmanager\nfrom datetime import date\nfrom types import SimpleNamespace\nfrom urllib.error import HTTPError\nfrom urllib.request import Request, urlopen\n\nimport pytest\n\nfrom expensetracker.api import ApiHandler\nfrom expensetracker.clock import Clock\nfrom expensetracker.database import AppDatabase\nfrom expensetracker.repositories import (\n    BudgetRepository,\n    CategoryRepository,\n    ExpenseRepository,\n)\nfrom expensetracker.server import TrackerServer\nfrom expensetracker.service import ExpenseTrackerService\n\n\nclass FixedClock(Clock):\n    \"\"\"Clock pinned to 2026-05-15 so month filters are deterministic.\"\"\"\n\n    def __init__(self, day: date = date(2026, 5, 15)) -> None:\n        self._day = day\n\n    def today(self) -> date:\n        return self._day\n\n    def current_month(self) -> str:\n        return self._day.strftime(\"%Y-%m\")\n\n\ndef build_service(path, clock=None):\n    \"\"\"Create the schema, seed the categories and wire a service for one file.\"\"\"\n    database = AppDatabase(str(path))\n    database.create_schema()\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    service = ExpenseTrackerService(\n        ExpenseRepository(database),\n        BudgetRepository(database),\n        categories,\n        clock if clock is not None else FixedClock(),\n    )\n    return database, service\n\n\n@contextmanager\ndef running_server(service):\n    \"\"\"Serve the JSON API on a free local port for the duration of the block.\"\"\"\n    server = TrackerServer(port=0, handler=ApiHandler(service))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        yield \"http://127.0.0.1:%d\" % server._bound_port()\n    finally:\n        server._shutdown()\n        thread.join(timeout=5)\n\n\nclass ApiClient:\n    \"\"\"Tiny JSON-over-HTTP client used by the API and page tests.\"\"\"\n\n    def __init__(self, base_url: str) -> None:\n        self.base_url = base_url.rstrip(\"/\")\n\n    def get(self, path: str):\n        with urlopen(self.base_url + path, timeout=10) as response:\n            return response.status, json.loads(response.read().decode(\"utf-8\") or \"{}\")\n\n    def post(self, path: str, payload: dict):\n        return self.post_raw(path, json.dumps(payload))\n\n    def post_raw(self, path: str, text: str):\n        request = Request(\n            self.base_url + path,\n            data=text.encode(\"utf-8\"),\n            headers={\"Content-Type\": \"application/json\"},\n            method=\"POST\",\n        )\n        try:\n            with urlopen(request, timeout=10) as response:\n                return response.status, json.loads(response.read().decode(\"utf-8\") or \"{}\")\n        except HTTPError as error:\n            return error.code, json.loads(error.read().decode(\"utf-8\") or \"{}\")\n\n    def raw(self, path: str):\n        try:\n            with urlopen(self.base_url + path, timeout=10) as response:\n                return (\n                    response.status,\n                    response.headers.get(\"Content-Type\", \"\"),\n                    response.read(),\n                )\n        except HTTPError as error:\n            return error.code, error.headers.get(\"Content-Type\", \"\"), error.read()\n\n\n@pytest.fixture\ndef database(tmp_path):\n    db = AppDatabase(str(tmp_path / \"data\" / \"expense_tracker.db\"))\n    db.create_schema()\n    return db\n\n\n@pytest.fixture\ndef repositories(database):\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    return SimpleNamespace(\n        expenses=ExpenseRepository(database),\n        budgets=BudgetRepository(database),\n        categories=categories,\n    )\n\n\n@pytest.fixture\ndef service(repositories):\n    return ExpenseTrackerService(\n        repositories.expenses,\n        repositories.budgets,\n        repositories.categories,\n        FixedClock(),\n    )\n\n\n@pytest.fixture\ndef live_server(service):\n    with running_server(service) as base_url:\n        yield base_url\n\n\n@pytest.fixture\ndef api(live_server):\n    return ApiClient(live_server)\n\n\n@pytest.fixture\ndef client_factory():\n    return ApiClient\n\n\n@pytest.fixture\ndef service_builder():\n    return build_service\n\n\n@pytest.fixture\ndef server_runner():\n    return running_server\n"}, {"path": "tests/test_money_dates.py", "purpose": "Money.parse_amount / format_cents and Dates.parse_date validation messages and exact cents (REQ-002, REQ-008, REQ-010).", "covers": ["REQ-002", "REQ-008", "REQ-010"], "content": "\"\"\"Exact money parsing/formatting and strict date parsing (REQ-002, REQ-008, REQ-010).\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nimport pytest\n\nfrom expensetracker.dates import Dates\nfrom expensetracker.errors import ValidationError\nfrom expensetracker.money import Money\n\n\ndef test_req_002_parse_amount_returns_cents():\n    assert Money.parse_amount(\"12.50\") == 1250\n    assert Money.parse_amount(\"0.01\") == 1\n    assert Money.parse_amount(\" 7 \") == 700\n    assert Money.parse_amount(\"100\") == 10000\n\n\n@pytest.mark.parametrize(\"text\", [None, \"\", \"   \"])\ndef test_req_002_parse_amount_rejects_missing_amount(text):\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount(text)\n    assert info.value.field == \"amount\"\n    assert info.value.message\n    assert \"required\" in info.value.message.lower()\n\n\n@pytest.mark.parametrize(\"text\", [\"abc\", \"12,50\", \"1.2.3\", \"ten\", \"NaN\", \"Infinity\"])\ndef test_req_002_parse_amount_rejects_non_numeric(text):\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount(text)\n    assert info.value.field == \"amount\"\n    assert \"number\" in info.value.message.lower()\n\n\n@pytest.mark.parametrize(\"text\", [\"0\", \"0.00\", \"-1\", \"-0.01\"])\ndef test_req_002_parse_amount_rejects_non_positive(text):\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount(text)\n    assert info.value.field == \"amount\"\n    assert \"greater than zero\" in info.value.message.lower()\n\n\ndef test_req_002_parse_date_accepts_valid_calendar_dates():\n    assert Dates.parse_date(\"2026-05-03\") == date(2026, 5, 3)\n    assert Dates.parse_date(\" 2026-05-31 \") == date(2026, 5, 31)\n    assert Dates.parse_date(\"2024-02-29\") == date(2024, 2, 29)\n\n\n@pytest.mark.parametrize(\n    \"text\",\n    [None, \"\", \"2026-02-30\", \"2026-13-01\", \"2025-02-29\", \"03/05/2026\", \"2026-05-3\", \"tomorrow\"],\n)\ndef test_req_002_parse_date_rejects_invalid_calendar_dates(text):\n    with pytest.raises(ValidationError) as info:\n        Dates.parse_date(text)\n    assert info.value.field == \"date\"\n    assert info.value.message\n\n\ndef test_req_008_format_cents_always_two_decimals():\n    assert Money.format_cents(1250) == \"12.50\"\n    assert Money.format_cents(5) == \"0.05\"\n    assert Money.format_cents(10000) == \"100.00\"\n    assert Money.format_cents(0) == \"0.00\"\n\n\ndef test_req_008_dimes_add_without_float_drift():\n    total = Money.parse_amount(\"0.10\") + Money.parse_amount(\"0.20\")\n    assert total == 30\n    assert isinstance(total, int)\n    assert Money.format_cents(total) == \"0.30\"\n\n\ndef test_req_010_validation_error_carries_field_and_plain_message():\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount(\"abc\")\n    error = info.value\n    assert error.field == \"amount\"\n    assert error.message == str(error)\n    assert \"Traceback\" not in error.message\n"}, {"path": "tests/test_service_expenses.py", "purpose": "Logging and listing expenses through ExpenseTrackerService, including integer-cent storage (REQ-002, REQ-003, REQ-008).", "covers": ["REQ-002", "REQ-003", "REQ-008"], "content": "\"\"\"Logging and listing expenses through the service (REQ-002, REQ-003, REQ-008).\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nimport pytest\n\nfrom expensetracker.errors import ValidationError\n\n\ndef test_req_002_add_expense_is_saved_and_listed(service):\n    expense = service.add_expense(\"12.50\", \"2026-05-03\", \"Groceries\")\n    assert expense.id > 0\n    assert expense.amount_cents == 1250\n    assert expense.spent_on == date(2026, 5, 3)\n    assert expense.amount_display() == \"12.50\"\n\n    listed = service.list_expenses()\n    assert len(listed) == 1\n    assert listed[0].id == expense.id\n    assert listed[0].amount_cents == 1250\n    assert listed[0].spent_on == date(2026, 5, 3)\n\n\ndef test_req_002_category_is_resolved_case_insensitively(service):\n    expense = service.add_expense(\"5.00\", \"2026-05-03\", \"groceries\")\n    names = {category.id: category.name for category in service.list_categories()}\n    assert names[expense.category_id] == \"Groceries\"\n\n\n@pytest.mark.parametrize(\"amount\", [None, \"\", \"   \", \"abc\", \"0\", \"-4.00\"])\ndef test_req_002_invalid_amount_saves_nothing(service, amount):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense(amount, \"2026-05-03\", \"Groceries\")\n    assert info.value.field == \"amount\"\n    assert info.value.message\n    assert service.list_expenses() == []\n\n\n@pytest.mark.parametrize(\n    \"date_text\", [None, \"\", \"2026-02-30\", \"2026-13-01\", \"03/05/2026\", \"tomorrow\"]\n)\ndef test_req_002_invalid_date_saves_nothing(service, date_text):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense(\"12.50\", date_text, \"Groceries\")\n    assert info.value.field == \"date\"\n    assert service.list_expenses() == []\n\n\ndef test_req_002_unknown_category_saves_nothing(service):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense(\"12.50\", \"2026-05-03\", \"Spaceships\")\n    assert info.value.field == \"category\"\n    assert service.list_expenses() == []\n\n\ndef test_req_003_expenses_listed_newest_first(service):\n    service.add_expense(\"10.00\", \"2026-04-28\", \"Utilities\")\n    service.add_expense(\"20.00\", \"2026-05-09\", \"Groceries\")\n    service.add_expense(\"30.00\", \"2026-05-01\", \"Transport\")\n\n    listed = service.list_expenses()\n    assert [item.spent_on.isoformat() for item in listed] == [\n        \"2026-05-09\",\n        \"2026-05-01\",\n        \"2026-04-28\",\n    ]\n    assert [item.amount_display() for item in listed] == [\"20.00\", \"30.00\", \"10.00\"]\n\n\ndef test_req_003_empty_list_when_nothing_saved(service):\n    assert service.list_expenses() == []\n\n\ndef test_req_008_amounts_stored_as_integer_cents(database, service):\n    service.add_expense(\"0.10\", \"2026-05-03\", \"Groceries\")\n    service.add_expense(\"0.20\", \"2026-05-04\", \"Groceries\")\n    rows = database.fetchall(\"SELECT amount_cents FROM expenses ORDER BY id\")\n    assert [row[\"amount_cents\"] for row in rows] == [10, 20]\n    assert all(isinstance(row[\"amount_cents\"], int) for row in rows)\n"}, {"path": "tests/test_budgets.py", "purpose": "Setting/updating budgets and the OK / NEAR_LIMIT / OVER warning levels with boundary cases (REQ-004, REQ-005).", "covers": ["REQ-004", "REQ-005"], "content": "\"\"\"Budgets per category and their near-limit/over-limit warnings (REQ-004, REQ-005).\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom expensetracker.errors import ValidationError\nfrom expensetracker.models import BudgetLevel\n\n\ndef _status(service, category_name):\n    matches = [item for item in service.budget_overview() if item.category_name == category_name]\n    assert len(matches) == 1, f\"expected exactly one budget row for {category_name}\"\n    return matches[0]\n\n\ndef _spend(service, amount, category=\"Groceries\", day=3):\n    return service.add_expense(amount, \"2026-05-%02d\" % day, category)\n\n\ndef test_req_004_set_budget_is_stored_and_shown(service):\n    budget = service.set_budget(\"Groceries\", \"300.00\")\n    assert budget.amount_cents == 30000\n    assert budget.amount_display() == \"300.00\"\n\n    status = _status(service, \"Groceries\")\n    assert status.budget_cents == 30000\n    assert status.spent_cents == 0\n\n\ndef test_req_004_update_replaces_the_previous_budget(service, repositories):\n    first = service.set_budget(\"Groceries\", \"300.00\")\n    second = service.set_budget(\"Groceries\", \"350.00\")\n\n    assert second.id == first.id\n    assert second.amount_cents == 35000\n    assert second.amount_display() == \"350.00\"\n    assert [budget.amount_cents for budget in repositories.budgets.list_all()] == [35000]\n    assert _status(service, \"Groceries\").budget_cents == 35000\n\n\n@pytest.mark.parametrize(\"amount\", [None, \"\", \"abc\", \"-1.00\", \"0\"])\ndef test_req_004_invalid_budget_saves_nothing(service, repositories, amount):\n    with pytest.raises(ValidationError) as info:\n        service.set_budget(\"Groceries\", amount)\n    assert info.value.field == \"amount\"\n    assert info.value.message\n    assert repositories.budgets.list_all() == []\n    assert service.budget_overview() == []\n\n\ndef test_req_004_unknown_category_saves_nothing(service):\n    with pytest.raises(ValidationError) as info:\n        service.set_budget(\"Spaceships\", \"100.00\")\n    assert info.value.field == \"category\"\n    assert service.budget_overview() == []\n\n\ndef test_req_005_near_limit_at_85_percent(service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    _spend(service, \"85.00\")\n\n    status = _status(service, \"Groceries\")\n    assert status.level is BudgetLevel.NEAR_LIMIT\n    assert status.spent_cents == 8500\n    assert status.percent_used() == 85.0\n    assert \"85\" in status.message()\n    assert \"close\" in status.message().lower()\n\n\ndef test_req_005_over_budget_above_100_percent(service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    _spend(service, \"120.00\")\n\n    status = _status(service, \"Groceries\")\n    assert status.level is BudgetLevel.OVER\n    assert status.spent_cents == 12000\n    assert status.percent_used() == 120.0\n    assert \"over budget\" in status.message().lower()\n\n\ndef test_req_005_no_warning_below_80_percent(service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    _spend(service, \"40.00\")\n\n    status = _status(service, \"Groceries\")\n    assert status.level is BudgetLevel.OK\n    assert status.percent_used() == 40.0\n    assert \"close\" not in status.message().lower()\n    assert \"over\" not in status.message().lower()\n\n\n@pytest.mark.parametrize(\n    \"spent,level\",\n    [\n        (\"79.99\", BudgetLevel.OK),\n        (\"80.00\", BudgetLevel.NEAR_LIMIT),\n        (\"100.00\", BudgetLevel.NEAR_LIMIT),\n        (\"100.01\", BudgetLevel.OVER),\n    ],\n)\ndef test_req_005_warning_level_boundaries(service, spent, level):\n    service.set_budget(\"Groceries\", \"100.00\")\n    _spend(service, spent)\n    assert _status(service, \"Groceries\").level is level\n\n\ndef test_req_005_only_current_month_counts_against_budget(service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    service.add_expense(\"95.00\", \"2026-04-15\", \"Groceries\")\n    _spend(service, \"10.00\")\n\n    status = _status(service, \"Groceries\")\n    assert status.spent_cents == 1000\n    assert status.level is BudgetLevel.OK\n"}, {"path": "tests/test_summary.py", "purpose": "Monthly summary totals and per-category breakdown, exact cents and timing with 10,000 expenses (REQ-006, REQ-008, REQ-009).", "covers": ["REQ-006", "REQ-008", "REQ-009"], "content": "\"\"\"Monthly spending summary by category (REQ-006, REQ-008, REQ-009).\"\"\"\n\nfrom __future__ import annotations\n\nimport time\n\nfrom expensetracker.models import MonthlySummary\n\n\ndef test_req_006_monthly_total_and_breakdown(service):\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"60.00\", \"2026-05-20\", \"Transport\")\n\n    summary = service.monthly_summary()\n    assert summary.month == \"2026-05\"\n    assert summary.total_cents == 10000\n    assert summary.total_display() == \"100.00\"\n    assert summary.by_category == {\"Groceries\": 4000, \"Transport\": 6000}\n    assert summary.category_display(\"Groceries\") == \"40.00\"\n    assert summary.category_display(\"Transport\") == \"60.00\"\n    assert summary.category_display(\"Health\") == \"0.00\"\n\n\ndef test_req_006_previous_month_expense_is_excluded(service):\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"99.99\", \"2026-04-30\", \"Groceries\")\n\n    summary = service.monthly_summary()\n    assert summary.total_cents == 4000\n    assert summary.by_category == {\"Groceries\": 4000}\n    assert \"99.99\" not in summary.total_display()\n\n\ndef test_req_006_explicit_month_selects_that_month(service):\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"10.00\", \"2026-04-10\", \"Utilities\")\n\n    april = service.monthly_summary(\"2026-04\")\n    assert april.month == \"2026-04\"\n    assert april.by_category == {\"Utilities\": 1000}\n    assert april.total_display() == \"10.00\"\n\n\ndef test_req_006_december_month_filter_crosses_the_year(service):\n    service.add_expense(\"5.00\", \"2026-12-31\", \"Other\")\n    service.add_expense(\"7.00\", \"2027-01-01\", \"Other\")\n\n    december = service.monthly_summary(\"2026-12\")\n    assert december.total_display() == \"5.00\"\n    assert december.by_category == {\"Other\": 500}\n\n\ndef test_req_006_empty_month_has_zero_total(service):\n    summary = service.monthly_summary()\n    assert summary.total_cents == 0\n    assert summary.total_display() == \"0.00\"\n    assert summary.by_category == {}\n\n\ndef test_req_008_dime_and_twenty_cent_total_displays_as_0_30(service):\n    service.add_expense(\"0.10\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"0.20\", \"2026-05-03\", \"Groceries\")\n\n    summary = service.monthly_summary()\n    assert summary.category_display(\"Groceries\") == \"0.30\"\n    assert summary.total_display() == \"0.30\"\n\n\ndef test_req_008_saved_12_5_displays_with_two_decimals(service):\n    expense = service.add_expense(\"12.5\", \"2026-05-03\", \"Groceries\")\n    assert expense.amount_display() == \"12.50\"\n    summary = service.monthly_summary()\n    assert summary.category_display(\"Groceries\") == \"12.50\"\n    assert MonthlySummary(month=\"2026-05\", total_cents=expense.amount_cents).total_display() == \"12.50\"\n\n\ndef test_req_009_summary_of_10000_expenses_is_fast(service):\n    categories = [\"Groceries\", \"Transport\", \"Utilities\", \"Other\"]\n    for index in range(10000):\n        service.add_expense(\n            \"1.00\", \"2026-05-%02d\" % (index % 28 + 1), categories[index % len(categories)]\n        )\n\n    started = time.perf_counter()\n    summary = service.monthly_summary()\n    elapsed = time.perf_counter() - started\n\n    assert summary.total_cents == 10000 * 100\n    assert elapsed < 1.0, \"summary request took %.3fs\" % elapsed\n\n\ndef test_req_009_saving_an_expense_with_10000_stored_is_fast(tmp_path, service_builder):\n    database, service = service_builder(tmp_path / \"bulk.db\")\n    for index in range(10000):\n        database.execute(\n            \"INSERT INTO expenses (amount_cents, spent_on, category_id) VALUES (?, ?, ?)\",\n            (100, \"2026-05-%02d\" % (index % 28 + 1), 1),\n        )\n\n    started = time.perf_counter()\n    expense = service.add_expense(\"12.50\", \"2026-05-15\", \"Groceries\")\n    elapsed = time.perf_counter() - started\n\n    assert expense.id > 10000\n    assert elapsed < 1.0, \"saving took %.3fs\" % elapsed\n\n\ndef test_req_009_api_summary_endpoint_with_10000_expenses_is_fast(api, service):\n    for index in range(10000):\n        service.add_expense(\"1.00\", \"2026-05-%02d\" % (index % 28 + 1), \"Groceries\")\n\n    started = time.perf_counter()\n    status, payload = api.get(\"/api/summary\")\n    elapsed = time.perf_counter() - started\n\n    assert status == 200\n    assert payload[\"total_display\"] == \"10000.00\"\n    assert elapsed < 1.0, \"API summary took %.3fs\" % elapsed\n\n\ndef test_req_009_api_save_endpoint_with_10000_expenses_is_fast(api, service):\n    for index in range(10000):\n        service.add_expense(\"1.00\", \"2026-05-%02d\" % (index % 28 + 1), \"Groceries\")\n\n    started = time.perf_counter()\n    status, payload = api.post(\n        \"/api/expenses\", {\"amount\": \"12.50\", \"date\": \"2026-05-15\", \"category\": \"Groceries\"}\n    )\n    elapsed = time.perf_counter() - started\n\n    assert status == 201\n    assert payload[\"amount_display\"] == \"12.50\"\n    assert elapsed < 1.0, \"API save took %.3fs\" % elapsed\n"}, {"path": "tests/test_api.py", "purpose": "JSON API handlers on a real free-port server: expenses, categories, budgets, summary, 400 payloads and static 404s (REQ-001 to REQ-006, REQ-010).", "covers": ["REQ-001", "REQ-002", "REQ-003", "REQ-004", "REQ-005", "REQ-006", "REQ-010"], "content": "\"\"\"JSON API handlers over a real local server (REQ-001..REQ-006, REQ-010).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\n\n\ndef test_req_001_serves_the_tracker_page(live_server, client_factory):\n    client = client_factory(live_server)\n    status, content_type, body = client.raw(\"/\")\n    assert status == 200\n    assert \"text/html\" in content_type\n    text = body.decode(\"utf-8\")\n    assert \"Expense Tracker\" in text\n    assert 'id=\"expense-form\"' in text\n\n    for asset, expected in ((\"/app.js\", \"text/javascript\"), (\"/style.css\", \"text/css\")):\n        asset_status, asset_type, _ = client.raw(asset)\n        assert asset_status == 200\n        assert expected in asset_type\n\n\ndef test_req_001_static_path_traversal_is_rejected(api):\n    status, _, _ = api.raw(\"/../expensetracker/app.py\")\n    assert status == 404\n\n\ndef test_req_001_unknown_api_route_is_404(api):\n    status, payload = api.get(\"/api/unknown\")\n    assert status == 404\n    assert \"error\" in payload\n\n\ndef test_req_002_post_expense_returns_201_and_payload(api):\n    status, payload = api.post(\n        \"/api/expenses\", {\"amount\": \"12.50\", \"date\": \"2026-05-03\", \"category\": \"Groceries\"}\n    )\n    assert status == 201\n    assert payload[\"id\"] > 0\n    assert payload[\"amount_display\"] == \"12.50\"\n    assert payload[\"date\"] == \"2026-05-03\"\n    assert payload[\"category\"] == \"Groceries\"\n\n    list_status, listing = api.get(\"/api/expenses\")\n    assert list_status == 200\n    assert [item[\"id\"] for item in listing[\"expenses\"]] == [payload[\"id\"]]\n\n\ndef test_req_002_invalid_amount_returns_400_field_and_message(api):\n    status, payload = api.post(\n        \"/api/expenses\", {\"amount\": \"abc\", \"date\": \"2026-05-03\", \"category\": \"Groceries\"}\n    )\n    assert status == 400\n    assert payload[\"field\"] == \"amount\"\n    assert payload[\"message\"]\n    assert api.get(\"/api/expenses\")[1][\"expenses\"] == []\n\n\ndef test_req_002_invalid_date_returns_400_and_saves_nothing(api):\n    status, payload = api.post(\n        \"/api/expenses\", {\"amount\": \"12.50\", \"date\": \"2026-02-31\", \"category\": \"Groceries\"}\n    )\n    assert status == 400\n    assert payload[\"field\"] == \"date\"\n    assert api.get(\"/api/expenses\")[1][\"expenses\"] == []\n\n\ndef test_req_002_malformed_json_body_is_400(api):\n    status, payload = api.post_raw(\"/api/expenses\", \"{not json\")\n    assert status == 400\n    assert payload[\"field\"] == \"body\"\n\n\ndef test_req_003_get_expenses_is_newest_first_with_fields(api, service):\n    service.add_expense(\"10.00\", \"2026-04-28\", \"Utilities\")\n    service.add_expense(\"20.00\", \"2026-05-09\", \"Groceries\")\n    service.add_expense(\"30.00\", \"2026-05-01\", \"Transport\")\n\n    status, payload = api.get(\"/api/expenses\")\n    assert status == 200\n    expenses = payload[\"expenses\"]\n    assert [item[\"date\"] for item in expenses] == [\"2026-05-09\", \"2026-05-01\", \"2026-04-28\"]\n    assert [item[\"amount_display\"] for item in expenses] == [\"20.00\", \"30.00\", \"10.00\"]\n    assert [item[\"category\"] for item in expenses] == [\"Groceries\", \"Transport\", \"Utilities\"]\n\n\ndef test_req_003_empty_expense_list_is_empty_array(api):\n    status, payload = api.get(\"/api/expenses\")\n    assert status == 200\n    assert payload[\"expenses\"] == []\n\n\ndef test_req_004_post_budget_saves_and_lists_it(api):\n    status, payload = api.post(\"/api/budgets\", {\"category\": \"Groceries\", \"amount\": \"300.00\"})\n    assert status == 200\n    assert payload[\"category\"] == \"Groceries\"\n    assert payload[\"budget_display\"] == \"300.00\"\n\n    budgets = api.get(\"/api/budgets\")[1][\"budgets\"]\n    assert len(budgets) == 1\n    assert budgets[0][\"budget_display\"] == \"300.00\"\n\n\ndef test_req_004_second_budget_overwrites_first(api):\n    api.post(\"/api/budgets\", {\"category\": \"Groceries\", \"amount\": \"300.00\"})\n    status, payload = api.post(\"/api/budgets\", {\"category\": \"Groceries\", \"amount\": \"350.00\"})\n    assert status == 200\n    assert payload[\"budget_display\"] == \"350.00\"\n\n    budgets = api.get(\"/api/budgets\")[1][\"budgets\"]\n    assert [item[\"budget_display\"] for item in budgets] == [\"350.00\"]\n\n\ndef test_req_004_negative_budget_is_400_and_not_saved(api):\n    status, payload = api.post(\"/api/budgets\", {\"category\": \"Groceries\", \"amount\": \"-10\"})\n    assert status == 400\n    assert payload[\"field\"] == \"amount\"\n    assert api.get(\"/api/budgets\")[1][\"budgets\"] == []\n\n\ndef test_req_005_budget_overview_levels(api, service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    service.set_budget(\"Transport\", \"100.00\")\n    service.set_budget(\"Utilities\", \"100.00\")\n    service.add_expense(\"85.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"120.00\", \"2026-05-02\", \"Transport\")\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Utilities\")\n\n    status, payload = api.get(\"/api/budgets\")\n    assert status == 200\n    by_name = {item[\"category\"]: item for item in payload[\"budgets\"]}\n    assert by_name[\"Groceries\"][\"level\"] == \"NEAR_LIMIT\"\n    assert by_name[\"Groceries\"][\"spent_display\"] == \"85.00\"\n    assert by_name[\"Groceries\"][\"percent\"] == 85.0\n    assert by_name[\"Transport\"][\"level\"] == \"OVER\"\n    assert by_name[\"Utilities\"][\"level\"] == \"OK\"\n\n\ndef test_req_006_summary_endpoint(api, service):\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"60.00\", \"2026-05-20\", \"Transport\")\n    service.add_expense(\"500.00\", \"2026-04-02\", \"Groceries\")\n\n    status, payload = api.get(\"/api/summary\")\n    assert status == 200\n    assert payload[\"month\"] == \"2026-05\"\n    assert payload[\"total_display\"] == \"100.00\"\n    totals = {item[\"name\"]: item[\"total_display\"] for item in payload[\"categories\"]}\n    assert totals == {\"Groceries\": \"40.00\", \"Transport\": \"60.00\"}\n\n\ndef test_req_010_error_payload_names_field_and_reason(api):\n    status, payload = api.post(\n        \"/api/expenses\", {\"amount\": \"\", \"date\": \"2026-05-03\", \"category\": \"Groceries\"}\n    )\n    assert status == 400\n    assert payload[\"field\"] == \"amount\"\n    assert isinstance(payload[\"message\"], str) and payload[\"message\"].strip()\n    assert json.dumps(payload).count(\"Traceback\") == 0\n\n\ndef test_req_010_categories_endpoint_lists_seven_fixed_categories(api):\n    status, payload = api.get(\"/api/categories\")\n    assert status == 200\n    names = [item[\"name\"] for item in payload[\"categories\"]]\n    assert names == [\n        \"Groceries\",\n        \"Rent\",\n        \"Transport\",\n        \"Utilities\",\n        \"Entertainment\",\n        \"Health\",\n        \"Other\",\n    ]\n"}, {"path": "tests/test_page.py", "purpose": "The Python TrackerPage view against the live API: expense rows, budget badges, summary and messages (REQ-002 to REQ-006, REQ-010).", "covers": ["REQ-002", "REQ-003", "REQ-004", "REQ-005", "REQ-006", "REQ-010"], "content": "\"\"\"The Python tracker page view against a running server (REQ-002..REQ-006, REQ-010).\"\"\"\n\nfrom __future__ import annotations\n\nfrom expensetracker.page import TrackerPage\n\n\ndef _page(base_url):\n    return TrackerPage(base_url)\n\n\ndef test_req_003_page_renders_expenses_newest_first(live_server, service):\n    service.add_expense(\"10.00\", \"2026-04-28\", \"Utilities\")\n    service.add_expense(\"20.00\", \"2026-05-09\", \"Groceries\")\n    service.add_expense(\"30.00\", \"2026-05-01\", \"Transport\")\n\n    page = _page(live_server)\n    payload = page.callApi(\"GET\", \"/api/expenses\")\n    page.renderExpenses(payload[\"expenses\"])\n\n    rows = page._expense_rows\n    assert [row[0] for row in rows] == [\"2026-05-09\", \"2026-05-01\", \"2026-04-28\"]\n    assert \"Groceries\" in rows[0][2] and \"20.00\" in rows[0][2]\n    assert \"Transport\" in rows[1][2] and \"30.00\" in rows[1][2]\n    assert \"Utilities\" in rows[2][2] and \"10.00\" in rows[2][2]\n\n\ndef test_req_003_page_renders_no_rows_when_list_empty(live_server):\n    page = _page(live_server)\n    page.renderExpenses(page.callApi(\"GET\", \"/api/expenses\")[\"expenses\"])\n    assert page._expense_rows == []\n\n\ndef test_req_002_page_inserts_saved_expense_in_date_order(live_server):\n    service_page = _page(live_server)\n    service_page.renderExpenses([])\n    service_page.callApi(\n        \"POST\", \"/api/expenses\", {\"amount\": \"5.00\", \"date\": \"2026-05-01\", \"category\": \"Health\"}\n    )\n    service_page.callApi(\n        \"POST\", \"/api/expenses\", {\"amount\": \"6.00\", \"date\": \"2026-05-20\", \"category\": \"Rent\"}\n    )\n\n    saved = service_page.callApi(\n        \"POST\", \"/api/expenses\", {\"amount\": \"7.50\", \"date\": \"2026-05-10\", \"category\": \"Other\"}\n    )\n    service_page.insertRow(saved)\n\n    assert [row[0] for row in service_page._expense_rows] == [\n        \"2026-05-20\",\n        \"2026-05-10\",\n        \"2026-05-01\",\n    ]\n    assert \"7.50\" in service_page._expense_rows[1][2]\n\n\ndef test_req_005_page_renders_budget_warning_states(live_server, service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    service.add_expense(\"85.00\", \"2026-05-02\", \"Groceries\")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi(\"GET\", \"/api/budgets\")[\"budgets\"])\n    row = page._budget_rows[0]\n    assert \"Groceries\" in row\n    assert \"100.00\" in row\n    assert \"85.00\" in row\n    assert \"level-near_limit\" in row\n    assert \"Close to limit\" in row\n\n\ndef test_req_005_page_renders_over_budget_state(live_server, service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    service.add_expense(\"120.00\", \"2026-05-02\", \"Groceries\")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi(\"GET\", \"/api/budgets\")[\"budgets\"])\n    row = page._budget_rows[0]\n    assert \"level-over\" in row\n    assert \"Over budget\" in row\n\n\ndef test_req_005_page_renders_no_badge_when_within_limit(live_server, service):\n    service.set_budget(\"Groceries\", \"100.00\")\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi(\"GET\", \"/api/budgets\")[\"budgets\"])\n    row = page._budget_rows[0]\n    assert \"level-ok\" in row\n    assert \"badge\" not in row\n\n\ndef test_req_006_page_renders_summary(live_server, service):\n    service.add_expense(\"40.00\", \"2026-05-02\", \"Groceries\")\n    service.add_expense(\"60.00\", \"2026-05-20\", \"Transport\")\n\n    page = _page(live_server)\n    page.renderSummary(page.callApi(\"GET\", \"/api/summary\"))\n    markup = page._summary_html\n    assert \"100.00\" in markup\n    assert \"2026-05\" in markup\n    assert \"Groceries\" in markup and \"40.00\" in markup\n    assert \"Transport\" in markup and \"60.00\" in markup\n\n\ndef test_req_006_page_summary_empty_state(live_server):\n    page = _page(live_server)\n    page.renderSummary(page.callApi(\"GET\", \"/api/summary\"))\n    assert \"No spending recorded this month yet.\" in page._summary_html\n    assert \"0.00\" in page._summary_html\n\n\ndef test_req_010_page_shows_success_and_error_messages(live_server):\n    page = _page(live_server)\n    page.showMessage(\"Expense saved.\", False)\n    assert \"message success\" in page._message_html\n    assert 'role=\"status\"' in page._message_html\n\n    page.showMessage(\"Amount: Amount must be greater than zero.\", True)\n    assert \"message error\" in page._message_html\n    assert 'role=\"alert\"' in page._message_html\n    assert \"Amount must be greater than zero.\" in page._message_html\n\n\ndef test_req_010_page_escapes_untrusted_text(live_server):\n    page = _page(live_server)\n    page.renderExpenses(\n        [{\"id\": 1, \"date\": \"2026-05-02\", \"category\": \"<script>x</script>\", \"amount_display\": \"1.00\"}]\n    )\n    assert \"<script>\" not in page._expense_rows[0][2]\n    assert \"&lt;script&gt;\" in page._expense_rows[0][2]\n\n\ndef test_req_010_page_returns_error_payload_on_validation_failure(live_server):\n    page = _page(live_server)\n    result = page.callApi(\n        \"POST\", \"/api/expenses\", {\"amount\": \"0\", \"date\": \"2026-05-02\", \"category\": \"Groceries\"}\n    )\n    assert result[\"field\"] == \"amount\"\n    assert result[\"message\"]\n"}, {"path": "tests/test_labels.py", "purpose": "Served index.html has a visible label for every input, message area and empty states (REQ-001, REQ-003, REQ-004, REQ-006, REQ-010).", "covers": ["REQ-001", "REQ-003", "REQ-004", "REQ-006", "REQ-010"], "content": "\"\"\"Labelled form fields and empty-state text in the served page (REQ-003, REQ-010).\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nFIELDS = {\n    \"expense-amount\": \"Amount\",\n    \"expense-date\": \"Date\",\n    \"expense-category\": \"Category\",\n    \"budget-category\": \"Category\",\n    \"budget-amount\": \"Monthly budget amount\",\n}\n\n\ndef _page_html(client):\n    status, _, body = client.raw(\"/\")\n    assert status == 200\n    return body.decode(\"utf-8\")\n\n\ndef test_req_010_every_input_has_a_visible_label(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    for field_id, label_text in FIELDS.items():\n        assert 'id=\"%s\"' % field_id in markup, \"missing input %s\" % field_id\n        pattern = r'<label[^>]*for=\"%s\"[^>]*>(.*?)</label>' % re.escape(field_id)\n        match = re.search(pattern, markup, re.S)\n        assert match is not None, \"no label bound to %s\" % field_id\n        text = re.sub(r\"<[^>]+>\", \"\", match.group(1)).strip()\n        assert text, \"label for %s is empty\" % field_id\n        assert text == label_text\n\n\ndef test_req_010_page_has_a_message_area_for_feedback(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    match = re.search(r'<p id=\"message\"[^>]*>', markup)\n    assert match is not None\n    assert \"role=\" in match.group(0)\n\n\ndef test_req_003_page_has_an_empty_state_for_the_expense_list(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    assert 'id=\"expense-empty\"' in markup\n    assert \"No expenses recorded yet\" in markup\n    assert 'id=\"expense-rows\"' in markup\n\n\ndef test_req_004_page_has_an_empty_state_and_table_for_budgets(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    assert 'id=\"budget-rows\"' in markup\n    assert 'id=\"budget-empty\"' in markup\n    assert \"No budgets set yet\" in markup\n\n\ndef test_req_006_page_has_a_summary_section(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    assert 'id=\"summary-total\"' in markup\n    assert 'id=\"summary-categories\"' in markup\n\n\ndef test_req_001_page_loads_its_own_script_and_style(live_server, client_factory):\n    markup = _page_html(client_factory(live_server))\n    assert 'src=\"/app.js\"' in markup\n    assert 'href=\"/style.css\"' in markup\n    assert \"http://\" not in markup.replace(\"http://www.w3.org\", \"\")\n    assert \"https://\" not in markup\n"}, {"path": "tests/test_persistence.py", "purpose": "Schema/file creation on first run, data surviving a reopen and a real subprocess restart of python -m expensetracker (REQ-001, REQ-007).", "covers": ["REQ-001", "REQ-007"], "content": "\"\"\"SQLite storage: creation on first run and survival across restarts (REQ-007, REQ-001).\"\"\"\n\nfrom __future__ import annotations\n\nimport http.client\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nfrom expensetracker.database import AppDatabase\nfrom expensetracker.repositories import CategoryRepository\n\n\ndef test_req_007_schema_creates_file_on_first_run(tmp_path):\n    path = tmp_path / \"data\" / \"expense_tracker.db\"\n    assert not path.exists()\n    database = AppDatabase(str(path))\n    database.create_schema()\n    assert path.is_file()\n\n    categories = CategoryRepository(database)\n    assert categories.list_all() == []\n    categories.seed_defaults()\n    assert len(categories.list_all()) == 7\n    assert \"Groceries\" in [category.name for category in categories.list_all()]\n\n\ndef test_req_007_seeding_twice_keeps_seven_categories(database):\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    categories.seed_defaults()\n    assert len(categories.list_all()) == 7\n\n\ndef test_req_007_expenses_and_budgets_survive_reopen(tmp_path, service_builder):\n    path = tmp_path / \"expense_tracker.db\"\n    _, first = service_builder(path)\n    first.add_expense(\"12.50\", \"2026-05-03\", \"Groceries\")\n    first.set_budget(\"Groceries\", \"300.00\")\n\n    _, second = service_builder(path)\n    expenses = second.list_expenses()\n    assert len(expenses) == 1\n    assert expenses[0].amount_display() == \"12.50\"\n    assert expenses[0].spent_on.isoformat() == \"2026-05-03\"\n\n    budgets = second.budget_overview()\n    assert len(budgets) == 1\n    assert budgets[0].category_name == \"Groceries\"\n    assert budgets[0].budget_cents == 30000\n\n\ndef test_req_007_fresh_database_starts_with_empty_expense_list(tmp_path, service_builder):\n    _, service = service_builder(tmp_path / \"brand_new.db\")\n    assert service.list_expenses() == []\n    assert service.budget_overview() == []\n    assert service.monthly_summary().total_display() == \"0.00\"\n\n\ndef _free_port() -> int:\n    with socket.socket() as sock:\n        sock.bind((\"127.0.0.1\", 0))\n        return int(sock.getsockname()[1])\n\n\ndef _wait_for_server(port: int, timeout: float = 20.0) -> None:\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        try:\n            connection = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=1)\n            connection.request(\"GET\", \"/api/categories\")\n            connection.getresponse().read()\n            connection.close()\n            return\n        except OSError:\n            time.sleep(0.05)\n    raise AssertionError(\"server did not start within %.0fs\" % timeout)\n\n\ndef _start_server(port: int, home: Path) -> subprocess.Popen:\n    env = dict(os.environ)\n    env[\"HOME\"] = str(home)\n    proc = subprocess.Popen(\n        [sys.executable, \"-m\", \"expensetracker\", \"--port\", str(port)],\n        cwd=str(Path(__file__).resolve().parent.parent),\n        env=env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.STDOUT,\n    )\n    _wait_for_server(port)\n    return proc\n\n\ndef _post(port: int, path: str, payload: dict) -> tuple[int, dict]:\n    connection = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=10)\n    body = json.dumps(payload).encode(\"utf-8\")\n    connection.request(\"POST\", path, body=body, headers={\"Content-Type\": \"application/json\"})\n    response = connection.getresponse()\n    data = json.loads(response.read().decode(\"utf-8\") or \"{}\")\n    status = response.status\n    connection.close()\n    return status, data\n\n\ndef _get(port: int, path: str):\n    connection = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=10)\n    connection.request(\"GET\", path)\n    response = connection.getresponse()\n    data = json.loads(response.read().decode(\"utf-8\") or \"{}\")\n    status = response.status\n    connection.close()\n    return status, data\n\n\ndef test_req_001_python_dash_m_starts_the_served_page(tmp_path):\n    port = _free_port()\n    proc = _start_server(port, tmp_path)\n    try:\n        connection = http.client.HTTPConnection(\"127.0.0.1\", port, timeout=10)\n        connection.request(\"GET\", \"/\")\n        response = connection.getresponse()\n        body = response.read().decode(\"utf-8\")\n        content_type = response.headers.get(\"Content-Type\", \"\")\n        status = response.status\n        connection.close()\n        assert status == 200\n        assert \"text/html\" in content_type\n        assert \"Expense Tracker\" in body\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n\n\ndef test_req_007_restarted_server_still_serves_saved_data(tmp_path):\n    port = _free_port()\n    proc = _start_server(port, tmp_path)\n    try:\n        status, _ = _post(\n            port,\n            \"/api/expenses\",\n            {\"amount\": \"12.50\", \"date\": \"2026-05-03\", \"category\": \"Groceries\"},\n        )\n        assert status == 201\n        assert _post(port, \"/api/budgets\", {\"category\": \"Groceries\", \"amount\": \"300.00\"})[0] == 200\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n\n    proc = _start_server(port, tmp_path)\n    try:\n        expenses = _get(port, \"/api/expenses\")[1][\"expenses\"]\n        assert [item[\"amount_display\"] for item in expenses] == [\"12.50\"]\n        budgets = _get(port, \"/api/budgets\")[1][\"budgets\"]\n        assert [item[\"budget_display\"] for item in budgets] == [\"300.00\"]\n    finally:\n        proc.terminate()\n        proc.wait(timeout=10)\n"}], "gaps": [{"requirement": "REQ-010", "reason": "That entered values stay in the form after a failed submission is browser-side behaviour in app.js and is not exercised; only the server's field/reason payload and the labels are checked."}, {"requirement": "REQ-005", "reason": "The warning badge rendering is verified in the Python page view and served HTML, not in a real browser with app.js."}, {"requirement": "REQ-006", "reason": "The summary rendering is checked through the Python page view and API; the browser DOM rendering by app.js is not run."}, {"requirement": "REQ-009", "reason": "The 1-second limits are checked against the in-process service and local API, not against page load time in a browser."}, {"requirement": "REQ-001", "reason": "The tests start the server on a free port and fetch the page, but never the default 127.0.0.1:8000 port nor a real browser session."}, {"requirement": "REQ-007", "reason": "Persistence is verified with a reopened database and a restarted subprocess using the module's fixed data file, but not with the default data path on a clean machine."}]}
