        {
          "id": "call_5eb519e125ebd1218f98846c",
          "type": "function",
          "function": {
            "name": "check_python",
            "arguments": "{\"path\": \"expensetracker/app.py\", \"source\": \"\\\"\\\"\\\"App: the entry point that wires storage, service and server together.\\n\\nImplements the App class of the domain class diagram and the \\\"Startup and\\nstorage\\\" sequence diagram.\\nTrace: REQ-001, REQ-007\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport threading\\nfrom pathlib import Path\\nfrom urllib.request import urlopen\\n\\nfrom .api import ApiHandler\\nfrom .clock import Clock\\nfrom .database import AppDatabase\\nfrom .repositories import BudgetRepository, CategoryRepository, ExpenseRepository\\nfrom .server import TrackerServer\\nfrom .service import ExpenseTrackerService\\n\\nDEFAULT_PORT = 8000\\nDATA_FILE = Path(__file__).resolve().parent.parent / \\\"data\\\" / \\\"expense_tracker.db\\\"\\n\\n\\nclass App:\\n    \\\"\\\"\\\"Builds the object graph in the order the start-up sequence shows.\\\"\\\"\\\"\\n\\n    @staticmethod\\n    def main(argv: list[str] | None = None) -> None:\\n        parser = argparse.ArgumentParser(\\n            prog=\\\"python -m expensetracker\\\",\\n            description=\\\"Local single-user expense tracker.\\\",\\n        )\\n        parser.add_argument(\\\"--port\\\", type=int, default=DEFAULT_PORT, help=\\\"port to listen on\\\")\\n        parser.add_argument(\\n            \\\"--check\\\",\\n            action=\\\"store_true\\\",\\n            help=\\\"start on a free port, request the main page once, print the status and exit\\\",\\n        )\\n        args = parser.parse_args(argv)\\n\\n        database = AppDatabase(str(DATA_FILE))\\n        database.create_schema()\\n\\n        categories = CategoryRepository(database)\\n        categories.seed_defaults()\\n        expenses = ExpenseRepository(database)\\n        budgets = BudgetRepository(database)\\n        service = ExpenseTrackerService(expenses, budgets, categories, Clock())\\n\\n        port = 0 if args.check else args.port\\n        server = TrackerServer(port, ApiHandler(service))\\n\\n        if args.check:\\n            App._smoke_test(server)\\n            return\\n\\n        print(f\\\"Expense tracker running at http://127.0.0.1:{args.port}/ (Ctrl+C to stop)\\\")\\n        try:\\n            server.serve_forever()\\n        except KeyboardInterrupt:\\n            print(\\\"\\\\nStopped.\\\")\\n        finally:\\n            server._httpd.server_close()  # private handle: only used for shutdown\\n\\n    @staticmethod\\n    def _smoke_test(server: TrackerServer) -> None:\\n        \\\"\\\"\\\"Start the server, request the main page once and print its status.\\\"\\\"\\\"\\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\\n        thread.start()\\n        bound_port = server._httpd.server_address[1]  # private handle: free port chosen by the OS\\n        try:\\n            with urlopen(f\\\"http://127.0.0.1:{bound_port}/\\\", timeout=10) as response:\\n                print(f\\\"GET / -> {response.status}\\\")\\n        finally:\\n            server._httpd.shutdown()\\n            server._httpd.server_close()\\n            thread.join(timeout=5)\\n\"}"
          }
        },
