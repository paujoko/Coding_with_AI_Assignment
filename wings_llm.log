fo.value.message\\n    assert repositories.budgets.list_all() == []\\n    assert service.budget_overview() == []\\n\\n\\ndef test_req_004_unknown_category_saves_nothing(service):\\n    with pytest.raises(ValidationError) as info:\\n        service.set_budget(\\\"Spaceships\\\", \\\"100.00\\\")\\n    assert info.value.field == \\\"category\\\"\\n    assert service.budget_overview() == []\\n\\n\\ndef test_req_005_near_limit_at_85_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"85.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.NEAR_LIMIT\\n    assert status.spent_cents == 8500\\n    assert status.percent_used() == 85.0\\n    assert \\\"85\\\" in status.message()\\n    assert \\\"close\\\" in status.message().lower()\\n\\n\\ndef test_req_005_over_budget_above_100_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"120.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.OVER\\n    assert status.spent_cents == 12000\\n    assert status.percent_used() == 120.0\\n    assert \\\"over budget\\\" in status.message().lower()\\n\\n\\ndef test_req_005_no_warning_below_80_percent(service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    _spend(service, \\\"40.00\\\")\\n\\n    status = _status(service, \\\"Groceries\\\")\\n    assert status.level is BudgetLevel.OK\\n    assert status.percent_used() == 40.0\\n    assert \\\"close\\\" not in status.message().lower()\\n    assert \\\"over\\\" not in status.message().lower()\\n\\n\\n@pytest.mark.parametrize(\\n    \\\"spent,level\\\",\\n    [\\n        (\\\"79.99\\\", BudgetLevel.OK),\\n        (\\\"80.00\\\", BudgetLevel.NEAR_LIMIT),\\n        (\\\"100.00\\\", BudgetLevel.NEAR_LIMIT),\\n        (\\\"100.01\\\", BudgetLevel.OVER),\\n    ],\\n)\\ndef test_req_005_warning_level_boundaries(service, spent, leve