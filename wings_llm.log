ervice = ExpenseTrackerService(expenses, budgets, categories, Clock())\\n\\n        server = TrackerServer(port=0 if args.check else args.port, handler=ApiHandler(service))\\n\\n        if args.check:\\n            App._smoke_test(server)\\n            return\\n\\n        print(f\\\"Expense tracker running at http://127.0.0.1:{args.port}/ (Ctrl+C to stop)\\\")\\n        try:\\n            server.serve_forever()\\n        except KeyboardInterrupt:\\n            print(\\\"\\\\nStopped.\\\")\\n        finally:\\n            server._shutdown()\\n\\n    @staticmethod\\n    def _smoke_test(server: TrackerServer) -> None:\\n        \\\"\\\"\\\"Start the server, request the main page once, print its status, exit.\\\"\\\"\\\"\\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\\n        thread.start()\\n        base_url = f\\\"http://127.0.0.1:{server._bound_port()}\\\"\\n        try:\\n            with urlopen(f\\\"{base_url}/\\\", timeout=10) as response:\\n                print(f\\\"GET / -> {response.status}\\\")\\n            page = TrackerPage(base_url)\\n            page.renderExpenses(page.callApi(\\\"GET\\\", \\\"/api/expenses\\\").get(\\\"expenses\\\", []))\\n            page.renderBudgets(page.callApi(\\\"GET\\\", \\\"/api/budgets\\\").get(\\\"budgets\\\", []))\\n            summary = page.callApi(\\\"GET\\\", \\\"/api/summary\\\")\\n            page.renderSummary(summary)\\n            print(\\n                \\\"GET /api/summary -> month \\\"\\n                f\\\"{summary.get('month')} total {summary.get('total_display')}\\\"\\n            )\\n        finally:\\n            server._shutdown()\\n            thread.join(timeout=5)\\n\"}"
