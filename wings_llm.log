s(response.read().decode("utf-8") or "{}")\n        except HTTPError as error:\n            return json.loads(error.read().decode("utf-8") or "{}")\n\n    # -- rendering ----------------------------------------------------------\n\n    def renderExpenses(self, expenses: list) -> None:\n        """Replace the expense list with the given expenses (newest first)."""\n        self._expense_rows = [\n            (\n                str(expense.get("date", "")),\n                int(expense.get("id") or 0),\n                self._build_row(expense),\n            )\n            for expense in expenses or []\n        ]\n\n    def insertRow(self, expense: dict) -> None:\n        """Insert one saved expense at its date position without refetching."""\n        entry = (\n            str(expense.get("date", "")),\n            int(expense.get("id") or 0),\n            self._build_row(expense),\n        )\n        for index, existing in enumerate(self._expense_rows):\n            if existing[0] < entry[0] or (existing[0] == entry[0] and existing[1] < entry[1]):\n                self._expense_rows.insert(index, entry)\n                return\n        self._expense_rows.append(entry)\n\n    def renderBudgets(self, statuses: list) -> None:\n        """Render each budgeted category with its usage and warning state."""\n        self._budget_rows = [self._build_budget_row(status) for status in statuses or []]\n\n    def renderSummary(self, summary: dict) -> None:\n        """Render the current month total and its per-category breakdown."""\n        month = html.escape(str(summary.get("month", "")))\n        total = html.escape(str(summary.get("total_display", "0.00")))\n        categories = summary.get("categories") or []\n        if categories:\n            items = "".join(\n                \'<li><span>\'\n                + html.escape(str(category.get("name", "")))\n                + \'</span><span class="amount">\'\n                + html.escape(str(category.get("total_display", "0.00")))\n                + "</span></li>"\n                for category in categories\n            )\n        else:\n            items = \'<li class="empty">No spending recorded this month yet.</li>\'\n        self._summary_html = (\n            \'<p class="summary-total">Total spent <span class="muted">\'\n            + month\n            + "</span>: <strong>"\n            + total\n            + "</strong></p><ul class=\\"summary-list\\">"\n            + items\n            + "</ul>"\n        )\n\n    def showMessage(self, text: str, is_error: bool) -> None:\n        """Show a plain-language confirmation or validation message."""\n        if not text:\n            self._message_html = ""\n            return\n        css_class = "message error" if is_error else "message success"\n        role = "alert" if is_error else "status"\n        self._message_html = (\n            f\'<p class="{css_class}" role="{role}">{html.escape(str(text))}</p>\'\n        )\n\n    # -- helpers ------------------------------------------------------------\n\n    def _build_row(self, expense: dict) -> str:\n        """One table row for an expense: date, category and amount."""\n        date_cell = html.escape(str(expense.get("date", "")))\n        category_cell = html.escape(str(expense.get("category", "")))\n        amount_cell = html.escape(str(expense.get("amount_display", "0.00")))\n        return (\n            f"<tr><td>{date_cell}</td><td>{category_cell}</td>"\n            f\'<td class="amount">{amount_cell}</td></tr>\'\n        )\n\n    def _build_budget_row(self, status: dict) -> str:\n        """One table row for a budget: category, budget, spent and status text."""\n        level = str(status.get("level", "OK")).lower()\n        message = html.escape(str(status.get("message", "")))\n        badge = ""\n        if level != "ok":\n            label = "Over budget" if level == "over" else "Close to limit"\n            badge = f\'<span class="badge">{label}</span>\'\n        category_cell = html.escape(str(status.get("category", "")))\n        budget_cell = html.escape(str(status.get("budget_display", "0.00")))\n        spent_cell = html.escape(str(status.get("spent_display", "0.00")))\n        return (\n            f\'<tr class="level-{level}"><td>{category_cell}</td>\'\n            f\'<td class="amount">{budget_cell}</td>\'\n            f\'<td class="amount">{spent_cell}</td>\'\n            f\'<td class="budget-message">{badge}{message}</td></tr>\'\n        )\n'}}, {'name': 'check_python', 'args': {'path': 'expensetracker/app.py', 'source': '"""App: the entry point that wires storage, service and server together.\n\nImplements the App class of the domain class diagram and the "Startup and\nstorage" sequence diagram.\nTrace: REQ-001, REQ-007\n"""\n\nfrom __future__ import annotations\n\nimport argparse\nimport threading\nfrom pathlib import Path\nfrom urllib.request import urlopen\n\nfrom .api import ApiHandler\nfrom .clock import Clock\nfrom .database import AppDatabase\nfrom .page import TrackerPage\nfrom .repositories import BudgetRepository, CategoryRepository, ExpenseRepository\nfrom .server import TrackerServer\nfrom .service import ExpenseTrackerService\n\nDEFAULT_PORT = 8000\nDATA_FILE = Path(__file__).resolve().parent.parent / "data" / "expense_tracker.db"\n\n\nclass App:\n    """Builds the object graph in the order the start-up sequence shows."""\n\n    @staticmethod\n    def main(argv: list[str] | None = None) -> None:\n        """Create the schema, seed categories, wire the service and serve."""\n        parser = argparse.ArgumentParser(\n            prog="python -m expensetracker",\n            description="Local single-user expense tracker.",\n        )\n        parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="port to listen on")\n        parser.add_argument(\n            "--check",\n            action="store_true",\n            help="start on a free port, request the main page once, print the status and exit",\n        )\n        args = parser.parse_args(argv)\n\n        database = AppDatabase(str(DATA_FILE))\n        database.create_schema()\n\n        categories = CategoryRepository(database)\n        categories.seed_defaults()\n        expenses = ExpenseRepository(database)\n        budgets = BudgetRepository(database)\n        service = ExpenseTrackerService(expenses, budgets, categories, Clock())\n\n        server = TrackerServer(port=0 if args.check else args.port, handler=ApiHandler(service))\n\n        if args.check:\n            App._smoke_test(server)\n            return\n\n        print(f"Expense tracker running at http://127.0.0.1:{args.port}/ (Ctrl+C to stop)")\n        try:\n            server.serve_forever()\n        except KeyboardInterrupt:\n            print("\\nStopped.")\n        finally:\n            server._shutdown()\n\n    @staticmethod\n    def _smoke_test(server: TrackerServer) -> None:\n        """Start the server, request the main page once, print its status, exit."""\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\n        thread.start()\n        base_url = f"http://127.0.0.1:{server._bound_port()}"\n        try:\n            with urlopen(f"{base_url}/", timeout=10) as response:\n                print(f"GET / -> {response.status}")\n            page = TrackerPage(base_url)\n            page.renderExpenses(page.callApi("GET", "/api/expenses").get("expenses", []))\n            page.renderBudgets(page.callApi("GET", "/api/budgets").get("budgets", []))\n            summary = page.callApi("GET", "/api/summary")\n            page.renderSummary(summary)\n            print(\n                "GET /api/summary -> month "\n                f"{summary.get(\'month\')} total {summary.get(\'total_display\')}"\n            )\n        finally:\n            server._shutdown()\n            thread.join(timeout=5)\n'}}]

