alue.message.lower()\n\n\n@pytest.mark.parametrize("text", ["0", "0.00", "-1", "-0.01"])\ndef test_req_002_parse_amount_rejects_non_positive(text):\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount(text)\n    assert info.value.field == "amount"\n    assert "greater than zero" in info.value.message.lower()\n\n\ndef test_req_002_parse_date_accepts_valid_calendar_dates():\n    assert Dates.parse_date("2026-05-03") == date(2026, 5, 3)\n    assert Dates.parse_date(" 2026-05-31 ") == date(2026, 5, 31)\n    assert Dates.parse_date("2024-02-29") == date(2024, 2, 29)\n\n\n@pytest.mark.parametrize(\n    "text",\n    [None, "", "2026-02-30", "2026-13-01", "2025-02-29", "03/05/2026", "2026-05-3", "tomorrow"],\n)\ndef test_req_002_parse_date_rejects_invalid_calendar_dates(text):\n    with pytest.raises(ValidationError) as info:\n        Dates.parse_date(text)\n    assert info.value.field == "date"\n    assert info.value.message\n\n\ndef test_req_008_format_cents_always_two_decimals():\n    assert Money.format_cents(1250) == "12.50"\n    assert Money.format_cents(5) == "0.05"\n    assert Money.format_cents(10000) == "100.00"\n    assert Money.format_cents(0) == "0.00"\n\n\ndef test_req_008_dimes_add_without_float_drift():\n    total = Money.parse_amount("0.10") + Money.parse_amount("0.20")\n    assert total == 30\n    assert isinstance(total, int)\n    assert Money.format_cents(total) == "0.30"\n\n\ndef test_req_010_validation_error_carries_field_and_plain_message():\n    with pytest.raises(ValidationError) as info:\n        Money.parse_amount("abc")\n    error = info.value\n    assert error.field == "amount"\n    assert error.message == str(error)\n    assert "Traceback" not in error.message\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_service_expenses.py', 'source': '"""Logging and listing expenses through the service (REQ-002, REQ-003, REQ-008)."""\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nimport pytest\n\nfrom expensetracker.errors import ValidationError\n\n\ndef test_req_002_add_expense_is_saved_and_listed(service):\n    expense = service.add_expense("12.50", "2026-05-03", "Groceries")\n    assert expense.id > 0\n    assert expense.amount_cents == 1250\n    assert expense.spent_on == date(2026, 5, 3)\n    assert expense.amount_display() == "12.50"\n\n    listed = service.list_expenses()\n    assert len(listed) == 1\n    assert listed[0].id == expense.id\n    assert listed[0].amount_cents == 1250\n    assert listed[0].spent_on == date(2026, 5, 3)\n\n\ndef test_req_002_category_is_resolved_case_insensitively(service):\n    expense = service.add_expense("5.00", "2026-05-03", "groceries")\n    names = {category.id: category.name for category in service.list_categories()}\n    assert names[expense.category_id] == "Groceries"\n\n\n@pytest.mark.parametrize("amount", [None, "", "   ", "abc", "0", "-4.00"])\ndef test_req_002_invalid_amount_saves_nothing(service, amount):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense(amount, "2026-05-03", "Groceries")\n    assert info.value.field == "amount"\n    assert info.value.message\n    assert service.list_expenses() == []\n\n\n@pytest.mark.parametrize(\n    "date_text", [None, "", "2026-02-30", "2026-13-01", "03/05/2026", "tomorrow"]\n)\ndef test_req_002_invalid_date_saves_nothing(service, date_text):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense("12.50", date_text, "Groceries")\n    assert info.value.field == "date"\n    assert service.list_expenses() == []\n\n\ndef test_req_002_unknown_category_saves_nothing(service):\n    with pytest.raises(ValidationError) as info:\n        service.add_expense("12.50", "2026-05-03", "Spaceships")\n    assert info.value.field == "category"\n    assert service.list_expenses() == []\n\n\ndef test_req_003_expenses_listed_newest_first(service):\n    service.add_expense("10.00", "2026-04-28", "Utilities")\n    service.add_expense("20.00", "2026-05-09", "Groceries")\n    service.add_expense("30.00", "2026-05-01", "Transport")\n\n    listed = service.list_expenses()\n    assert [item.spent_on.isoformat() for item in listed] == [\n        "2026-05-09",\n        "2026-05-01",\n        "2026-04-28",\n    ]\n    assert [item.amount_display() for item in listed] == ["20.00", "30.00", "10.00"]\n\n\ndef test_req_003_empty_list_when_nothing_saved(service):\n    assert service.list_expenses() == []\n\n\ndef test_req_008_amounts_stored_as_integer_cents(database, service):\n    service.add_expense("0.10", "2026-05-03", "Groceries")\n    service.add_expense("0.20", "2026-05-04", "Groceries")\n    rows = database.fetchall("SELECT amount_cents FROM expenses ORDER BY id")\n    assert [row["amount_cents"] for row in rows] == [10, 20]\n    assert all(isinstance(row["amount_cents"], int) for row in rows)\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_budgets.py', 'source': '"""Budgets per category and their near-limit/over-limit warnings (REQ-004, REQ-005)."""\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom expensetracker.errors import ValidationError\nfrom expensetracker.models import BudgetLevel\n\n\ndef _status(service, category_name):\n    matches = [item for item in service.budget_overview() if item.category_name == category_name]\n    assert len(matches) == 1, f"expected exactly one budget row for {category_name}"\n    return matches[0]\n\n\ndef _spend(service, amount, category="Groceries", day=3):\n    return service.add_expense(amount, "2026-05-%02d" % day, category)\n\n\ndef test_req_004_set_budget_is_stored_and_shown(service):\n    budget = service.set_budget("Groceries", "300.00")\n    assert budget.amount_cents == 30000\n    assert budget.amount_display() == "300.00"\n\n    status = _status(service, "Groceries")\n    assert status.budget_cents == 30000\n    assert status.spent_cents == 0\n\n\ndef test_req_004_update_replaces_the_previous_budget(service, repositories):\n    first = service.set_budget("Groceries", "300.00")\n    second = service.set_budget("Groceries", "350.00")\n\n    assert second.id == first.id\n    assert second.amount_cents == 35000\n    assert second.amount_display() == "350.00"\n    assert [budget.amount_cents for budget in repositories.budgets.list_all()] == [35000]\n    assert _status(service, "Groceries").budget_cents == 35000\n\n\n@pytest.mark.parametrize("amount", [None, "", "abc", "-1.00", "0"])\ndef test_req_004_invalid_budget_saves_nothing(service, repositories, amount):\n    with pytest.raises(ValidationError) as info:\n        service.set_budget("Groceries", amount)\n    assert info.value.field == "amount"\n    assert info.value.message\n    assert repositories.budgets.list_all() == []\n    assert service.budget_overview() == []\n\n\ndef test_req_004_unknown_category_saves_nothing(service):\n    with pytest.raises(ValidationError) as info:\n        service.set_budget("Spaceships", "100.00")\n    assert info.value.field == "category"\n    assert service.budget_overview() == []\n\n\ndef test_req_005_near_limit_at_85_percent(service):\n    service.set_budget("Groceries", "100.00")\n    _spend(service, "85.00")\n\n    status = _status(service, "Groceries")\n    assert status.level is BudgetLevel.NEAR_LIMIT\n    assert status.spent_cents == 8500\n    assert status.percent_used() == 85.0\n    assert "85" in status.message()\n    assert "close" in status.message().lower()\n\n\ndef test_req_005_over_budget_above_100_percent(service):\n    service.set_budget("Groceries", "100.00")\n    _spend(service, "120.00")\n\n    status = _status(service, "Groceries")\n    assert status.level is BudgetLevel.OVER\n    assert status.spent_cents == 12000\n    assert status.percent_used() == 120.0\n    assert "over budget" in status.message().lower()\n\n\ndef test_req_005_no_warning_below_80_percent(service):\n    service.set_budget("Groceries", "100.00")\n    _spend(service, "40.00")\n\n    status = _status(service, "Groceries")\n    assert status.level is BudgetLevel.OK\n    assert status.percent_used() == 40.0\n    assert "close" not in status.message().lower()\n    assert "over" not in status.message().lower()\n\n\n@pytest.mark.parametrize(\n    "spent,level",\n    [\n        ("79.99", BudgetLevel.OK),\n        ("80.00", BudgetLevel.NEAR_LIMIT),\n        ("100.00", BudgetLevel.NEAR_LIMIT),\n        ("100.01", BudgetLevel.OVER),\n    ],\n)\ndef test_req_005_warning_level_boundaries(service, spent, level):\n    service.set_budget("Groceries", "100.00")\n    _spend(service, spent)\n    assert _status(service, "Groceries").level is level\n\n\ndef test_req_005_only_current_month_counts_against_budget(service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("95.00", "2026-04-15", "Groceries")\n    _spend(service, "10.00")\n\n    status = _status(service, "Groceries")\n    assert status.spent_cents == 1000\n    assert status.level is BudgetLevel.OK\n'}}]

