     \"title\": \"Rationale\",\n     \"type\": \"string\"\n    }\n   },\n   \"required\": [\n    \"name\",\n    \"kind\",\n    \"plantuml\",\n    \"rationale\"\n   ],\n   \"title\": \"DiagramItem\",\n   \"type\": \"object\"\n  }\n },\n \"properties\": {\n  \"notes\": {\n   \"description\": \"Shown in the chat, at most two short sentences (about 40 words): what changed and the one thing left open. Do not describe the diagrams\",\n   \"title\": \"Notes\",\n   \"type\": \"string\"\n  },\n  \"diagrams\": {\n   \"description\": \"The complete refined set, not only the changed diagrams\",\n   \"items\": {\n    \"$ref\": \"#/$defs/DiagramItem\"\n   },\n   \"minItems\": 1,\n   \"title\": \"Diagrams\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"notes\",\n  \"diagrams\"\n ],\n \"title\": \"RefinerOutput\",\n \"type\": \"object\"\n}"
