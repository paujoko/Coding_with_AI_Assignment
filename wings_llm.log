INPUT: {'path': 'todo/cli.py', 'source': '"""Command line front end (class diagram: Cli). Trace: REQ-001, REQ-002, REQ-003, REQ-004."""\n\nfrom collections.abc import Callable\nfrom datetime import date\n\nfrom todo.service import TaskService\n\nUSAGE = "usage: todo add <title> [--due YYYY-MM-DD] | todo list | todo done <number> | todo delete <number>"\n\n\nclass Cli:\n    def __init__(self, service: TaskService, out: Callable[[str], None] = print) -> None:\n        self._service = service\n        self._out = out\n\n    def run(self, args: list[str]) -> int:\n        if not args:\n            self._out(USAGE)\n            return 0\n        command, rest = args[0], args[1:]\n        try:\n            if command == "add" and rest:\n                due = date.fromisoformat(rest[rest.index("--due") + 1]) if "--due" in rest else None\n                title = " ".join(a for i, a in enumerate(rest) if a != "--due" and (i == 0 or rest[i - 1] != "--due"))\n                task = self._service.add(title, due)\n                self._out(f"Added {task.number}: {task.title}")\n            elif command == "list":\n                tasks = self._service.list()\n                self._out("\\n".join(self._line(t) for t in tasks) if tasks else "No tasks.")\n            elif command in ("done", "delete") and rest:\n                number = int(rest[0])\n                task = self._service.complete(number) if command == "done" else self._service.delete(number)\n                self._out(self._line(task) if command == "done" else f"Deleted {task.number}: {task.title}")\n            else:\n                self._out(USAGE)\n                return 2\n        except (LookupError, ValueError) as err:\n            self._out(str(err).strip("\'\\""))\n            return 1\n        return 0\n\n    @staticmethod\n    def _line(task) -> str:\n        due = f" (due {task.due.isoformat()})" if task.due else ""\n        return f"{task.number} {task.title}{due} [{\'done\' if task.done else \'open\'}]"\n'}
