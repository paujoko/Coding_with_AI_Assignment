            "arguments": "{\"path\": \"tests/test_labels.py\", \"source\": \"\\\"\\\"\\\"Labelled form fields and empty-state text in the served page (REQ-003, REQ-010).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport re\\n\\nFIELDS = {\\n    \\\"expense-amount\\\": \\\"Amount\\\",\\n    \\\"expense-date\\\": \\\"Date (YYYY-MM-DD)\\\",\\n    \\\"expense-category\\\": \\\"Category\\\",\\n    \\\"budget-category\\\": \\\"Category\\\",\\n    \\\"budget-amount\\\": \\\"Monthly budget amount\\\",\\n}\\n\\n\\ndef _page_html(client):\\n    status, _, body = client.raw(\\\"/\\\")\\n    assert status == 200\\n    return body.decode(\\\"utf-8\\\")\\n\\n\\ndef test_req_010_every_input_has_a_visible_label(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    for field_id, label_text in FIELDS.items():\\n        assert 'id=\\\"%s\\\"' % field_id in markup, \\\"missing input %s\\\" % field_id\\n        pattern = r'<label[^>]*for=\\\"%s\\\"[^>]*>(.*?)</label>' % re.escape(field_id)\\n        match = re.search(pattern, markup, re.S)\\n        assert match is not None, \\\"no label bound to %s\\\" % field_id\\n        text = re.sub(r\\\"<[^>]+>\\\", \\\"\\\", match.group(1)).strip()\\n        assert text, \\\"label for %s is empty\\\" % field_id\\n        assert text == label_text\\n\\n\\ndef test_req_010_page_has_a_message_area_for_feedback(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    match = re.search(r'<p id=\\\"message\\\"[^>]*>', markup)\\n    assert match is not None\\n    assert \\\"role=\\\" in match.group(0)\\n\\n\\ndef test_req_003_page_has_an_empty_state_for_the_expense_list(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    assert 'id=\\\"expense-empty\\\"' in markup\\n    assert \\\"No expenses recorded yet\\\" in markup\\n    assert 'id=\\\"expense-rows\\\"' in markup\\n\\n\\ndef test_req_004_page_has_an_empty_state_and_table_for_budgets(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    assert 'id=\\\"budget-rows\\\"' in markup\\n    assert 'id=\\\"budget-empty\\\"' in markup\\n    assert \\\"No budgets set yet\\\" in markup\\n\\n\\ndef test_req_006_page_has_a_summary_section(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    assert 'id=\\\"summary-total\\\"' in markup\\n    assert 'id=\\\"summary-categories\\\"' in markup\\n\\n\\ndef test_req_001_page_loads_its_own_script_and_style(live_server, client_factory):\\n    markup = _page_html(client_factory(live_server))\\n    assert 'src=\\\"/app.js\\\"' in markup\\n    assert 'href=\\\"/style.css\\\"' in markup\\n    assert \\\"http://\\\" not in markup.replace(\\\"http://www.w3.org\\\", \\\"\\\")\\n    assert \\\"https://\\\" not in markup\\n\"}"
