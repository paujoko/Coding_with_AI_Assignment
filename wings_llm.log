ss ApiHandler {\\n  + do_GET() : None\\n  + do_POST() : None\\n  + route_get(path : str) : tuple\\n  + route_post(path : str, body : dict) : tuple\\n  + send_json(status : int, payload : dict) : None\\n  + send_static(path : str) : None\\n}\\n\\nclass TrackerServer {\\n  + port : int\\n  + start() : None\\n}\\n\\nclass ValidationError {\\n  + field : str\\n  + message : str\\n}\\n\\nExpenseTrackerService o-- ExpenseRepository\\nExpenseTrackerService o-- BudgetRepository\\nExpenseTrackerService o-- CategoryRepository\\nExpenseTrackerService ..> Money\\nExpenseTrackerService ..> BudgetStatus\\nExpenseTrackerService ..> MonthlySummary\\nExpenseTrackerService ..> ValidationError\\nExpenseRepository --> AppDatabase\\nBudgetRepository --> AppDatabase\\nCategoryRepository --> AppDatabase\\nApiHandler --> ExpenseTrackerService\\nApiHandler ..> ValidationError\\nTrackerServer --> ApiHandler\\nExpense --> Category : categorised by >\\nBudget --> Category : limit for >\\nExpense --> Money\\nBudget --> Money\\nBudgetStatus --> Budget : reports on >\\nBudgetStatus --> Category : for >\\nMonthlySummary --> Expense : totals >\\n@enduml\", \"sequence_diagrams\": {\"Log expense\": \"@startuml\\nautonumber\\ntitle Log an expense (REQ-002, REQ-003)\\n\\nactor \\\"Local user\\\" as User\\nparticipant \\\"Browser page\\\" as Page\\nparticipant ApiHandler as Api\\nparticipant ExpenseTrackerService as Svc\\nparticipant ExpenseRepository as ExpRepo\\nparticipant CategoryRepository as CatRepo\\n\\nUser -> Page : fill amount 12.50, date 2026-05-03, category Groceries\\nPage -> Api : POST /api/expenses {amount, date, category}\\nApi -> Svc : add_expense(amount_text, date_text, category_name)\\nSvc -> CategoryRepository as C\\nSvc -> CatRepo : find_by_name(\\\"Groceries\\\")\\nCatRepo --> Svc : Category(id=1)\\nSvc -> Svc : Money.parse_amount(\\\"12.50\\\") -> 1250\\nSvc -> Svc : parse date 2026-05-03\\nSvc -> ExpRepo : insert(Expense)\\nExpRepo --> Svc : id = 7\\nSvc --> Api : Expense(7, 1250, 2026-05-03, Groceries)\\nApi --> Page : 201 {expense, amount_display \\\"12.50\\\"}\\nPage -> Api : GET /api/expenses\\nApi -> Svc : list_expenses()\\nSvc -> ExpRepo : list_newest_first()\\nExpRepo --> Svc : [Expense, ...]\\nSvc --> Api : list\\nApi --> Page : 200 {expenses: [...]}\\nPage --> User : show 12.50 on 2026-05-03 under Groceries + \\\"Expense saved\\\"\\n\\n@enduml\", \"Budget overview\": \"@startuml\\nautonumber\\ntitle View budget usage with warnings (REQ-004, REQ-005)\\n\\nactor \\\"Local user\\\" as User\\nparticipant \\\"Browser page\\\" as Page\\nparticipant ApiHandler as Api\\nparticipant ExpenseTrackerService as Svc\\nparticipant BudgetRepository as BudRepo\\nparticipant ExpenseRepository as ExpRepo\\nparticipant BudgetStatus as Status\\n\\nUser -> Page : open budget view\\nPage -> Api : GET /api/budgets\\nApi -> Svc : budget_overview()\\nSvc -> BudRepo : list_all()\\nBudRepo --> Svc : [Budget(Groceries, 10000), ...]\\nSvc -> ExpRepo : sum_by_category(2026, 5)\\nExpRepo --> Svc : {Groceries: 8500}\\nSvc -> Status : evaluate(\\\"Groceries\\\", 10000, 8500)\\nStatus -> Status : percent_used() = 85.0\\nStatus --> Svc : level = NEAR_LIMIT, \\\"85% of budget used\\\"\\nSvc --> Api : [BudgetStatus(Groceries, NEAR_LIMIT), ...]\\nApi --> Page : 200 {budgets: [{category, budget_display, spent_display, percent, level, message}]}\\nPage --> User : show Groceries 85.00 of 100.00, marked close to limit\\n\\n@enduml\", \"Set budget\": \"@startuml\\nautonumber\\ntitle Set or update a monthly budget (REQ-004, REQ-010)\\n\\nactor \\\"Local user\\\" as User\\nparticipant \\\"Browser page\\\" as Page\\nparticipant ApiHandler as Api\\nparticipant ExpenseTrackerService as Svc\\nparticipant CategoryRepository as CatRepo\\nparticipant BudgetRepository as BudRepo\\n\\nUser -> Page : enter budget 350.00 for Groceries\\nPage -> Api : POST /api/budgets {category, amount}\\nApi -> Svc : set_budget(\\\"Groceries\\\", \\\"350.00\\\")\\nSvc -> Svc : Money.parse_amount(\\\"350.00\\\") -> 35000\\nSvc -> CatRepo : find_by_name(\\\"Groceries\\\")\\nCatRepo --> Svc : Category(id=1)\\nSvc -> BudRepo : upsert(1, 35000)\\nBudRepo --> Svc : Budget(id=3, amount_cents=35000)\\nSvc --> Api : Budget\\nApi --> Page : 200 {budget_display \\\"350.00\\\"} + \\\"Budget saved\\\"\\nPage --> User : show Groceries budget 350.00\\n\\nnote over Api\\nIf parse_amount raises ValidationError,\\nrespond 400 {field: \\\"amount\\\", message: ...} and\\nno budget row is written.\\nend note\\n\\n@enduml\"}}"
