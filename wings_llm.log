ode or test\",\n   \"title\": \"Diagnosis\",\n   \"type\": \"string\"\n  },\n  \"cause\": {\n   \"description\": \"Where the mistake is\",\n   \"enum\": [\n    \"code\",\n    \"test\",\n    \"environment\"\n   ],\n   \"title\": \"Cause\",\n   \"type\": \"string\"\n  },\n  \"fix\": {\n   \"description\": \"The change that makes the tests pass, precise enough to hand to the developer agent\",\n   \"title\": \"Fix\",\n   \"type\": \"string\"\n  },\n  \"test_files\": {\n   \"description\": \"Only when cause is 'test': the corrected test files\",\n   \"items\": {\n    \"$ref\": \"#/$defs/TestFile\"\n   },\n   \"title\": \"Test Files\",\n   \"type\": \"array\"\n  }\n },\n \"required\": [\n  \"diagnosis\",\n  \"cause\",\n  \"fix\"\n ],\n \"title\": \"DebuggerOutput\",\n \"type\": \"object\"\n}"
