INPUT: {'path': 'tests/conftest.py', 'source': '"""Shared pytest fixtures for the local expense tracker.\n\nEvery test gets a fresh SQLite file in ``tmp_path`` and a service whose Clock is\npinned to 2026-05-15; API tests additionally get a real server on a free port.\nTrace: REQ-001, REQ-007\n"""\n\nfrom __future__ import annotations\n\nimport json\nimport threading\nfrom contextlib import contextmanager\nfrom datetime import date\nfrom types import SimpleNamespace\nfrom urllib.error import HTTPError\nfrom urllib.request import Request, urlopen\n\nimport pytest\n\nfrom expensetracker.api import ApiHandler\nfrom expensetracker.clock import Clock\nfrom expensetracker.database import AppDatabase\nfrom expensetracker.repositories import (\n    BudgetRepository,\n    CategoryRepository,\n    ExpenseRepository,\n)\nfrom expensetracker.server import TrackerServer\nfrom expensetracker.service import ExpenseTrackerService\n\n\nclass FixedClock(Clock):\n    """Clock pinned to 2026-05-15 so month filters are deterministic."""\n\n    def __init__(self, day: date = date(2026, 5, 15)) -> None:\n        self._day = day\n\n    def today(self) -> date:\n        return self._day\n\n    def current_month(self) -> str:\n        return self._day.strftime("%Y-%m")\n\n\ndef build_service(path, clock=None):\n    """Create the schema, seed the categories and wire a service for one file."""\n    database = AppDatabase(str(path))\n    database.create_schema()\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    service = ExpenseTrackerService(\n        ExpenseRepository(database),\n        BudgetRepository(database),\n        categories,\n        clock if clock is not None else FixedClock(),\n    )\n    return database, service\n\n\n@contextmanager\ndef running_server(service):\n    """Serve the JSON API on a free local port for the duration of the block."""\n    server = TrackerServer(port=0, handler=ApiHandler(service))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        yield "http://127.0.0.1:%d" % server._bound_port()\n    finally:\n        server._shutdown()\n        thread.join(timeout=5)\n\n\nclass ApiClient:\n    """Tiny JSON-over-HTTP client used by the API and page tests."""\n\n    def __init__(self, base_url: str) -> None:\n        self.base_url = base_url.rstrip("/")\n\n    def get(self, path: str):\n        try:\n            with urlopen(self.base_url + path, timeout=10) as response:\n                return response.status, json.loads(response.read().decode("utf-8") or "{}")\n        except HTTPError as error:\n            return error.code, json.loads(error.read().decode("utf-8") or "{}")\n\n    def post(self, path: str, payload: dict):\n        return self.post_raw(path, json.dumps(payload))\n\n    def post_raw(self, path: str, text: str):\n        request = Request(\n            self.base_url + path,\n            data=text.encode("utf-8"),\n            headers={"Content-Type": "application/json"},\n            method="POST",\n        )\n        try:\n            with urlopen(request, timeout=10) as response:\n                return response.status, json.loads(response.read().decode("utf-8") or "{}")\n        except HTTPError as error:\n            return error.code, json.loads(error.read().decode("utf-8") or "{}")\n\n    def raw(self, path: str):\n        try:\n            with urlopen(self.base_url + path, timeout=10) as response:\n                return (\n                    response.status,\n                    response.headers.get("Content-Type", ""),\n                    response.read(),\n                )\n        except HTTPError as error:\n            return error.code, error.headers.get("Content-Type", ""), error.read()\n\n\n@pytest.fixture\ndef database(tmp_path):\n    db = AppDatabase(str(tmp_path / "data" / "expense_tracker.db"))\n    db.create_schema()\n    return db\n\n\n@pytest.fixture\ndef repositories(database):\n    categories = CategoryRepository(database)\n    categories.seed_defaults()\n    return SimpleNamespace(\n        expenses=ExpenseRepository(database),\n        budgets=BudgetRepository(database),\n        categories=categories,\n    )\n\n\n@pytest.fixture\ndef service(repositories):\n    return ExpenseTrackerService(\n        repositories.expenses,\n        repositories.budgets,\n        repositories.categories,\n        FixedClock(),\n    )\n\n\n@pytest.fixture\ndef live_server(service):\n    with running_server(service) as base_url:\n        yield base_url\n\n\n@pytest.fixture\ndef api(live_server):\n    return ApiClient(live_server)\n\n\n@pytest.fixture\ndef client_factory():\n    return ApiClient\n\n\n@pytest.fixture\ndef service_builder():\n    return build_service\n\n\n@pytest.fixture\ndef server_runner():\n    return running_server\n'}
