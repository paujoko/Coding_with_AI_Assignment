            "arguments": "{\"path\": \"expensetracker/page.py\", \"source\": \"\\\"\\\"\\\"TrackerPage: the tracker page view, usable without a browser.\\n\\nImplements the TrackerPage class of the domain class diagram. The browser runs\\nthe same view in ``static/app.js`` against the same JSON API; this Python twin\\nrenders the expense list, the budget table, the monthly summary and the status\\nmessage into markup strings, so the page's operations exist as Python and are\\nexercised by ``python -m expensetracker --check``.\\nTrace: REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-010\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport html\\nimport json\\nfrom urllib.error import HTTPError\\nfrom urllib.request import Request, urlopen\\n\\nDEFAULT_BASE_URL = \\\"http://127.0.0.1:8000\\\"\\n\\n\\nclass TrackerPage:\\n    \\\"\\\"\\\"The page as a view object: JSON calls in, rendered parts out.\\n\\n    The rendered markup is kept in private fields so a caller (or a test) can\\n    inspect what the page would show, without needing a browser.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, base_url: str = DEFAULT_BASE_URL) -> None:\\n        self._base_url = (base_url or DEFAULT_BASE_URL).rstrip(\\\"/\\\")\\n        self._expense_rows: list[tuple[str, int, str]] = []\\n        self._budget_rows: list[str] = []\\n        self._summary_html = \\\"\\\"\\n        self._message_html = \\\"\\\"\\n\\n    # -- API access ---------------------------------------------------------\\n\\n    def callApi(self, method: str, path: str, body: dict | None = None) -> dict:\\n        \\\"\\\"\\\"Call the local JSON API and return the decoded payload.\\\"\\\"\\\"\\n        data = None\\n        headers: dict[str, str] = {}\\n        if body is not None:\\n            data = json.dumps(body).encode(\\\"utf-8\\\")\\n            headers[\\\"Content-Type\\\"] = \\\"application/json\\\"\\n        request = Request(self._base_url + path, data=data, headers=headers, method=method)\\n        try:\\n            with urlopen(request, timeout=10) as response:\\n                return json.loads(response.read().decode(\\\"utf-8\\\") or \\\"{}\\\")\\n        except HTTPError as error:\\n            return json.loads(error.read().decode(\\\"utf-8\\\") or \\\"{}\\\")\\n\\n    # -- rendering ----------------------------------------------------------\\n\\n    def renderExpenses(self, expenses: list) -> None:\\n        \\\"\\\"\\\"Replace the expense list with the given expenses (newest first).\\\"\\\"\\\"\\n        self._expense_rows = [\\n            (\\n                str(expense.get(\\\"date\\\", \\\"\\\")),\\n                int(expense.get(\\\"id\\\") or 0),\\n                self._build_row(expense),\\n            )\\n            for expense in expenses or []\\n        ]\\n\\n    def insertRow(self, expense: dict) -> None:\\n        \\\"\\\"\\\"Insert one saved expense at its date position without refetching.\\\"\\\"\\\"\\n        entry = (\\n            str(expense.get(\\\"date\\\", \\\"\\\")),\\n            int(expense.get(\\\"id\\\") or 0),\\n            self._build_row(expense),\\n        )\\n        for index, existing in enumerate(self._expense_rows):\\n            if existing[0] < entry[0] or (existing[0] == entry[0] and existing[1] < entry[1]):\\n                self._expense_rows.insert(index, entry)\\n                return\\n        self._expense_rows.append(entry)\\n\\n    def renderBudgets(self, statuses: list) -> None:\\n        \\\"\\\"\\\"Render each budgeted category with its usage and warning state.\\\"\\\"\\\"\\n        self._budget_rows = [self._build_budget_row(status) for status in statuses or []]\\n\\n    def renderSummary(self, summary: dict) -> None:\\n        \\\"\\\"\\\"Render the current month total and its per-category breakdown.\\\"\\\"\\\"\\n        month = html.escape(str(summary.get(\\\"month\\\", \\\"\\\")))\\n        total = html.escape(str(summary.get(\\\"total_display\\\", \\\"0.00\\\")))\\n        categories = summary.get(\\\"categories\\\") or []\\n        if categories:\\n            items = \\\"\\\".join(\\n                \\\"<li><span>\\\"\\n                + html.escape(str(category.get(\\\"name\\\", \\\"\\\")))\\n                + '</span><span class=\\\"amount\\\">'\\n                + html.escape(str(category.get(\\\"total_display\\\", \\\"0.00\\\")))\\n                + \\\"</span></li>\\\"\\n                for category in categories\\n            )\\n        else:\\n            items = '<li class=\\\"empty\\\">No spending recorded this month yet.</li>'\\n        self._summary_html = (\\n            '<p class=\\\"summary-total\\\">Total spent <span class=\\\"muted\\\">'\\n            + month\\n            + '</span>: <strong>'\\n            + total\\n            + '</strong></p><ul class=\\\"summary-list\\\">'\\n            + items\\n            + \\\"</ul>\\\"\\n        )\\n\\n    def showMessage(self, text: str, is_error: bool) -> None:\\n        \\\"\\\"\\\"Show a plain-language confirmation or validation message.\\\"\\\"\\\"\\n        if not text:\\n            self._message_html = \\\"\\\"\\n            return\\n        css_class = \\\"message error\\\" if is_error else \\\"message success\\\"\\n        role = \\\"alert\\\" if is_error else \\\"status\\\"\\n        self._message_html = (\\n            f'<p class=\\\"{css_class}\\\" role=\\\"{role}\\\">{html.escape(str(text))}</p>'\\n        )\\n\\n    # -- helpers ------------------------------------------------------------\\n\\n    def _build_row(self, expense: dict) -> str:\\n        \\\"\\\"\\\"One table row for an expense: date, category and amount.\\\"\\\"\\\"\\n        date_cell = html.escape(str(expense.get(\\\"date\\\", \\\"\\\")))\\n        category_cell = html.escape(str(expense.get(\\\"category\\\", \\\"\\\")))\\n        amount_cell = html.escape(str(expense.get(\\\"amount_display\\\", \\\"0.00\\\")))\\n        return (\\n            f\\\"<tr><td>{date_cell}</td><td>{category_cell}</td>\\\"\\n            f'<td class=\\\"amount\\\">{amount_cell}</td></tr>'\\n        )\\n\\n    def _build_budget_row(self, status: dict) -> str:\\n        \\\"\\\"\\\"One table row for a budget: category, budget, spent and status text.\\\"\\\"\\\"\\n        level = str(status.get(\\\"level\\\", \\\"OK\\\")).lower()\\n        message = html.escape(str(status.get(\\\"message\\\", \\\"\\\")))\\n        badge = \\\"\\\"\\n        if level != \\\"ok\\\":\\n            label = \\\"Over budget\\\" if level == \\\"over\\\" else \\\"Close to limit\\\"\\n            badge = f'<span class=\\\"badge\\\">{label}</span>'\\n        category_cell = html.escape(str(status.get(\\\"category\\\", \\\"\\\")))\\n        budget_cell = html.escape(str(status.get(\\\"budget_display\\\", \\\"0.00\\\")))\\n        spent_cell = html.escape(str(status.get(\\\"spent_display\\\", \\\"0.00\\\")))\\n        return (\\n            f'<tr class=\\\"level-{level}\\\"><td>{category_cell}</td>'\\n            f'<td class=\\\"amount\\\">{budget_cell}</td>'\\n            f'<td class=\\\"amount\\\">{spent_cell}</td>'\\n            f'<td class=\\\"budget-message\\\">{badge}{message}</td></tr>'\\n        )\\n\"}"
