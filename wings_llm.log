            "name": "check_python",
            "arguments": "{\"path\": \"tests/test_api.py\", \"source\": \"\\\"\\\"\\\"JSON API handlers over a real local server (REQ-002..REQ-006, REQ-010).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport json\\n\\n\\ndef test_req_001_serves_the_tracker_page(live_server, client_factory):\\n    client = client_factory(live_server)\\n    status, content_type, body = client.raw(\\\"/\\\")\\n    assert status == 200\\n    assert \\\"text/html\\\" in content_type\\n    text = body.decode(\\\"utf-8\\\")\\n    assert \\\"Expense Tracker\\\" in text\\n    assert 'id=\\\"expense-form\\\"' in text\\n\\n    for asset, expected in ((\\\"/app.js\\\", \\\"text/javascript\\\"), (\\\"/style.css\\\", \\\"text/css\\\")):\\n        asset_status, asset_type, _ = client.raw(asset)\\n        assert asset_status == 200\\n        assert expected in asset_type\\n\\n\\ndef test_req_001_static_path_traversal_is_rejected(api):\\n    status, _, _ = api.raw(\\\"/../expensetracker/app.py\\\")\\n    assert status == 404\\n\\n\\ndef test_req_001_unknown_api_route_is_404(api):\\n    status, payload = api.get(\\\"/api/unknown\\\")\\n    assert status == 404\\n    assert \\\"error\\\" in payload\\n\\n\\ndef test_req_002_post_expense_returns_201_and_payload(api):\\n    status, payload = api.post(\\n        \\\"/api/expenses\\\", {\\\"amount\\\": \\\"12.50\\\", \\\"date\\\": \\\"2026-05-03\\\", \\\"category\\\": \\\"Groceries\\\"}\\n    )\\n    assert status == 201\\n    assert payload[\\\"id\\\"] > 0\\n    assert payload[\\\"amount_display\\\"] == \\\"12.50\\\"\\n    assert payload[\\\"date\\\"] == \\\"2026-05-03\\\"\\n    assert payload[\\\"category\\\"] == \\\"Groceries\\\"\\n\\n    list_status, listing = api.get(\\\"/api/expenses\\\")\\n    assert list_status == 200\\n    assert [item[\\\"id\\\"] for item in listing[\\\"expenses\\\"]] == [payload[\\\"id\\\"]]\\n\\n\\ndef test_req_002_invalid_amount_returns_400_field_and_message(api):\\n    status, payload = api.post(\\n        \\\"/api/expenses\\\", {\\\"amount\\\": \\\"abc\\\", \\\"date\\\": \\\"2026-05-03\\\", \\\"category\\\": \\\"Groceries\\\"}\\n    )\\n    assert status == 400\\n    assert payload[\\\"field\\\"] == \\\"amount\\\"\\n    assert payload[\\\"message\\\"]\\n    assert api.get(\\\"/api/expenses\\\")[1][\\\"expenses\\\"] == []\\n\\n\\ndef test_req_002_invalid_date_returns_400_and_saves_nothing(api):\\n    status, payload = api.post(\\n        \\\"/api/expenses\\\", {\\\"amount\\\": \\\"12.50\\\", \\\"date\\\": \\\"2026-02-31\\\", \\\"category\\\": \\\"Groceries\\\"}\\n    )\\n    assert status == 400\\n    assert payload[\\\"field\\\"] == \\\"date\\\"\\n    assert api.get(\\\"/api/expenses\\\")[1][\\\"expenses\\\"] == []\\n\\n\\ndef test_req_002_malformed_json_body_is_400(api):\\n    status, payload = api.post_raw(\\\"/api/expenses\\\", \\\"{not json\\\")\\n    assert status == 400\\n    assert payload[\\\"field\\\"] == \\\"body\\\"\\n\\n\\ndef test_req_003_get_expenses_is_newest_first_with_fields(api, service):\\n    service.add_expense(\\\"10.00\\\", \\\"2026-04-28\\\", \\\"Utilities\\\")\\n    service.add_expense(\\\"20.00\\\", \\\"2026-05-09\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"30.00\\\", \\\"2026-05-01\\\", \\\"Transport\\\")\\n\\n    status, payload = api.get(\\\"/api/expenses\\\")\\n    assert status == 200\\n    expenses = payload[\\\"expenses\\\"]\\n    assert [item[\\\"date\\\"] for item in expenses] == [\\\"2026-05-09\\\", \\\"2026-05-01\\\", \\\"2026-04-28\\\"]\\n    assert [item[\\\"amount_display\\\"] for item in expenses] == [\\\"20.00\\\", \\\"30.00\\\", \\\"10.00\\\"]\\n    assert [item[\\\"category\\\"] for item in expenses] == [\\\"Groceries\\\", \\\"Transport\\\", \\\"Utilities\\\"]\\n\\n\\ndef test_req_003_empty_expense_list_is_empty_array(api):\\n    status, payload = api.get(\\\"/api/expenses\\\")\\n    assert status == 200\\n    assert payload[\\\"expenses\\\"] == []\\n\\n\\ndef test_req_004_post_budget_saves_and_lists_it(api):\\n    status, payload = api.post(\\\"/api/budgets\\\", {\\\"category\\\": \\\"Groceries\\\", \\\"amount\\\": \\\"300.00\\\"})\\n    assert status == 200\\n    assert payload[\\\"category\\\"] == \\\"Groceries\\\"\\n    assert payload[\\\"budget_display\\\"] == \\\"300.00\\\"\\n\\n    budgets = api.get(\\\"/api/budgets\\\")[1][\\\"budgets\\\"]\\n    assert len(budgets) == 1\\n    assert budgets[0][\\\"budget_display\\\"] == \\\"300.00\\\"\\n\\n\\ndef test_req_004_second_budget_overwrites_first(api):\\n    api.post(\\\"/api/budgets\\\", {\\\"category\\\": \\\"Groceries\\\", \\\"amount\\\": \\\"300.00\\\"})\\n    status, payload = api.post(\\\"/api/budgets\\\", {\\\"category\\\": \\\"Groceries\\\", \\\"amount\\\": \\\"350.00\\\"})\\n    assert status == 200\\n    assert payload[\\\"budget_display\\\"] == \\\"350.00\\\"\\n\\n    budgets = api.get(\\\"/api/budgets\\\")[1][\\\"budgets\\\"]\\n    assert [item[\\\"budget_display\\\"] for item in budgets] == [\\\"350.00\\\"]\\n\\n\\ndef test_req_004_negative_budget_is_400_and_not_saved(api):\\n    status, payload = api.post(\\\"/api/budgets\\\", {\\\"category\\\": \\\"Groceries\\\", \\\"amount\\\": \\\"-10\\\"})\\n    assert status == 400\\n    assert payload[\\\"field\\\"] == \\\"amount\\\"\\n    assert api.get(\\\"/api/budgets\\\")[1][\\\"budgets\\\"] == []\\n\\n\\ndef test_req_005_budget_overview_levels(api, service):\\n    service.set_budget(\\\"Groceries\\\", \\\"100.00\\\")\\n    service.set_budget(\\\"Transport\\\", \\\"100.00\\\")\\n    service.set_budget(\\\"Utilities\\\", \\\"100.00\\\")\\n    service.add_expense(\\\"85.00\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"120.00\\\", \\\"2026-05-02\\\", \\\"Transport\\\")\\n    service.add_expense(\\\"40.00\\\", \\\"2026-05-02\\\", \\\"Utilities\\\")\\n\\n    status, payload = api.get(\\\"/api/budgets\\\")\\n    assert status == 200\\n    by_name = {item[\\\"category\\\"]: item for item in payload[\\\"budgets\\\"]}\\n    assert by_name[\\\"Groceries\\\"][\\\"level\\\"] == \\\"NEAR_LIMIT\\\"\\n    assert by_name[\\\"Groceries\\\"][\\\"spent_display\\\"] == \\\"85.00\\\"\\n    assert by_name[\\\"Groceries\\\"][\\\"percent\\\"] == 85.0\\n    assert by_name[\\\"Transport\\\"][\\\"level\\\"] == \\\"OVER\\\"\\n    assert by_name[\\\"Utilities\\\"][\\\"level\\\"] == \\\"OK\\\"\\n\\n\\ndef test_req_006_summary_endpoint(api, service):\\n    service.add_expense(\\\"40.00\\\", \\\"2026-05-02\\\", \\\"Groceries\\\")\\n    service.add_expense(\\\"60.00\\\", \\\"2026-05-20\\\", \\\"Transport\\\")\\n    service.add_expense(\\\"500.00\\\", \\\"2026-04-02\\\", \\\"Groceries\\\")\\n\\n    status, payload = api.get(\\\"/api/summary\\\")\\n    assert status == 200\\n    assert payload[\\\"month\\\"] == \\\"2026-05\\\"\\n    assert payload[\\\"total_display\\\"] == \\\"100.00\\\"\\n    totals = {item[\\\"name\\\"]: item[\\\"total_display\\\"] for item in payload[\\\"categories\\\"]}\\n    assert totals == {\\\"Groceries\\\": \\\"40.00\\\", \\\"Transport\\\": \\\"60.00\\\"}\\n\\n\\ndef test_req_010_error_payload_names_field_and_reason(api):\\n    status, payload = api.post(\\n        \\\"/api/expenses\\\", {\\\"amount\\\": \\\"\\\", \\\"date\\\": \\\"2026-05-03\\\", \\\"category\\\": \\\"Groceries\\\"}\\n    )\\n    assert status == 400\\n    assert payload[\\\"field\\\"] == \\\"amount\\\"\\n    assert isinstance(payload[\\\"message\\\"], str) and payload[\\\"message\\\"].strip()\\n    assert json.dumps(payload).count(\\\"Traceback\\\") == 0\\n\\n\\ndef test_req_010_categories_endpoint_lists_seven_fixed_categories(api):\\n    status, payload = api.get(\\\"/api/categories\\\")\\n    assert status == 200\\n    names = [item[\\\"name\\\"] for item in payload[\\\"categories\\\"]]\\n    assert names == [\\n        \\\"Groceries\\\",\\n        \\\"Rent\\\",\\n        \\\"Transport\\\",\\n        \\\"Utilities\\\",\\n        \\\"Entertainment\\\",\\n        \\\"Health\\\",\\n        \\\"Other\\\",\\n    ]\\n\"}"
