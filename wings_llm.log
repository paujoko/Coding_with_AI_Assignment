            "arguments": "{\"path\": \"expensetracker/static/style.css\", \"source\": \"/*\\n * Styles for the tracker page.\\n * Implements the presentation of the TrackerPage view.\\n * Trace: REQ-005, REQ-010\\n */\\n\\n:root {\\n  --ink: #1d2433;\\n  --muted: #65708a;\\n  --line: #dfe3ec;\\n  --ok: #2f7d4f;\\n  --near: #a86a00;\\n  --over: #b3261e;\\n  --accent: #2c5fa8;\\n  --bg: #f5f6fa;\\n}\\n\\n* {\\n  box-sizing: border-box;\\n}\\n\\nbody {\\n  margin: 0;\\n  padding: 0 0 3rem;\\n  font-family: system-ui, -apple-system, \\\"Segoe UI\\\", Roboto, sans-serif;\\n  color: var(--ink);\\n  background: var(--bg);\\n  line-height: 1.45;\\n}\\n\\n.page-header {\\n  padding: 1.5rem 1.5rem 0.5rem;\\n  max-width: 62rem;\\n  margin: 0 auto;\\n}\\n\\nh1 {\\n  font-size: 1.6rem;\\n  margin: 0 0 0.5rem;\\n}\\n\\nh2 {\\n  font-size: 1.15rem;\\n  margin: 0 0 1rem;\\n}\\n\\nmain {\\n  max-width: 62rem;\\n  margin: 0 auto;\\n  padding: 0 1.5rem;\\n  display: grid;\\n  gap: 1.25rem;\\n  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));\\n  align-items: start;\\n}\\n\\n.card {\\n  background: #fff;\\n  border: 1px solid var(--line);\\n  border-radius: 0.6rem;\\n  padding: 1.25rem;\\n}\\n\\n.field {\\n  display: flex;\\n  flex-direction: column;\\n  gap: 0.25rem;\\n  margin-bottom: 0.85rem;\\n}\\n\\nlabel {\\n  font-weight: 600;\\n  font-size: 0.9rem;\\n}\\n\\ninput,\\nselect,\\nbutton {\\n  font: inherit;\\n  padding: 0.5rem 0.6rem;\\n  border-radius: 0.4rem;\\n  border: 1px solid var(--line);\\n  background: #fff;\\n  color: inherit;\\n}\\n\\ninput:focus,\\nselect:focus,\\nbutton:focus-visible {\\n  outline: 2px solid var(--accent);\\n  outline-offset: 1px;\\n}\\n\\nbutton {\\n  background: var(--accent);\\n  border-color: var(--accent);\\n  color: #fff;\\n  font-weight: 600;\\n  cursor: pointer;\\n}\\n\\nbutton:hover {\\n  filter: brightness(1.08);\\n}\\n\\n.message {\\n  margin: 0;\\n  padding: 0.6rem 0.8rem;\\n  border-radius: 0.45rem;\\n  font-weight: 600;\\n}\\n