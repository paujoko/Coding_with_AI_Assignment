            "name": "check_python",
            "arguments": "{\"path\": \"tests/test_persistence.py\", \"source\": \"\\\"\\\"\\\"SQLite storage: creation on first run and survival across restarts (REQ-007, REQ-001).\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport http.client\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom expensetracker.repositories import CategoryRepository\\n\\n\\ndef test_req_007_schema_creates_file_on_first_run(tmp_path):\\n    from expensetracker.database import AppDatabase\\n\\n    path = tmp_path / \\\"data\\\" / \\\"expense_tracker.db\\\"\\n    assert not path.exists()\\n    database = AppDatabase(str(path))\\n    database.create_schema()\\n    assert path.is_file()\\n\\n    categories = CategoryRepository(database)\\n    assert categories.list_all() == []\\n    categories.seed_defaults()\\n    assert len(categories.list_all()) == 7\\n    assert \\\"Groceries\\\" in [category.name for category in categories.list_all()]\\n\\n\\ndef test_req_007_seeding_twice_keeps_seven_categories(database):\\n    categories = CategoryRepository(database)\\n    categories.seed_defaults()\\n    categories.seed_defaults()\\n    assert len(categories.list_all()) == 7\\n\\n\\ndef test_req_007_expenses_and_budgets_survive_reopen(tmp_path, service_builder):\\n    path = tmp_path / \\\"expense_tracker.db\\\"\\n    _, first = service_builder(path)\\n    first.add_expense(\\\"12.50\\\", \\\"2026-05-03\\\", \\\"Groceries\\\")\\n    first.set_budget(\\\"Groceries\\\", \\\"300.00\\\")\\n\\n    _, second = service_builder(path)\\n    expenses = second.list_expenses()\\n    assert len(expenses) == 1\\n    assert expenses[0].amount_display() == \\\"12.50\\\"\\n    assert expenses[0].spent_on.isoformat() == \\\"2026-05-03\\\"\\n\\n    budgets = second.budget_overview()\\n    assert len(budgets) == 1\\n    assert budgets[0].category_name == \\\"Groceries\\\"\\n    assert budgets[0].budget_cents == 30000\\n\\n\\ndef test_req_007_fresh_database_starts_with_empty_expense_list(tmp_path, service_builder):\\n    _, service = service_builder(tmp_path / \\\"brand_new.db\\\")\\n    assert service.list_expenses() == []\\n    assert service.budget_overview() == []\\n    assert service.monthly_summary().total_display() == \\\"0.00\\\"\\n\\n\\ndef _free_port() -> int:\\n    import socket\\n\\n    with socket.socket() as sock:\\n        sock.bind((\\\"127.0.0.1\\\", 0))\\n        return int(sock.getsockname()[1])\\n\\n\\ndef _wait_for_server(port: int, timeout: float = 20.0) -> None:\\n    deadline = time.time() + timeout\\n    while time.time() < deadline:\\n        try:\\n            connection = http.client.HTTPConnection(\\\"127.0.0.1\\\", port, timeout=1)\\n            connection.request(\\\"GET\\\", \\\"/api/categories\\\")\\n            connection.getresponse().read()\\n            connection.close()\\n            return\\n        except OSError:\\n            time.sleep(0.05)\\n    raise AssertionError(\\\"server did not start within %.0fs\\\" % timeout)\\n\\n\\ndef _start_server(port: int, home: Path) -> subprocess.Popen:\\n    env = dict(os.environ)\\n    env[\\\"HOME\\\"] = str(home)\\n    proc = subprocess.Popen(\\n        [sys.executable, \\\"-m\\\", \\\"expensetracker\\\", \\\"--port\\\", str(port)],\\n        cwd=str(Path(__file__).resolve().parent.parent),\\n        env=env,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.STDOUT,\\n    )\\n    _wait_for_server(port)\\n    return proc\\n\\n\\ndef _post(port: int, path: str, payload: dict) -> tuple[int, dict]:\\n    connection = http.client.HTTPConnection(\\\"127.0.0.1\\\", port, timeout=10)\\n    body = json.dumps(payload).encode(\\\"utf-8\\\")\\n    connection.request(\\n        \\\"POST\\\", path, body=body, headers={\\\"Content-Type\\\": \\\"application/json\\\"}\\n    )\\n    response = connection.getresponse()\\n    data = json.loads(response.read().decode(\\\"utf-8\\\") or \\\"{}\\\")\\n    status = response.status\\n    connection.close()\\n    return status, data\\n\\n\\ndef _get(port: int, path: str):\\n    connection = http.client.HTTPConnection(\\\"127.0.0.1\\\", port, timeout=10)\\n    connection.request(\\\"GET\\\", path)\\n    response = connection.getresponse()\\n    data = json.loads(response.read().decode(\\\"utf-8\\\") or \\\"{}\\\")\\n    status = response.status\\n    connection.close()\\n    return status, data\\n\\n\\ndef test_req_001_python_dash_m_starts_the_served_page(tmp_path):\\n    port = _free_port()\\n    proc = _start_server(port, tmp_path)\\n    try:\\n        connection = http.client.HTTPConnection(\\\"127.0.0.1\\\", port, timeout=10)\\n        connection.request(\\\"GET\\\", \\\"/\\\")\\n        response = connection.getresponse()\\n        body = response.read().decode(\\\"utf-8\\\")\\n        content_type = response.headers.get(\\\"Content-Type\\\", \\\"\\\")\\n        connection.close()\\n        assert response.status == 200\\n        assert \\\"text/html\\\" in content_type\\n        assert \\\"Expense Tracker\\\" in body\\n    finally:\\n        proc.terminate()\\n        proc.wait(timeout=10)\\n\\n\\ndef test_req_007_restarted_server_still_serves_saved_data(tmp_path):\\n    port = _free_port()\\n    proc = _start_server(port, tmp_path)\\n    try:\\n        status, created = _post(\\n            port,\\n            \\\"/api/expenses\\\",\\n            {\\\"amount\\\": \\\"12.50\\\", \\\"date\\\": \\\"2026-05-03\\\", \\\"category\\\": \\\"Groceries\\\"},\\n        )\\n        assert status == 201\\n        assert _post(port, \\\"/api/budgets\\\", {\\\"category\\\": \\\"Groceries\\\", \\\"amount\\\": \\\"300.00\\\"})[0] == 200\\n    finally:\\n        proc.terminate()\\n        proc.wait(timeout=10)\\n\\n    proc = _start_server(port, tmp_path)\\n    try:\\n        expenses = _get(port, \\\"/api/expenses\\\")[1][\\\"expenses\\\"]\\n        assert [item[\\\"amount_display\\\"] for item in expenses] == [\\\"12.50\\\"]\\n        budgets = _get(port, \\\"/api/budgets\\\")[1][\\\"budgets\\\"]\\n        assert [item[\\\"budget_display\\\"] for item in budgets] == [\\\"300.00\\\"]\\n    finally:\\n        proc.terminate()\\n        proc.wait(timeout=10)\\n\"}"
          }
        }
