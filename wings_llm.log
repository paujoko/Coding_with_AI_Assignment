INPUT: {'files': {'todo/__init__.py': '"""A command-line to-do list for one user (generated by Wings from the approved design)."""\n', 'todo/__main__.py': '"""Entry point: python -m todo <command>. The data file is tasks.json, or TODO_FILE if set."""\n\nimport os\nimport sys\n\nfrom todo.cli import Cli\nfrom todo.repository import JsonTaskRepository\nfrom todo.service import TaskService\n\n\ndef main() -> int:\n    repository = JsonTaskRepository(os.environ.get("TODO_FILE", "tasks.json"))\n    return Cli(TaskService(repository)).run(sys.argv[1:])\n\n\nif __name__ == "__main__":\n    sys.exit(main())\n', 'todo/cli.py': '"""Command line front end (class diagram: Cli). Trace: REQ-001, REQ-002, REQ-003, REQ-004."""\n\nfrom collections.abc import Callable\nfrom datetime import date\n\nfrom todo.service import TaskService\n\nUSAGE = "usage: todo add <title> [--due YYYY-MM-DD] | todo list | todo done <number> | todo delete <number>"\n\n\nclass Cli:\n    def __init__(self, service: TaskService, out: Callable[[str], None] = print) -> None:\n        self._service = service\n        self._out = out\n\n    def run(self, args: list[str]) -> int:\n        if not args:\n            self._out(USAGE)\n            return 0\n        command, rest = args[0], args[1:]\n        try:\n            if command == "add" and rest:\n                due = date.fromisoformat(rest[rest.index("--due") + 1]) if "--due" in rest else None\n                title = " ".join(a for i, a in enumerate(rest) if a != "--due" and (i == 0 or rest[i - 1] != "--due"))\n                task = self._service.add(title, due)\n                self._out(f"Added {task.number}: {task.title}")\n            elif command == "list":\n                tasks = self._service.list()\n                self._out("\\n".join(self._line(t) for t in tasks) if tasks else "No tasks.")\n            elif command in ("done", "delete") and rest:\n                number = int(rest[0])\n                task = self._service.complete(number) if command == "done" else self._service.delete(number)\n                self._out(self._line(task) if command == "done" else f"Deleted {task.number}: {task.title}")\n            else:\n                self._out(USAGE)\n                return 2\n        except (LookupError, ValueError) as err:\n            self._out(str(err).strip("\'\\""))\n            return 1\n        return 0\n\n    @staticmethod\n    def _line(task) -> str:\n        due = f" (due {task.due.isoformat()})" if task.due else ""\n        return f"{task.number} {task.title}{due} [{\'done\' if task.done else \'open\'}]"\n', 'todo/models.py': '"""Task: a plain value object (class diagram: Task). Trace: REQ-001, REQ-003."""\n\nfrom dataclasses import dataclass\nfrom datetime import date\n\n\n@dataclass\nclass Task:\n    number: int\n    title: str\n    due: date | None = None\n    done: bool = False\n', 'todo/repository.py': '"""Where tasks are kept (class diagram: TaskRepository, JsonTaskRepository). Trace: REQ-005."""\n\nimport json\nfrom abc import ABC, abstractmethod\nfrom datetime import date\nfrom pathlib import Path\n\nfrom todo.models import Task\n\n\nclass TaskRepository(ABC):\n    @abstractmethod\n    def load(self) -> list[Task]: ...\n\n    @abstractmethod\n    def save(self, tasks: list[Task]) -> None: ...\n\n    def next_number(self) -> int:\n        """Numbers stay unique across runs because they come from the stored tasks (review F1)."""\n        return max((t.number for t in self.load()), default=0) + 1\n\n\nclass JsonTaskRepository(TaskRepository):\n    def __init__(self, path: str = "tasks.json") -> None:\n        self.path = path\n\n    def load(self) -> list[Task]:\n        file = Path(self.path)\n        if not file.exists():\n            return []\n        raw = json.loads(file.read_text(encoding="utf-8"))\n        return [\n            Task(number=t["number"], title=t["title"], due=date.fromisoformat(t["due"]) if t.get("due") else None, done=t["done"])\n            for t in raw\n        ]\n\n    def save(self, tasks: list[Task]) -> None:\n        data = [{"number": t.number, "title": t.title, "due": t.due.isoformat() if t.due else None, "done": t.done} for t in tasks]\n        Path(self.path).write_text(json.dumps(data, indent=2), encoding="utf-8")\n', 'todo/service.py': '"""The use cases (class diagram: TaskService). Trace: REQ-001, REQ-002, REQ-003, REQ-004, REQ-005."""\n\nfrom __future__ import annotations  # the method named list must not hide the built-in in annotations\n\nfrom datetime import date\n\nfrom todo.models import Task\nfrom todo.repository import TaskRepository\n\n\nclass TaskService:\n    def __init__(self, repository: TaskRepository) -> None:\n        self._repository = repository\n\n    def add(self, title: str, due: date | None = None) -> Task:\n        tasks = self._repository.load()\n        task = Task(number=self._repository.next_number(), title=title, due=due)\n        tasks.append(task)\n        self._repository.save(tasks)\n        return task\n\n    def list(self) -> list[Task]:\n        return sorted(self._repository.load(), key=lambda t: t.number)\n\n    def complete(self, number: int) -> Task:\n        tasks = self._repository.load()\n        task = self._find(tasks, number)\n        task.done = True\n        self._repository.save(tasks)\n        return task\n\n    def delete(self, number: int) -> Task:\n        tasks = self._repository.load()\n        task = self._find(tasks, number)\n        tasks.remove(task)\n        self._repository.save(tasks)\n        return task\n\n    @staticmethod\n    def _find(tasks: list[Task], number: int) -> Task:\n        for task in tasks:\n            if task.number == number:\n                return task\n        raise LookupError(f"No task number {number}")\n'}}
