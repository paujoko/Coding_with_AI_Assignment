pense("30.00", "2026-05-01", "Transport")\n\n    page = _page(live_server)\n    payload = page.callApi("GET", "/api/expenses")\n    page.renderExpenses(payload["expenses"])\n\n    rows = page._expense_rows\n    assert [row[0] for row in rows] == ["2026-05-09", "2026-05-01", "2026-04-28"]\n    assert "Groceries" in rows[0][2] and "20.00" in rows[0][2]\n    assert "Transport" in rows[1][2] and "30.00" in rows[1][2]\n    assert "Utilities" in rows[2][2] and "10.00" in rows[2][2]\n\n\ndef test_req_003_page_renders_no_rows_when_list_empty(live_server):\n    page = _page(live_server)\n    page.renderExpenses(page.callApi("GET", "/api/expenses")["expenses"])\n    assert page._expense_rows == []\n\n\ndef test_req_002_page_inserts_saved_expense_in_date_order(live_server):\n    service_page = _page(live_server)\n    service_page.renderExpenses([])\n    first = service_page.callApi(\n        "POST", "/api/expenses", {"amount": "5.00", "date": "2026-05-01", "category": "Health"}\n    )\n    service_page.insertRow(first)\n    second = service_page.callApi(\n        "POST", "/api/expenses", {"amount": "6.00", "date": "2026-05-20", "category": "Rent"}\n    )\n    service_page.insertRow(second)\n\n    saved = service_page.callApi(\n        "POST", "/api/expenses", {"amount": "7.50", "date": "2026-05-10", "category": "Other"}\n    )\n    service_page.insertRow(saved)\n\n    assert [row[0] for row in service_page._expense_rows] == [\n        "2026-05-20",\n        "2026-05-10",\n        "2026-05-01",\n    ]\n    assert "7.50" in service_page._expense_rows[1][2]\n\n\ndef test_req_005_page_renders_budget_warning_states(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("85.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "Groceries" in row\n    assert "100.00" in row\n    assert "85.00" in row\n    assert "level-near_limit" in row\n    assert "Close to limit" in row\n\n\ndef test_req_005_page_renders_over_budget_state(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("120.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "level-over" in row\n    assert "Over budget" in row\n\n\ndef test_req_005_page_renders_no_badge_when_within_limit(live_server, service):\n    service.set_budget("Groceries", "100.00")\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n\n    page = _page(live_server)\n    page.renderBudgets(page.callApi("GET", "/api/budgets")["budgets"])\n    row = page._budget_rows[0]\n    assert "level-ok" in row\n    assert "badge" not in row\n\n\ndef test_req_006_page_renders_summary(live_server, service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("60.00", "2026-05-20", "Transport")\n\n    page = _page(live_server)\n    page.renderSummary(page.callApi("GET", "/api/summary"))\n    markup = page._summary_html\n    assert "100.00" in markup\n    assert "2026-05" in markup\n    assert "Groceries" in markup and "40.00" in markup\n    assert "Transport" in markup and "60.00" in markup\n\n\ndef test_req_006_page_summary_empty_state(live_server):\n    page = _page(live_server)\n    page.renderSummary(page.callApi("GET", "/api/summary"))\n    assert "No spending recorded this month yet." in page._summary_html\n    assert "0.00" in page._summary_html\n\n\ndef test_req_010_page_shows_success_and_error_messages(live_server):\n    page = _page(live_server)\n    page.showMessage("Expense saved.", False)\n    assert "message success" in page._message_html\n    assert \'role="status"\' in page._message_html\n\n    page.showMessage("Amount: Amount must be greater than zero.", True)\n    assert "message error" in page._message_html\n    assert \'role="alert"\' in page._message_html\n    assert "Amount must be greater than zero." in page._message_html\n\n\ndef test_req_010_page_escapes_untrusted_text(live_server):\n    page = _page(live_server)\n    page.renderExpenses(\n        [{"id": 1, "date": "2026-05-02", "category": "<script>x</script>", "amount_display": "1.00"}]\n    )\n    assert "<script>" not in page._expense_rows[0][2]\n    assert "&lt;script&gt;" in page._expense_rows[0][2]\n\n\ndef test_req_010_page_returns_error_payload_on_validation_failure(live_server):\n    page = _page(live_server)\n    result = page.callApi(\n        "POST", "/api/expenses", {"amount": "0", "date": "2026-05-02", "category": "Groceries"}\n    )\n    assert result["field"] == "amount"\n    assert result["message"]\n'}}, {'name': 'check_python', 'args': {'path': 'tests/test_summary.py', 'source': '"""Monthly spending summary by category (REQ-006, REQ-008, REQ-009)."""\n\nfrom __future__ import annotations\n\nimport time\n\nfrom expensetracker.models import MonthlySummary\n\n\ndef _seed_expenses(database, count=10000):\n    """Insert ``count`` expenses quickly in a single transaction."""\n    connection = database.connect()\n    try:\n        connection.executemany(\n            "INSERT INTO expenses (amount_cents, spent_on, category_id) VALUES (?, ?, ?)",\n            [\n                (100, "2026-05-%02d" % (index % 28 + 1), 1)\n                for index in range(count)\n            ],\n        )\n        connection.commit()\n    finally:\n        connection.close()\n\n\ndef test_req_006_monthly_total_and_breakdown(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("60.00", "2026-05-20", "Transport")\n\n    summary = service.monthly_summary()\n    assert summary.month == "2026-05"\n    assert summary.total_cents == 10000\n    assert summary.total_display() == "100.00"\n    assert summary.by_category == {"Groceries": 4000, "Transport": 6000}\n    assert summary.category_display("Groceries") == "40.00"\n    assert summary.category_display("Transport") == "60.00"\n    assert summary.category_display("Health") == "0.00"\n\n\ndef test_req_006_previous_month_expense_is_excluded(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("99.99", "2026-04-30", "Groceries")\n\n    summary = service.monthly_summary()\n    assert summary.total_cents == 4000\n    assert summary.by_category == {"Groceries": 4000}\n    assert "99.99" not in summary.total_display()\n\n\ndef test_req_006_explicit_month_selects_that_month(service):\n    service.add_expense("40.00", "2026-05-02", "Groceries")\n    service.add_expense("10.00", "2026-04-10", "Utilities")\n\n    april = service.monthly_summary("2026-04")\n    assert april.month == "2026-04"\n    assert april.by_category == {"Utilities": 1000}\n    assert april.total_display() == "10.00"\n\n\ndef test_req_006_december_month_filter_crosses_the_year(service):\n    service.add_expense("5.00", "2026-12-31", "Other")\n    service.add_expense("7.00", "2027-01-01", "Other")\n\n    december = service.monthly_summary("2026-12")\n    assert december.total_display() == "5.00"\n    assert december.by_category == {"Other": 500}\n\n\ndef test_req_006_empty_month_has_zero_total(service):\n    summary = service.monthly_summary()\n    assert summary.total_cents == 0\n    assert summary.total_display() == "0.00"\n    assert summary.by_category == {}\n\n\ndef test_req_008_dime_and_twenty_cent_total_displays_as_0_30(service):\n    service.add_expense("0.10", "2026-05-02", "Groceries")\n    service.add_expense("0.20", "2026-05-03", "Groceries")\n\n    summary = service.monthly_summary()\n    assert summary.category_display("Groceries") == "0.30"\n    assert summary.total_display() == "0.30"\n\n\ndef test_req_008_saved_12_5_displays_with_two_decimals(service):\n    expense = service.add_expense("12.5", "2026-05-03", "Groceries")\n    assert expense.amount_display() == "12.50"\n    summary = service.monthly_summary()\n    assert summary.category_display("Groceries") == "12.50"\n    assert MonthlySummary(month="2026-05", total_cents=expense.amount_cents).total_display() == "12.50"\n\n\ndef test_req_009_summary_of_10000_expenses_is_fast(service, database):\n    _seed_expenses(database)\n\n    started = time.perf_counter()\n    summary = service.monthly_summary()\n    elapsed = time.perf_counter() - started\n\n    assert summary.total_cents == 10000 * 100\n    assert elapsed < 1.0, "summary request took %.3fs" % elapsed\n\n\ndef test_req_009_saving_an_expense_with_10000_stored_is_fast(tmp_path, service_builder):\n    database, service = service_builder(tmp_path / "bulk.db")\n    _seed_expenses(database)\n\n    started = time.perf_counter()\n    expense = service.add_expense("12.50", "2026-05-15", "Groceries")\n    elapsed = time.perf_counter() - started\n\n    assert expense.id > 10000\n    assert elapsed < 1.0, "saving took %.3fs" % elapsed\n\n\ndef test_req_009_api_summary_endpoint_with_10000_expenses_is_fast(api, service, database):\n    _seed_expenses(database)\n\n    started = time.perf_counter()\n    status, payload = api.get("/api/summary")\n    elapsed = time.perf_counter() - started\n\n    assert status == 200\n    assert payload["total_display"] == "10000.00"\n    assert elapsed < 1.0, "API summary took %.3fs" % elapsed\n\n\ndef test_req_009_api_save_endpoint_with_10000_expenses_is_fast(api, service, database):\n    _seed_expenses(database)\n\n    started = time.perf_counter()\n    status, payload = api.post(\n        "/api/expenses", {"amount": "12.50", "date": "2026-05-15", "category": "Groceries"}\n    )\n    elapsed = time.perf_counter() - started\n\n    assert status == 201\n    assert payload["amount_display"] == "12.50"\n    assert elapsed < 1.0, "API save took %.3fs" % elapsed\n'}}]

