            "name": "check_python",
            "arguments": "{\"path\": \"expensetracker/service.py\", \"source\": \"\\\"\\\"\\\"ExpenseTrackerService: the use cases behind the JSON API.\\n\\nImplements the ExpenseTrackerService class of the domain class diagram and the\\ncall order of the \\\"Log expense\\\", \\\"Set budget\\\", \\\"Budget overview\\\" and\\n\\\"Monthly summary\\\" sequence diagrams.\\nTrace: REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-008, REQ-010\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom datetime import datetime\\n\\nfrom .clock import Clock\\nfrom .dates import Dates\\nfrom .errors import ValidationError\\nfrom .models import Budget, BudgetStatus, Category, Expense, MonthlySummary\\nfrom .money import Money\\nfrom .repositories import BudgetRepository, CategoryRepository, ExpenseRepository\\n\\n\\ndef _split_month(month: str) -> tuple[int, int]:\\n    \\\"\\\"\\\"Turn \\\"2026-05\\\" into (2026, 5).\\\"\\\"\\\"\\n    try:\\n        parsed = datetime.strptime(str(month), \\\"%Y-%m\\\")\\n    except (TypeError, ValueError):\\n        raise ValueError(f\\\"Invalid month {month!r}, expected YYYY-MM\\\") from None\\n    return parsed.year, parsed.month\\n\\n\\nclass ExpenseTrackerService:\\n    \\\"\\\"\\\"Coordinates validation, repositories and the computed views.\\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        expenses: ExpenseRepository,\\n        budgets: BudgetRepository,\\n        categories: CategoryRepository,\\n        clock: Clock,\\n    ) -> None:\\n        self._expenses = expenses\\n        self._budgets = budgets\\n        self._categories = categories\\n        self._clock = clock\\n\\n    def add_expense(self, amount_text: str, date_text: str, category_name: str) -> Expense:\\n        \\\"\\\"\\\"Validate the input, store the expense and return it with its new id.\\\"\\\"\\\"\\n        amount_cents = Money.parse_amount(amount_text)\\n        spent_on = Dates.parse_date(date_text)\\n        category = self._require_category(category_name)\\n        new_id = self._expenses.insert(\\n            Expense(\\n                id=0,\\n                amount_cents=amount_cents,\\n                spent_on=spent_on,\\n                category_id=category.id,\\n            )\\n        )\\n        return Expense(\\n            id=new_id,\\n            amount_cents=amount_cents,\\n            spent_on=spent_on,\\n            category_id=category.id,\\n        )\\n\\n    def list_expenses(self) -> list[Expense]:\\n        \\\"\\\"\\\"All recorded expenses, newest first.\\\"\\\"\\\"\\n        return self._expenses.list_newest_first()\\n\\n    def set_budget(self, category_name: str, amount_text: str) -> Budget:\\n        \\\"\\\"\\\"Validate the amount and store or update the category budget.\\\"\\\"\\\"\\n        amount_cents = Money.parse_amount(amount_text)\\n        category = self._require_category(category_name)\\n        return self._budgets.upsert(category.id, amount_cents)\\n\\n    def budget_overview(self, month: str | None = None) -> list[BudgetStatus]:\\n        \\\"\\\"\\\"Budget usage and warning level per budgeted category for one month.\\\"\\\"\\\"\\n        target = month or self._clock.current_month()\\n        year, month_number = _split_month(target)\\n        spent = self._expenses.sum_by_category(year, month_number)\\n        names = {category.id: category.name for category in self._categories.list_all()}\\n        statuses: list[BudgetStatus] = []\\n        for budget in self._budgets.list_all():\\n            name = names.get(budget.category_id, \\\"Unknown\\\")\\n            statuses.append(\\n                BudgetStatus.evaluate(name, budget.amount_cents, spent.get(budget.category_id, 0))\\n            )\\n        return statuses\\n\\n    def monthly_summary(self, month: str | None = None) -> MonthlySummary:\\n        \\\"\\\"\\\"Total and per-category spending of one calendar month.\\\"\\\"\\\"\\n        target = month or self._clock.current_month()\\n        year, month_number = _split_month(target)\\n        spent = self._expenses.sum_by_category(year, month_number)\\n        by_category: dict[str, int] = {}\\n        total_cents = 0\\n        for category in self._categories.list_all():\\n            cents = spent.get(category.id, 0)\\n            total_cents += cents\\n            if cents:\\n                by_category[category.name] = cents\\n        return MonthlySummary(month=target, total_cents=total_cents, by_category=by_category)\\n\\n    def list_categories(self) -> list[Category]:\\n        \\\"\\\"\\\"The fixed category list, in seed order.\\\"\\\"\\\"\\n        return self._categories.list_all()\\n\\n    def _require_category(self, category_name: str) -> Category:\\n        text = \\\"\\\" if category_name is None else str(category_name).strip()\\n        if not text:\\n            raise ValidationError(\\\"category\\\", \\\"Category is required.\\\")\\n        category = self._categories.find_by_name(text)\\n        if category is None:\\n            raise ValidationError(\\\"category\\\", f\\\"Unknown category {text!r}.\\\")\\n        return category\\n\"}"
          }
