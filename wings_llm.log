INPUT: {'path': 'tests/test_tasks.py', 'source': '"""Tests derived from the acceptance criteria. Each test name carries the requirement it checks."""\n\nfrom datetime import date\n\nfrom todo.cli import Cli\nfrom todo.models import Task\nfrom todo.repository import JsonTaskRepository, TaskRepository\nfrom todo.service import TaskService\n\n\nclass MemoryRepository(TaskRepository):\n    def __init__(self) -> None:\n        self.tasks: list[Task] = []\n\n    def load(self) -> list[Task]:\n        return [Task(t.number, t.title, t.due, t.done) for t in self.tasks]\n\n    def save(self, tasks: list[Task]) -> None:\n        self.tasks = [Task(t.number, t.title, t.due, t.done) for t in tasks]\n\n\ndef make() -> TaskService:\n    return TaskService(MemoryRepository())\n\n\ndef test_req_001_add_task_to_empty_list():\n    service = make()\n    service.add("Buy milk")\n    assert [(t.title, t.done) for t in service.list()] == [("Buy milk", False)]\n\n\ndef test_req_001_add_task_with_due_date():\n    task = make().add("Pay rent", date(2026, 12, 1))\n    assert task.due == date(2026, 12, 1)\n\n\ndef test_req_002_list_in_the_order_added():\n    service = make()\n    service.add("First")\n    service.add("Second")\n    assert [(t.number, t.title) for t in service.list()] == [(1, "First"), (2, "Second")]\n\n\ndef test_req_003_complete_a_task():\n    service = make()\n    service.add("Buy milk")\n    service.complete(1)\n    assert service.list()[0].done\n\n\ndef test_req_003_missing_number_names_it():\n    lines: list[str] = []\n    code = Cli(make(), out=lines.append).run(["done", "5"])\n    assert code == 1 and "5" in lines[-1]\n\n\ndef test_req_004_delete_a_task():\n    service = make()\n    service.add("First")\n    service.add("Second")\n    service.delete(1)\n    assert [t.title for t in service.list()] == ["Second"]\n\n\ndef test_req_005_tasks_survive_a_restart(tmp_path):\n    path = str(tmp_path / "tasks.json")\n    TaskService(JsonTaskRepository(path)).add("Buy milk")\n    assert [t.title for t in TaskService(JsonTaskRepository(path)).list()] == ["Buy milk"]\n'}
