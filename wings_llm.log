 for category in service.list_categories()}\\n            expenses = [\\n                {\\n                    \\\"id\\\": expense.id,\\n                    \\\"amount_display\\\": expense.amount_display(),\\n                    \\\"date\\\": expense.spent_on.isoformat(),\\n                    \\\"category\\\": names.get(expense.category_id, \\\"Unknown\\\"),\\n                }\\n                for expense in service.list_expenses()\\n            ]\\n            return 200, {\\\"expenses\\\": expenses}\\n        if path == \\\"/api/categories\\\":\\n            return 200, {\\n                \\\"categories\\\": [\\n                    {\\\"id\\\": category.id, \\\"name\\\": category.name}\\n                    for category in service.list_categories()\\n                ]\\n            }\\n        if path == \\\"/api/budgets\\\":\\n            return 200, {\\\"budgets\\\": [self._budget_payload(s) for s in service.budget_overview()]}\\n        if path == \\\"/api/summary\\\":\\n            summary = service.monthly_summary()\\n            return 200, {\\n                \\\"month\\\": summary.month,\\n                \\\"total_display\\\": summary.total_display(),\\n                \\\"categories\\\": [\\n                    {\\\"name\\\": name, \\\"total_display\\\": summary.category_display(name)}\\n                    for name in summary.by_category\\n                ],\\n            }\\n        return 404, {\\\"error\\\": \\\"Not found\\\"}\\n\\n    def route_post(self, path: str, body: dict) -> tuple[int, dict]:\\n        service = self.service\\n        if path == \\\"/api/expenses\\\":\\n            expense = service.add_expense(body.get(\\\"amount\\\"), body.get(\\\"date\\\"), body.get(\\\"category\\\"))\\n            names = {category.id: category.name for category in service.list_categories()}\\n            return 201, {\\n                \\\"id\\\": expense.id,\\n                \\\"amount_display\\\": expense.amount_display(),\\n                \\\"date\\\": expense.spent_on.isoformat(),\\n                \\\"category\\\": names.get(expense.category_id, \\\"Unknown\\\"),\\n            }\\n        if path == \\\"/api/budgets\\\":\\n            budget = service.set_budget(body.get(\\\"category\\\"), body.get(\\\"amount\\\"))\\n            names = {category.id: category.name for category in service.list_categories()}\\n            return 200, {\\n                \\\"category\\\": names.get(budget.category_id, \\\"Unknown\\\"),\\n                \\\"budget_display\\\": budget.amount_display(),\\n            }\\n        return 404, {\\\"error\\\": \\\"Not found\\\"}\\n\\n    # -- responses ----------------------------------------------------------\\n\\n    def send_json(self, status: int, payload: dict) -> None:\\n        data = json.dumps(payload).encode(\\\"utf-8\\\")\\n        self.send_response(status)\\n        self.send_header(\\\"Content-Type\\\", \\\"application/json; charset=utf-8\\\")\\n        self.send_header(\\\"Content-Length\\\", str(len(data)))\\n        self.send_header(\\\"Cache-Control\\\", \\\"no-store\\\")\\n        self.end_headers()\\n        self.wfile.write(data)\\n\\n    def send_static(self, path: str) -> None:\\n        name = path.lstrip(\\\"/\\\") or \\\"index.html\\\"\\n        if name.endswith(\\\"/\\\"):\\n            name += \\\"index.html\\\"\\n        root = self.static_dir.resolve()\\n        target = (root / name).resolve()\\n        try:\\n            target.relative_to(root)\\n        except ValueError:\\n            self.send_json(404, {\\\"error\\\": \\\"Not found\\\"})\\n            return\\n        if not target.is_file():\\n            self.send_json(404, {\\\"error\\\": \\\"Not found\\\"})\\n            return\\n        data = target.read_bytes()\\n        self.send_response(200)\\n        self.send_header(\\n            \\\"Content-Type\\\", CONTENT_TYPES.get(target.suffix, \\\"application/octet-stream\\\")\\n        )\\n        self.send_header(\\\"Content-Length\\\", 